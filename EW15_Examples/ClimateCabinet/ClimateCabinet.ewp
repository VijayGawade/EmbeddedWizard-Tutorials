$version 15.00

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,70,240,110>
unit Core
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,110,240,150>
unit Resources
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,150,240,190>
unit Graphics
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,190,240,230>
unit Effects
{
  attr Directory = $Mosaic;
}

// The 'default' Language. Each project has to contain at least one language brick \
// called 'Default'
$rect <290,310,490,350>
language Default;

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,230,240,270>
unit Views
{
  attr Directory = $Mosaic;
}

// This is a unit.
$rect <40,430,240,470>
unit Application
{
  attr Directory = .\;
}

// This is a unit.
$rect <40,470,240,510>
unit Climate
{
  attr Directory = .\;
}

// This is a unit.
$rect <40,470,240,510>
unit ClimateVariants
{
  attr Directory = .\;
}

$rect <40,270,240,310>
unit Charts
{
  attr Directory = $Mosaic\Charts;
}

$rect <40,310,240,350>
unit WidgetSet
{
  attr Directory = $Mosaic\;
}

// Mosaic Framework
note group Note1
{
  attr Bounds = <20,20,260,370>;
}

// Profile Configuration
note group Note2
{
  attr Bounds = <270,20,510,250>;
}

// Languages
note group Note3
{
  attr Bounds = <270,260,510,370>;
}

// Project Units
note group Note5
{
  attr Bounds = <20,380,260,530>;
}

// The sample application 'ClimateCabinet' implements the user interface of a climatic \
// exposure test cabinent. The user can define a heating time, a nominal temperature \
// and humidity, a dwell time and the final cooling time.
// 
// The parameters can be set within a scrolling menu. The current parameters are \
// shown within a graph diagram.
// 
// This demo application is implemented for a screen size of 800x480 pixel. Additionally, \
// a set of constant variants and resource variants are implemented to support additional \
// screen sizes like 480x272, 320x240 or 1280x720 pixel.
// 
// You can double-click on the 'Climate' brick to open the unit within the Composer \
// and to analyze the implementation.
// The unit 'ClimateVariants' contains the necessary variants to support the additional \
// screen sizes.
// 
// To start the application within the Prototyper, press 'Ctrl'+'F5'.
note legend Note
{
  attr Bounds = <520,20,1150,370>;
}

// How to manage project variants?
// 
// https://doc.embedded-wizard.de/managing-project-variants
note legend Note6
{
  attr Bounds = <270,380,760,450>;
}

// Graphical design of 'ClimateCabinet' by Coeno - http://www.coeno.com
note legend Note4
{
  attr Bounds = <270,460,760,530>;
}

// This is the 'default' profile for the new project. This profile will be used for \
// test, prototyping, etc.
$rect <290,70,490,110>
profile Win32 : Windows.Software.RGBA8888
{
  attr ScreenSize = <800,480>;
  attr Optimization = High;
  attr ApplicationClass = Application::Application;
  attr ScreenOrientation = Normal;
  attr FontConversion = Windows;
  attr CleanOutputDirectories = false;
  attr OutputFileNameExtension = c;
  attr Verbose = false;
  attr StorageOfResources = Code;
  attr StorageOfConstants = Code;

  $rect <10,10,154,50>
  macro Author = "Dipl. Ing. Paul Banach and Dipl. Ing. Manfred Schweyer, Copyright (C) TARA Systems GmbH";
}


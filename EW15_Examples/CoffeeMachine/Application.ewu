$version 15.00

// This is the root component of the entire GUI application.
$rect <20,10,220,50>
$output false
class Application : Core::Root
{
  $rect <510,0,710,40>
  inherited property Bounds = <0,0,480,272>;

  $rect <720,50,920,90>
  inherited method DriveCursorHitting()
  {
    /* remove the screensave as soon as the user has touched the screen */
    if (( Saver != null ) && ( aDown == false ))
    {
      ProductScreen.Enabled = true;
      Remove( Saver );
      Saver = null;
    }

    /* restart the timer as soon as the touch interaction has finished */
    if ( aDown )
      Timer.Enabled = false;
    else
      Timer.Enabled = true;

    /* don't forget the super call to make further touch processing */
    return super( aDown, aFinger, aPos );


  }

  $rect <20,20,160,60>
  object Coffee::ProductScreen ProductScreen
  {
    preset Bounds = <0,0,480,272>;
    preset OnStartBrewing = StartBrewing;
  }

  $rect <720,0,920,40>
  inherited method Init()
  {
    $if !$composer

    /* show screensaver after launching application */
    postsignal StartScreenSaver;

    $endif
  }

  // This is a timer object.
  $rect <510,50,710,90>
  object Core::Timer Timer
  {
    preset OnTrigger = StartScreenSaver;
    preset Period = 5000;
    preset Begin;
    preset Enabled = true;
  }

  // This is a slot method.
  $rect <510,100,710,140>
  slot StartScreenSaver
  {
    Timer.Enabled = false;

    if ( Saver == null && Brewer == null )
    {
      /* create a new welcome screen and add it to the application */
      Saver = new Coffee::WelcomeScreen;
      Add( Saver, 0 );

      /* disable the product screen to avoid touch event processing */
      ProductScreen.Enabled = false;
    }
  }

  // This is a variable.
  $rect <510,140,710,180>
  var Coffee::WelcomeScreen Saver;

  // This is a slot method.
  $rect <510,190,710,230>
  slot StartBrewing
  {
    if ( Brewer == null )
    {
      Timer.Enabled = false;
      
      /* create a new brewing screen and add it to the application */
      Brewer = new Coffee::BrewingScreen;
      Brewer.OnCancelBrewing = StopBrewing;
      Add( Brewer, 0 );
    }
  }

  // This is a variable.
  $rect <510,230,710,270>
  var Coffee::BrewingScreen Brewer;

  // This is a slot method.
  $rect <720,190,920,230>
  slot StopBrewing
  {
    if ( Brewer != null )
    {
      /* disconnect and remove the current brewing screen */
      Brewer.OnCancelBrewing = null;
      Remove( Brewer );
      Brewer = null;

      Timer.Enabled = true;
    }
  }

  // The Application class combines all coffee machine screens together. The ProductScreen \
  // is shown all the time. The BrewingScreen and the WelcomeScreen are created dynamically \
  // during runtime as soon as they are needed.
  note legend Note
  {
    attr Bounds = <0,290,480,400>;
  }

  // Directives to adapt the order of members belonging to this class so they appear 
  // correctly arranged relative to the members inherited from the ancestor (super) 
  // classes. The numbers indicate the order-displacement to apply on the respective 
  // member once all members have been loaded and combined with members from the 
  // ancestor classes.
  $reorder GetIndexOfView 1
  $reorder GetViewAtIndex 1
  $reorder CountViews 1
  $reorder FindViewInDirection 1
  $reorder FindViewWithinArea 1
  $reorder FindViewAtPosition 1
  $reorder FindPrevView 1
  $reorder FindNextView 1
  $reorder FindSiblingView 1
  $reorder GetContentArea 1
  $reorder RestackBehind 1
  $reorder RestackBack 1
  $reorder RestackTop 1
  $reorder Restack 1
  $reorder Remove 1
  $reorder AddBehind 1
  $reorder Add 1
  $reorder Focus 1
  $reorder Buffered 1
  $reorder Enabled 1
  $reorder Opacity 1
  $reorder Embedded 1
  $reorder AlphaBlended 1
  $reorder Visible 1
  $reorder keyLastLocked 1
  $reorder keyLastCharCode 1
  $reorder keyLastCode 1
  $reorder keyTargetView 1
  $reorder hasRootFocus 1
  $reorder updateLock 1
  $reorder animationLock 1
  $reorder modalGroups 1
  $reorder currentEventTimestamp 1
  $reorder createDragEvent 1
  $reorder createCursorEvent 1
  $reorder cursorHoldTimerProc 1
  $reorder cursorHoldTimer 1
  $reorder cursorSequelCounter 1
  $reorder cursorSequelArea 1
  $reorder cursorHoldPeriod 1
  $reorder cursorHittingPos 1
  $reorder cursorHittingTime 1
  $reorder cursorCaptureView 1
  $reorder cursorCurrentPos 1
  $reorder cursorTargetView 1
  $reorder cursorHitOffset 1
  $reorder cursorLastPos 1
  $reorder cursorFirstPos 1
  $reorder cursorFinger 1
  $reorder fpsTime 1
  $reorder fpsCounter 1
  $reorder lastRegions 1
  $reorder noOfLastRegions 1
  $reorder canvas 1
  $reorder regionsArea 1
  $reorder regions 1
  $reorder noOfRegions 1
  $reorder GetFPS 1
  $reorder Update 1
  $reorder UpdateGE20 1
  $reorder EndUpdate 1
  $reorder UpdateCanvas 1
  $reorder GetUpdateRegion 1
  $reorder BeginUpdate 1
  $reorder DoesNeedUpdate 1
  $reorder Initialize 1
  $reorder SetRootFocus 1
  $reorder SetUserInputTimestamp 1
  $reorder DriveKeyboardHitting 1
  $reorder DriveCursorMovement 1
  $reorder DriveMultiTouchMovement 1
  $reorder DriveCursorHitting 1
  $reorder DriveMultiTouchHitting 1
  $reorder OnSetVirtualKeyboard 1
  $reorder OnSetCursorDragLimit 1
  $reorder OnSetCursorSequelDelay 1
  $reorder OnGetStyles 1
  $reorder OnSetStyles 1
  $reorder OnGetLanguage 1
  $reorder OnSetLanguage 1
  $reorder EndAnimation 1
  $reorder BeginAnimation 1
  $reorder CaptureCursor 1
  $reorder RetargetCursorWithReason 1
  $reorder RetargetCursor 1
  $reorder DeflectCursor 1
  $reorder GetModalGroup 1
  $reorder EndModal 1
  $reorder BeginModal 1
  $reorder VirtualKeyboard 1
  $reorder CursorDragLimit 1
  $reorder CursorSequelDelay 1
  $reorder Styles 1
  $reorder Language 1
  $reorder ProductScreen 1
}

// The Application class combines all coffee machine screens together. All ingredients \
// for the coffee machine are implemented within the unit 'Coffee'.
note legend Note
{
  attr Bounds = <20,60,500,150>;
}

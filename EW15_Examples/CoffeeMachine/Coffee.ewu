$version 15.00

// Color constant for the start action button.
$rect <440,530,640,570>
$output false
const color StartColor = #304F29FF;

// Color constant for the stop action button.
$rect <440,570,640,610>
$output false
const color StopColor = #731717FF;

// This is a GUI component.
$rect <440,50,640,90>
$output false
class WelcomeScreen : Core::Group
{
  $rect <500,0,700,40>
  inherited property Bounds = <0,0,480,272>;

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image Image
  {
    preset Bounds = <0,0,480,272>;
    preset Bitmap = Coffee::WelcomeBackground;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text Text
  {
    preset Bounds = <200,0,480,270>;
    preset WrapText = true;
    preset String = "Embedded\nWizard\nCoffee Machine";
    preset Font = Coffee::FontLarge;
  }

  // This is a pulse color effect.
  $rect <500,40,700,80>
  object Effects::ColorEffect ColorEffect
  {
    preset Symmetric = true;
    preset CycleDuration = 5000;
    preset Enabled = true;
    preset Value2 = #E3DBD8FF;
    preset Value1 = #CC9767FF;
    preset Outlet = ^Text.Color;
  }

  // This is the welcome screen of the coffee machine. This screen is shown after \
  // starting the machine and it is used as screen saver. A color effect is used \
  // to make a smooth color animation of the text.
  note legend Note
  {
    attr Bounds = <0,290,480,400>;
  }
}

// Base class of all product configuration components with one slider.
$rect <20,170,220,210>
$output false
class Product : Core::Group
{
  $rect <500,0,700,40>
  inherited property Bounds = <0,0,480,272>;

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text ProductName
  {
    preset Bounds = <0,0,480,60>;
    preset String = "Product";
    preset Font = Coffee::FontLarge;
    preset Color = Coffee::TextColor;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image DirectLeft
  {
    preset Bounds = <0,0,60,60>;
    preset Color = Coffee::TextColor;
    preset Bitmap = Coffee::DirectionIcons;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image DirectRight
  {
    preset Bounds = <420,0,480,60>;
    preset Color = Coffee::TextColor;
    preset FrameNumber = 1;
    preset Bitmap = Coffee::DirectionIcons;
  }

  $rect <20,20,160,60>
  object Coffee::HorzSlider SettingsSlider
  {
    preset Bounds = <90,100,290,135>;
    preset MinValue = 0;
    preset MaxValue = 100;
    preset CurrentValue = 50;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image SettingsIcon
  {
    preset Bounds = <30,93,80,143>;
    preset Color = Coffee::TextColor;
    preset FrameNumber = 0;
    preset Bitmap = Coffee::SettingIcons;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text MinCaption
  {
    preset Bounds = <90,140,190,170>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertCenter];
    preset String = "weak";
    preset Font = Coffee::FontSmall;
    preset Color = Coffee::TextColor;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text MaxCaption
  {
    preset Bounds = <190,140,290,170>;
    preset Alignment = Views::TextAlignment[AlignHorzRight, AlignVertCenter];
    preset String = "strong";
    preset Font = Coffee::FontSmall;
    preset Color = Coffee::TextColor;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image ProductIcon
  {
    preset Bounds = <350,70,430,150>;
    preset Color = Coffee::TextColor;
    preset FrameNumber = 0;
    preset Bitmap = Coffee::ProductIcons;
  }

  // This is the base class of all product configuration components with one slider. \
  // In order to create a dedicated product configurator for the coffee machine, \
  // derive this class and set the caption, change the slider description and choose \
  // the icons. 
  note legend Note
  {
    attr Bounds = <0,290,480,420>;
  }
}


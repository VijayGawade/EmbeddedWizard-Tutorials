// This is a class.
$rect <230,50,430,90>
$output false
$multilingual true
class BrewingScreen : Core::Group
{
  $rect <500,0,700,40>
  inherited property Bounds = <0,0,480,272>;

  $rect <500,330,700,370>
  inherited method UpdateViewState()
  {
    aState;

    /* set percent string */
    ProgressText.String = string( Progress ) + "%%";

    /* place foreground cup over background cup */
    FgCup.Bounds = BgCup.Bounds;

    /* and show part that corresponds current progress */
    FgCup.Bounds.y1 = FgCup.Bounds.y2 - ( BgCup.Bounds.h * Progress ) / 100;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image Image
  {
    preset Bounds = <0,0,480,272>;
    preset Bitmap = Coffee::BrewingBackground;
  }

  $rect <20,20,160,60>
  object Coffee::ActionButton ActionButton
  {
    preset Bounds = <350,162,480,272>;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text ProgressText
  {
    preset Bounds = <190,170,300,230>;
    preset String = "0%%";
    preset Font = Coffee::FontLarge;
    preset Color = Coffee::TextColor;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text WaitText
  {
    preset Bounds = <10,220,180,270>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertCenter];
    preset String = "Please wait...";
    preset Font = Coffee::FontSmall;
    preset Color = Coffee::TextColor;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image BgCup
  {
    preset Bounds = <190,30,300,170>;
    preset Color = #6C442AFF;
    preset Bitmap = Coffee::Cup;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image FgCup
  {
    preset Bounds = <180,150,290,150>;
    preset Color = Coffee::TextColor;
    preset Alignment = Views::ImageAlignment[AlignHorzCenter, AlignVertBottom];
    preset Bitmap = Coffee::Cup;
  }

  // This is a bool change effect.
  $rect <500,50,700,90>
  object Effects::BoolEffect BlinkEffect
  {
    preset Outlet = ^WaitText.Visible;
    preset CycleDuration = 500;
    preset InterCycleDelay = 500;
    preset Enabled = true;
  }

  // This is an int32 change effect.
  $rect <500,90,700,130>
  object Effects::Int32Effect ProgressEffect
  {
    preset Timing = Effects::Timing.EaseIn_EaseOut;
    preset NoOfCycles = 1;
    preset CycleDuration = 7500;
    preset Enabled = true;
    preset Value2 = 100;
    preset Outlet = ^Progress;
  }

  // This is a property.
  $rect <500,140,700,180>
  property int32 Progress = 0;

  $rect <500,180,700,220>
  onset Progress
  {
    // The value doesn't change - nothing to do.
    if ( pure Progress == value )
      return;

    // Remember the property's new value.
    pure Progress = value;

    InvalidateViewState();
  }

  // Slot property to register a slot method that will be called when the user presses \
  // the action button.
  $rect <500,230,700,270>
  property slot OnCancelBrewing;

  $rect <500,270,700,310>
  onset OnCancelBrewing
  {
    /* check for any update */
    if ( pure OnCancelBrewing == value )
      return;

    /* store the given slot method */
    pure OnCancelBrewing = value;

    /* connect the action button with the provided slot method */
    ActionButton.OnAction = value;
    ProgressEffect.OnFinished = value;

  }

  // This is the brewing screen of the coffee machine. This screen is shown when \
  // the user has configured a product and has started the brewing process. The progress \
  // of the brewing process is shown a cup that is filled and by a percent string.
  note legend Note
  {
    attr Bounds = <0,290,480,400>;
  }
}

// This class implements a 'slider' widget. The user can touch and drag the slider \
// to change the slider's value accordingly. The current value of the slider is represented \
// by the property @CurrentValue. The valid range for this value is determined by \
// the properties @MinValue and @MaxValue.
// While the user is dragging the slider, the widget sends signals to the slot method \
// stored in the property @OnChange. When the user terminates the interaction, a \
// signal is sent to the slot method stored in @OnApply.
// Alternatively the property @Outlet can refer to any other 'int32' property the \
// widget should remain synchronized with. When the user drags the slider, the affected \
// property is automatically updated to reflect the slider's current value. On the \
// other hand, when the referred property is modified by another one, the slider \
// is automatically notified to remain in sync with the property.
// This approach follows the Model-View-Controller (MVC) programming paradigm. Here \
// the slider represents the 'View' and the property referred via 'Outlet' can be \
// seen as a part of the 'Model'.
$rect <20,370,220,410>
$output false
class HorzSlider : Core::Group
{
  $rect <20,140,220,180>
  inherited property Bounds = <0,0,200,35>;

  $rect <250,360,450,400>
  inherited method UpdateViewState()
  {
    /* always invoke the inherited method */
    super( aState );

    var int32 newPos = 0;

    /* convert the slider's current value to a pixel position */
    if ( MaxValue != MinValue )
      newPos = (( CurrentValue - MinValue ) * Bounds.w ) / ( MaxValue - MinValue );

    /* take care that the width is a multiple of 10 to show only entire segments */
    newPos = ((newPos + 5 ) / 10 ) * 10;

    /* set the width of the foreground to the calculated position */
    Foreground.Bounds.x2 = newPos;


  }

  // State management
  note group Note4
  {
    attr Bounds = <240,320,460,420>;
  }

  // Controller events
  note group Note3
  {
    attr Bounds = <240,200,460,300>;
  }

  // Touch screen events
  note group Note1
  {
    attr Bounds = <10,200,230,420>;
  }

  // This internal variable stores the slider's value at the moment when the user \
  // begun to drag. It is used to calculate the new value from the knob displacement.
  $rect <20,360,220,400>
  var int32 touchStartValue;

  // This internal slot method is called when the user drags the finger while pressing \
  // the slider's area. The method calculates from the made displacement the alternation \
  // of the slider's value and updates the slider accordingly.
  $rect <20,320,220,360>
  slot onDragTouch
  {
    /* calculate the displacement in pixel relative to the originally touched position */
    var point delta    = TouchHandler.CurrentPos - TouchHandler.HittingPos;
    var int32 oldValue = CurrentValue;

    /* calculate from the knob displacement the alternation of the slider's value */
    CurrentValue = (( delta.x * ( MaxValue - MinValue )) / Bounds.w ) + touchStartValue;

    /* return if nothing has changed */
    if ( oldValue == CurrentValue )
      return;

    /* notify the owner of the slider that the value has been changed */
    postsignal OnChange;

    /* if a property is associated to the slider, update it accordingly and notify other widgets */
    if ( Outlet != null )
    {
      Outlet^ = CurrentValue;
      notifyobservers Outlet; 
    }
  }

  // This internal slot method is called when the user releases the screen after \
  // touching the slider --> when the drag interaction ends.
  $rect <20,280,220,320>
  slot onReleaseTouch
  {
    /* the appearance of the slider may change, when the touch interactin ends */
    InvalidateViewState();

    /* notify owner if the user changed the slider's value */
    if ( CurrentValue != touchStartValue )
      postsignal OnApply;
  }

  // This internal slot method is called when the user touches the slider area --> \
  // when the drag interaction begins.
  $rect <20,240,220,280>
  slot onPressTouch
  {
    /* immediately set the current value according touch position */
    var point pos = TouchHandler.CurrentPos;
    CurrentValue = (( pos.x * ( MaxValue - MinValue )) / Bounds.w );

    /* remember the slider's value at the beginning of the drag operation */
    touchStartValue = CurrentValue;

    /* finally, force an update of the component */
    InvalidateViewState();


  }

  $rect <450,140,650,180>
  onset Outlet
  {
    /* check if the new outlet differs from the currently used outlet */
    if ( pure Outlet == value )
      return;

    /* detach from the previous outlet */
    detachobserver outletSlot, pure Outlet;

    /* store the new outlet */
    pure Outlet = value;

    /* ... and attach to the new one */
    attachobserver outletSlot, value;

    /* finally, update the current state of the widget by posting a signal to the outlet slot */
    if ( value != null )
      postsignal outletSlot;
  }

  $rect <650,50,850,90>
  onset MaxValue
  {
    /* check if the given value differs from the current value */
    if ( pure MaxValue == value )
      return;

    /* store the new value */
    pure MaxValue = value;

    /* ...and finally, force an update */
    InvalidateViewState();
  }

  $rect <450,50,650,90>
  onset MinValue
  {
    /* check if the given value differs from the current value */
    if ( pure MinValue == value )
      return;

    /* store the new value */
    pure MinValue = value;

    /* ...and finally, force an update */
    InvalidateViewState();
  }

  $rect <250,50,450,90>
  onset CurrentValue
  {
    /* limit the given value to the range between MinValue and MaxValue */
    if ( value < MinValue )
      value = MinValue;
    if ( value > MaxValue )
      value = MaxValue;

    /* check if the given value differs from the current value */
    if ( pure CurrentValue == value )
      return;

    /* store the new value */
    pure CurrentValue = value;

    /* ...and finally, force an update */
    InvalidateViewState();
  }

  $rect <20,20,160,60>
  object Core::SimpleTouchHandler TouchHandler
  {
    preset Layout = Core::Layout[];
    preset Point4 = <0,35>;
    preset Point3 = <200,35>;
    preset Point2 = <200,0>;
    preset Point1 = <0,0>;
    preset OnDrag = onDragTouch;
    preset OnRelease = onReleaseTouch;
    preset OnPress = onPressTouch;
    preset MaxStrikeCount = 100;
  }

  // The property 'OnApply' can refer to a slot method, which will receive a signal \
  // when the user has released the slider. Thereupon the method's logic will be \
  // executed. In the associated slot method you can evaluate the slider's current \
  // value @CurrentValue.
  $rect <650,140,850,180>
  property slot OnApply = null;

  // The property 'OnChange' can refer to a slot method, which will receive a signal \
  // each time the user changes the sliders position. Thereupon the method's logic \
  // will be executed. In the associated slot method you can evaluate the slider's \
  // current value @CurrentValue.
  $rect <650,100,850,140>
  property slot OnChange = null;

  // The property 'Outlet' can refer to any other 'int32' property the widget should \
  // remain synchronized with. When the user drags the slider's knob, the affected \
  // property is automatically updated to reflect the slider's current value. On \
  // the other hand, when the referred property is modified by another one, the slider \
  // is automatically notified to remain in sync with the property.
  // This approach follows the Model-View-Controller (MVC) programming paradigm. \
  // Here the slider represents the 'View' and the property referred via 'Outlet' \
  // can be seen as a part of the 'Model'.
  $rect <450,100,650,140>
  property ^int32 Outlet = null;

  // The property 'MaxValue' defines the slider's possible value at the right end \
  // of the slider's movement range.
  $rect <650,10,850,50>
  property int32 MaxValue = 100;

  // The property 'MinValue' defines the slider's possible value at the left end \
  // of the slider's movement range.
  $rect <450,10,650,50>
  property int32 MinValue = 0;

  // The property 'CurrentValue' stores the momentary value of the slider. The value \
  // is limited automatically to the range between @MinValue and @MaxValue.
  $rect <250,10,450,50>
  property int32 CurrentValue = 50;

  // This is a wallpaper view.
  $rect <20,20,160,60>
  object Views::Wallpaper Background
  {
    preset Bounds = <0,0,200,35>;
    preset Color = #4F4F4FFF;
    preset Bitmap = Coffee::SliderArea;
  }

  // This is a wallpaper view.
  $rect <20,20,160,60>
  object Views::Wallpaper Foreground
  {
    preset Bounds = <0,0,200,35>;
    preset Color = Coffee::TextColor;
    preset Bitmap = Coffee::SliderArea;
  }

  // This slot method will receive a signal, if the value of the property assigned \
  // to @Outlet has been changed by another widget or by the application logic. In \
  // response to this notification, the widget will update itself.
  $rect <260,240,440,280>
  slot outletSlot
  {
    /* update the current state of the widget */
    if ( Outlet != null )
      CurrentValue = Outlet^;
  }

  // The class 'HorzSlider' implements a horizontal slider widget, that is used to \
  // change a value by moving the level indicator. 
  // The property 'CurrentValue' represents the momentary value of the widget and \
  // corresponds to the size of the level indicatorb. The supported value range of \
  // the slider can be defined by setting the properties 'MinValue' and 'MaxValue'.
  // A slider can be connected with an Int32 'Outlet' property to show the current \
  // value of the property and to change it by setting the indicator level. 
  // Additionally, a slider can trigger the slot methods 'OnChange' and 'OnApply' \
  // as soon as the user has changed the value or released the slider.
  note legend Note
  {
    attr Bounds = <10,430,950,570>;
  }
}

// This class implements a 'push button' widget. When the user presses the button, \
// a signal is sent to the slot method stored in its @OnAction property.
$rect <230,370,430,410>
$output false
class ActionButton : Core::Group
{
  $rect <20,140,220,180>
  inherited property Bounds = <0,0,130,110>;

  $rect <250,230,450,270>
  inherited method UpdateViewState()
  {
    /* invoke the inherited method */
    super( aState );

    /* determine the new state of the push button */
    var bool isPressed  = ( TouchHandler.Down && TouchHandler.Inside );
    var color bgColor;

    /* select the icon according current action type */
    if ( pure ActionType  == Coffee::ActionType.Start )
    {
      Image.FrameNumber = 0;
      bgColor = Coffee::StartColor;
    }
    else
    {
      Image.FrameNumber = 1;
      bgColor = Coffee::StopColor;
    }

    /* colorize button according current state of the button */
    if ( isPressed )
    {
      Background.Color = #80808080;
      Border.Color     = bgColor;
      Image.Color      = bgColor;
    }
    else
    {
      Background.Color = bgColor;
      Border.Color     = Coffee::TextColor;
      Image.Color      = Coffee::TextColor;
    }

  }

  // State management
  note group Note4
  {
    attr Bounds = <240,190,460,320>;
  }

  // Touch screen events
  note group Note1
  {
    attr Bounds = <10,190,230,320>;
  }

  $rect <20,20,160,60>
  object Core::SimpleTouchHandler TouchHandler
  {
    preset Layout = Core::Layout[AlignToBottom, AlignToLeft, AlignToRight, AlignToTop, ResizeHorz, ResizeVert];
    preset Point4 = <10,110>;
    preset Point3 = <130,110>;
    preset Point2 = <130,10>;
    preset Point1 = <10,10>;
    preset OnLeave = enterLeaveSlot;
    preset OnEnter = enterLeaveSlot;
    preset OnRelease = pressReleaseSlot;
    preset OnPress = pressReleaseSlot;
    preset MaxStrikeCount = 100;
  }

  // The property 'OnAction' can refer to a slot method, which will receive a signal \
  // as soon as the user has activated the button. Thereupon the method's logic will \
  // be executed.
  $rect <170,10,370,50>
  property slot OnAction = null;

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image Background
  {
    preset Bounds = <0,0,130,110>;
    preset Bitmap = Coffee::ActionButtonBorder;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image Border
  {
    preset Bounds = <0,0,130,110>;
    preset FrameNumber = 1;
    preset Bitmap = Coffee::ActionButtonBorder;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image Image
  {
    preset Bounds = <55,50,105,100>;
    preset FrameNumber = 1;
    preset Bitmap = Coffee::ActionButtonIcons;
  }

  // The property 'ActionType' is used to define the type and the appearance of the \
  // button.
  $rect <390,10,590,50>
  property Coffee::ActionType ActionType = Coffee::ActionType.Stop;

  $rect <390,50,590,90>
  onset ActionType
  {
    /* check for any updates */
    if ( pure ActionType == value )
      return;

    /* store the new value */
    pure ActionType = value;

    /* finally, force an update of the component */
    InvalidateViewState();

  }

  // This internal slot method is used to receive the corresponding signals form \
  // the touch handler.
  $rect <30,270,210,310>
  slot pressReleaseSlot
  {
    /* releasing the finger outside the button area is ignored */
    if ( !TouchHandler.Down && TouchHandler.Inside )
    {
      /* inform the connected slot method */
      idlesignal OnAction;
    }
  }

  // This internal slot method is used to receive the corresponding signals form \
  // the touch handler.
  $rect <30,230,210,270>
  slot enterLeaveSlot
  {
    /* force an update of the button */
    InvalidateViewState();
  }

  // The class 'ActionButton' implements a simple push button to start or cancel \
  // a certain action.
  // The property 'ActionType' is used to choose the type of action button.
  // Each time the user has pressed the button a signal is sent to the slot method \
  // 'OnAction'.
  note legend Note
  {
    attr Bounds = <10,330,700,430>;
  }
}

// This is an enumeration definition for selecting the type of ActionButton.
$rect <440,370,640,410>
$output false
enum ActionType
{
  // Enum for start action.
  $rect <10,10,210,50>
  item Start;

  // Enum for stop action.
  $rect <220,10,420,50>
  item Stop;
}


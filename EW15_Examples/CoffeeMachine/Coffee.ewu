// Product selection screen.
$rect <20,50,220,90>
$output false
class ProductScreen : Core::Group
{
  $rect <510,0,710,40>
  inherited property Bounds = <0,0,480,272>;

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image Image
  {
    preset Bounds = <0,0,480,272>;
    preset Bitmap = Coffee::ProductBackground;
  }

  // This is a slide gesture handler.
  $rect <20,20,160,60>
  object Core::SlideTouchHandler SlideTouchHandler
  {
    preset Bounds = <0,0,480,272>;
    preset SnapNext = <480,0>;
    preset SlideVert = false;
  }

  // This is an outline view to group other views together.
  $rect <20,20,160,60>
  object Core::Outline Outline
  {
    preset Bounds = <0,0,480,272>;
    preset SlideHandler = SlideTouchHandler;
    preset Formation = Core::Formation.LeftToRight;
  }

  $rect <20,20,160,60>
  object Coffee::Espresso Espresso
  {
    preset Bounds = <20,20,500,292>;
    preset Embedded = true;
  }

  $rect <20,20,160,60>
  object Coffee::Cappuccino Cappuccino
  {
    preset Bounds = <70,70,550,342>;
    preset Embedded = true;
  }

  $rect <20,20,160,60>
  object Coffee::Coffee Coffee
  {
    preset Bounds = <130,120,610,392>;
    preset Embedded = true;
  }

  $rect <20,20,160,60>
  object Coffee::HotWater HotWater
  {
    preset Bounds = <190,170,670,442>;
    preset Embedded = true;
  }

  $rect <20,20,160,60>
  object Coffee::ActionButton ActionButton
  {
    preset Bounds = <350,162,480,272>;
    preset ActionType = Coffee::ActionType.Start;
  }

  // Slot property to register a slot method that will be called when the user presses \
  // the action button.
  $rect <510,200,710,240>
  property slot OnStartBrewing;

  $rect <510,240,710,280>
  onset OnStartBrewing
  {
    /* check for any update */
    if ( pure OnStartBrewing == value )
      return;

    /* store the given slot method */
    pure OnStartBrewing = value;

    /* connect the action button with the provided slot method */
    ActionButton.OnAction = value;
  }

  // This is the product screen of the coffee machine. This screen is used to select \
  // a coffee machine product, to configure it and to start the brewing process. \
  // All different product configuration components (e.g. Espresso, Cappuccino,...) \
  // are embedded within an Outline component. The Outline takes care that the embedded \
  // components are arranged automatically in a horizontal order. The Outline is \
  // combined with a SlideTouchHandler, so that the current coffee machine product \
  // can be selected by a simple wipe gesture.
  note legend Note
  {
    attr Bounds = <0,290,700,420>;
  }
}


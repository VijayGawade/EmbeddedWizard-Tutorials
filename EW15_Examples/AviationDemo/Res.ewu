$version 15.00

// Background bitmap of the heading indicator (gyro).
$rect <10,210,210,250>
$output false
resource Resources::Bitmap Gyro_Background
{
  attr bitmapfile FileName = .\Res\Gyro_Background.png;
  attr framesize FrameSize;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}

// Foreground bitmap of the heading indicator (gyro).
$rect <440,210,640,250>
$output false
resource Resources::Bitmap Gyro_Foreground
{
  attr bitmapfile FileName = .\Res\Gyro_Foreground.png;
  attr framesize FrameSize;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}


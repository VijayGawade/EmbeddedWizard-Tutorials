// This is a bitmap resource.
$rect <30,350,230,390>
$output false
resource Resources::Bitmap SteelBitmap
{
  attr bitmapfile FileName = .\Res\SteelBackground.bmp;
  attr framesize FrameSize;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}

$rect <30,220,230,260>
$output false
resource Resources::Bitmap PushButtonImages
{
  attr bitmapfile FileName = .\Res\SteelButtonStripe40x40.png;
  attr framesize FrameSize = <40,40>;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}

$rect <30,260,230,300>
$output false
resource Resources::Bitmap PushButtonImagesRed
{
  attr bitmapfile FileName = .\Res\SteelButtonStripeRed40x40.png;
  attr framesize FrameSize = <40,40>;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}

$rect <30,300,230,340>
$output false
resource Resources::Bitmap PushButtonImagesGreen
{
  attr bitmapfile FileName = .\Res\SteelButtonStripeGreen40x40.png;
  attr framesize FrameSize = <40,40>;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}

// Font resources
note group Note
{
  attr Bounds = <10,10,250,160>;
}

// Bitmap resources
note group Note1
{
  attr Bounds = <10,170,250,410>;
}

// Colors and their names
note group Note2
{
  attr Bounds = <260,10,710,490>;
}

// How to manage resources and assets?
// 
// https://doc.embedded-wizard.de/managing-resource-data
note legend Note6
{
  attr Bounds = <10,500,500,570>;
}

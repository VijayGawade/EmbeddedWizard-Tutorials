$version 15.00

// This is a font resource used for text beside buttons.
$rect <30,60,230,100>
$output false
resource Resources::Font DescriptionFont
{
  attr fontname FontName = Arial;
  attr fontheight Height = 12;
  attr fontquality Quality = High;
  attr fontranges Ranges = 0x20-0x7F;
  attr fontaspectratio AspectRatio = 1.0;
  attr fontbold Bold = false;
  attr fontitalic Italic = false;
  attr fontkerning Kerning = true;
  attr fontheightmode HeightMode = Compatible;
  attr fontrowdistance RowDistance;
}

// This is a font resource used for all text outputs within the oscilloscope.
$rect <30,100,230,140>
$output false
resource Resources::Font DisplayFont
{
  attr fontname FontName = Verdana;
  attr fontheight Height = 16;
  attr fontquality Quality = High;
  attr fontranges Ranges = 0x20-0x7F;
  attr fontaspectratio AspectRatio = 1.0;
  attr fontbold Bold = false;
  attr fontitalic Italic = false;
  attr fontkerning Kerning = true;
  attr fontheightmode HeightMode = Compatible;
  attr fontrowdistance RowDistance;
}


// Application class of the oscilloscope demo.
$rect <30,60,230,100>
$output false
class Application : Core::Root
{
  $rect <350,200,550,240>
  inherited property Bounds = <0,0,320,240>;

  $rect <350,10,550,50>
  object Application::DataSource0 DataSource0;

  $rect <350,90,550,130>
  object Application::DataSource2 DataSource2;

  $rect <350,50,550,90>
  object Application::DataSource1 DataSource1;

  $rect <350,130,550,170>
  object Application::DataSource3 DataSource3;

  // This is a wallpaper view.
  $rect <20,20,160,60>
  object Views::Wallpaper Wallpaper
  {
    preset Bounds = <0,0,320,240>;
    preset Bitmap = Res::SteelBitmap;
  }

  $rect <20,20,160,60>
  object Application::Oscilloscope Oscilloscope
  {
    preset Bounds = <0,0,320,180>;
    preset GridColor = Res::GridColor0;
    preset Speed = 200;
    preset BeamColor = Res::BeamColor0;
    preset DataProvider = DataSource1;
  }

  // This application class contains just the background, the oscilloscope view and \
  // the data sources.
  // It is intended to be used as a base for variants of the application class in \
  // order to support different screen sizes.
  note legend Note
  {
    attr Bounds = <0,260,550,390>;
  }
}

$rect <240,60,440,100>
$variant Win32_VGA
vclass Application_VGA : Application::Application
{
  $rect <660,400,860,440>
  inherited property Bounds = <0,0,640,480>;

  $rect <20,20,160,60>
  inherited object Wallpaper
  {
    preset Bounds = <0,0,640,480>;
  }

  $rect <20,20,160,60>
  inherited object Oscilloscope
  {
    preset Bounds = <10,10,470,340>;
  }

  // This slot method is called when the user pressed the power button.
  $rect <660,10,860,50>
  slot PowerSlot
  {
    // switch on/off scope and all buttons
    Oscilloscope.Enabled = PushButtonPower.Active;
    PushButtonInfo.Enabled = PushButtonPower.Active;
    PushButtonAmplificationUp.Enabled = PushButtonPower.Active;
    PushButtonAmplificationDown.Enabled = PushButtonPower.Active;
    PushButtonVelocityUp.Enabled = PushButtonPower.Active;
    PushButtonVelocityDown.Enabled = PushButtonPower.Active;
    PushButtonBeamColor.Enabled = PushButtonPower.Active;
    PushButtonGridColor.Enabled = PushButtonPower.Active;
    PushButtonBeamIntensity.Enabled = PushButtonPower.Active;
    PushButtonLuminousPeriod.Enabled = PushButtonPower.Active;
    PushButtonSource0.Enabled = PushButtonPower.Active;
    PushButtonSource1.Enabled = PushButtonPower.Active;
    PushButtonSource2.Enabled = PushButtonPower.Active;
    PushButtonSource3.Enabled = PushButtonPower.Active;
    PreviewSource0.Enabled = PushButtonPower.Active;
    PreviewSource1.Enabled = PushButtonPower.Active;
    PreviewSource2.Enabled = PushButtonPower.Active;
    PreviewSource3.Enabled = PushButtonPower.Active;

    PushButtonInfo.Active = false;
    AboutText.Visible = false;
  }

  // This slot method is called when the user pressed the info button. As a result \
  // the info text is switched on and off.
  $rect <660,50,860,90>
  slot InfoSlot
  {
    AboutText.Visible = PushButtonInfo.Active;
    Oscilloscope.Enabled = !PushButtonInfo.Active;

  }

  // This is a slot method.
  $rect <660,90,860,130>
  slot AmplificationSlot
  {
    /* query value from device */
    var int32 gain = Oscilloscope.Gain;

    if ( sender == PushButtonAmplificationUp )
    {
      /* increase the amplification */
      switch ( gain )
      {
        case 1: gain = 2;
        case 2: gain = 5;
        case 5: gain = 10;
        case 10: gain = 20;
        case 20: gain = 50;
        case 50: gain = 100;
        case 100: gain = 200;
        case 200: gain = 500;
        case 500: gain = 1000;
        case 1000: gain = 1000;
        default: gain = 100;
      }
    }

    if ( sender == PushButtonAmplificationDown )
    {
      /* decrease the amplification */
      switch ( gain )
      {
        case 1: gain = 1;
        case 2: gain = 1;
        case 5: gain = 2;
        case 10: gain = 5;
        case 20: gain = 10;
        case 50: gain = 20;
        case 100: gain = 50;
        case 200: gain = 100;
        case 500: gain = 200;
        case 1000: gain = 500;
        default: gain = 100;
      }
    }

    /* assign the new value to device */
    Oscilloscope.Gain = gain;

    /* create the string for value text */
    ActiveValueText.String = "Amplification: " + string( gain ) + "%";

    /* restart timer */
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // This is a slot method.
  $rect <660,130,860,170>
  slot VelocitySlot
  {
    /* query value from device */
    var int32 speed = Oscilloscope.Speed;

    if ( sender == PushButtonVelocityUp )
    {
      /* increase the velocity */
      switch ( speed )
      {
        case 10: speed = 10;
        case 20: speed = 10;
        case 50: speed = 20;
        case 100: speed = 50;
        case 200: speed = 100;
        case 500: speed = 200;
        case 1000: speed = 500;
        default: speed = 100;
      }
    }

    if ( sender == PushButtonVelocityDown )
    {
      /* decrease the velocity */
      switch ( speed )
      {
        case 10: speed = 20;
        case 20: speed = 50;
        case 50: speed = 100;
        case 100: speed = 200;
        case 200: speed = 500;
        case 500: speed = 1000;
        case 1000: speed = 1000;
        default: speed = 100;
      }
    }

    /* assign the new value to device */
    Oscilloscope.Speed = speed;

    /* create the string for value text */
    ActiveValueText.String = "Velocity: " + string( speed ) + " ms/Div";

    /* restart timer */
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // This is a slot method.
  $rect <660,170,860,210>
  slot BeamColorSlot
  {
    /* select next beam color */
    BeamColorIndex = BeamColorIndex + 1;
    if ( BeamColorIndex > 4 )
      BeamColorIndex = 0;

    switch ( BeamColorIndex )
    {
      case 0: 
      { 
        Oscilloscope.BeamColor = Res::BeamColor0;
        ActiveValueText.String = Res::BeamColorText0;
      }
      case 1: 
      {
        Oscilloscope.BeamColor = Res::BeamColor1;
        ActiveValueText.String = Res::BeamColorText1;
      }
      case 2: 
      {
        Oscilloscope.BeamColor = Res::BeamColor2;
        ActiveValueText.String = Res::BeamColorText2;
      }
      case 3: 
      {
        Oscilloscope.BeamColor = Res::BeamColor3;
        ActiveValueText.String = Res::BeamColorText3;
      }
      case 4: 
      {
        Oscilloscope.BeamColor = Res::BeamColor4;
        ActiveValueText.String = Res::BeamColorText4;
      }
      default:;
    }


    // restart timer
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // This is a slot method.
  $rect <660,210,860,250>
  slot GridColorSlot
  {
    /* select next grid color */
    GridColorIndex = GridColorIndex + 1;
    if ( GridColorIndex > 4 )
      GridColorIndex = 0;

    switch ( GridColorIndex )
    {
      case 0: 
      { 
        Oscilloscope.GridColor = Res::GridColor0;
        ActiveValueText.String = Res::GridColorText0;
      }
      case 1: 
      {
        Oscilloscope.GridColor = Res::GridColor1;
        ActiveValueText.String = Res::GridColorText1;
      }
      case 2: 
      {
        Oscilloscope.GridColor = Res::GridColor2;
        ActiveValueText.String = Res::GridColorText2;
      }
      case 3: 
      {
        Oscilloscope.GridColor = Res::GridColor3;
        ActiveValueText.String = Res::GridColorText3;
      }
      case 4: 
      {
        Oscilloscope.GridColor = Res::GridColor4;
        ActiveValueText.String = Res::GridColorText4;
      }
      default:;
    }


    // restart timer
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // This is a slot method.
  $rect <660,250,860,290>
  slot BeamIntensitySlot
  {
    /* query value from device */
    var int32 glow = Oscilloscope.BeamGlow;

    /* select next glow value */
    glow = glow + 1;
    if ( glow > 3 )
      glow = 0;

    /* assign the new value to device */
    Oscilloscope.BeamGlow = glow;

    /* create the string for value text */
    ActiveValueText.String = "BeamIntensity: " + string( glow );

    /* restart timer */
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // This is a slot method.
  $rect <660,290,860,330>
  slot LuminousPeriodSlot
  {
    /* query value from device */
    var int32 wiper = Oscilloscope.ScreenWiper;

    /* increase the luminous period means decreasing the size of screen wiper */
    if ( wiper > 66 )
      wiper = 50;
    else if ( wiper  > 33 )
      wiper = 0;
    else
      wiper = 100;

    /* assign the new value to device */
    Oscilloscope.ScreenWiper = wiper;

    /* create the string for value text */
    if ( wiper < 33 )
      ActiveValueText.String = "Luminous Period: High";
    else if ( wiper > 66 )
      ActiveValueText.String = "Luminous Period: Low";
    else
      ActiveValueText.String = "Luminous Period: Medium";

    /* restart timer */
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // This is a slot method.
  $rect <660,350,860,390>
  slot SelectSourceSlot
  {
    var int32 sourceIndex;

    if ( sender == PushButtonSource0 )
    {
      Oscilloscope.DataProvider = DataSource0;
      sourceIndex = 0;
    }
    else if ( sender == PushButtonSource1 )
    {
      Oscilloscope.DataProvider = DataSource1;
      sourceIndex = 1;
    }
    else if ( sender == PushButtonSource2 )
    {
      Oscilloscope.DataProvider = DataSource2;
      sourceIndex = 2;
    }
    else if ( sender == PushButtonSource3 )
    {
      Oscilloscope.DataProvider = DataSource3;
      sourceIndex = 3;
    }

    ActiveValueText.String = "Data Source: Source " + string( sourceIndex );

    // restart timer
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // Internal variable to store the index of the currently selected beam color.
  $rect <860,170,1060,210>
  var int32 BeamColorIndex = 0;

  // Internal variable to store the index of the currently selected grid color.
  $rect <860,210,1060,250>
  var int32 GridColorIndex = 0;

  // This is a push button control.
  $rect <20,20,160,60>
  object Application::Button PushButtonAmplificationUp
  {
    preset Bounds = <500,85,540,125>;
    preset OnChange = AmplificationSlot;
  }

  // This is a push button control.
  $rect <20,20,160,60>
  object Application::Button PushButtonAmplificationDown
  {
    preset Bounds = <500,125,540,165>;
    preset OnChange = AmplificationSlot;
  }

  $rect <20,20,160,60>
  object Application::ButtonRed PushButtonInfo
  {
    preset Bounds = <580,15,620,55>;
    preset OnChange = InfoSlot;
  }

  $rect <20,20,160,60>
  object Application::ButtonGreen PushButtonPower
  {
    preset Bounds = <500,15,540,55>;
    preset OnChange = PowerSlot;
    preset Active = true;
  }

  // This is a push button control.
  $rect <20,20,160,60>
  object Application::Button PushButtonVelocityUp
  {
    preset Bounds = <580,85,620,125>;
    preset OnChange = VelocitySlot;
  }

  // This is a push button control.
  $rect <20,20,160,60>
  object Application::Button PushButtonVelocityDown
  {
    preset Bounds = <580,125,620,165>;
    preset OnChange = VelocitySlot;
  }

  // This is a push button control.
  $rect <20,20,160,60>
  object Application::Button PushButtonBeamIntensity
  {
    preset Bounds = <500,270,540,310>;
    preset OnChange = BeamIntensitySlot;
  }

  // This is a push button control.
  $rect <20,20,160,60>
  object Application::Button PushButtonBeamColor
  {
    preset Bounds = <500,200,540,240>;
    preset OnChange = BeamColorSlot;
  }

  // This is a push button control.
  $rect <20,20,160,60>
  object Application::Button PushButtonGridColor
  {
    preset Bounds = <580,200,620,240>;
    preset OnChange = GridColorSlot;
  }

  // This is a push button control.
  $rect <20,20,160,60>
  object Application::Button PushButtonLuminousPeriod
  {
    preset Bounds = <580,270,620,310>;
    preset OnChange = LuminousPeriodSlot;
  }

  $rect <20,20,160,60>
  object Application::Button PushButtonSource0
  {
    preset Bounds = <20,350,60,390>;
    preset OnChange = SelectSourceSlot;
  }

  $rect <20,20,160,60>
  object Application::Button PushButtonSource1
  {
    preset Bounds = <180,350,220,390>;
    preset OnChange = SelectSourceSlot;
  }

  $rect <20,20,160,60>
  object Application::Button PushButtonSource2
  {
    preset Bounds = <340,350,380,390>;
    preset OnChange = SelectSourceSlot;
  }

  $rect <20,20,160,60>
  object Application::Button PushButtonSource3
  {
    preset Bounds = <500,350,540,390>;
    preset OnChange = SelectSourceSlot;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextPower
  {
    preset Bounds = <500,55,540,75>;
    preset String = "Power";
    preset Font = Res::DescriptionFont;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextInfo
  {
    preset Bounds = <580,55,620,75>;
    preset Font = Res::DescriptionFont;
    preset String = "Info";
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextUp
  {
    preset Bounds = <545,95,575,112>;
    preset Font = Res::DescriptionFont;
    preset String = "Up";
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextDown
  {
    preset Bounds = <545,138,575,155>;
    preset Font = Res::DescriptionFont;
    preset String = "Down";
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextVelocity
  {
    preset Bounds = <580,165,620,185>;
    preset Font = Res::DescriptionFont;
    preset String = "Velocity";
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextAmplification
  {
    preset Bounds = <490,165,550,185>;
    preset Font = Res::DescriptionFont;
    preset String = "Amplification";
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextBeamColor
  {
    preset Bounds = <490,240,550,260>;
    preset Font = Res::DescriptionFont;
    preset String = "Beam Color";
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextGridColor
  {
    preset Bounds = <570,240,630,260>;
    preset Font = Res::DescriptionFont;
    preset String = "Grid Color";
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextSource0
  {
    preset Bounds = <67,373,127,393>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertCenter];
    preset String = "Source 0";
    preset Font = Res::DescriptionFont;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextSource1
  {
    preset Bounds = <227,373,287,393>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertCenter];
    preset String = "Source 1";
    preset Font = Res::DescriptionFont;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextSource2
  {
    preset Bounds = <387,373,447,393>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertCenter];
    preset String = "Source 2";
    preset Font = Res::DescriptionFont;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextSource3
  {
    preset Bounds = <547,373,607,393>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertCenter];
    preset String = "Source 3";
    preset Font = Res::DescriptionFont;
  }

  // This is a multiline text object.
  $rect <20,20,160,60>
  object Views::Text TextLuminousPeriod
  {
    preset Bounds = <570,310,630,340>;
    preset Font = Res::DescriptionFont;
    preset String = "Luminous\nPeriod";
  }

  // This is a multiline text object.
  $rect <20,20,160,60>
  object Views::Text TextBeamIntensity
  {
    preset Bounds = <490,310,550,340>;
    preset Font = Res::DescriptionFont;
    preset String = "Beam\nIntensity";
  }

  // This is a multiline text object.
  $rect <20,20,160,60>
  object Views::Text AboutText
  {
    preset Bounds = <10,10,470,300>;
    preset String = "Welcome to Embedded Wizard\nOscilloscope Demo\n\nwww.embedded-wizard.de";
    preset Font = Res::DisplayFont;
    preset Visible = false;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text ActiveValueText
  {
    preset Bounds = <20,310,330,330>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertCenter];
    preset String = "Active Value";
    preset Font = Res::DisplayFont;
    preset Visible = false;
  }

  $rect <20,20,160,60>
  object Application::Oscilloscope PreviewSource0
  {
    preset Bounds = <10,400,150,470>;
    preset GridColor = Res::GridColor0;
    preset Speed = 200;
    preset BeamColor = Res::BeamColor0;
    preset BeamGlow = 0;
    preset DataProvider = DataSource0;
  }

  $rect <20,20,160,60>
  object Application::Oscilloscope PreviewSource1
  {
    preset Bounds = <170,400,310,470>;
    preset GridColor = Res::GridColor0;
    preset Speed = 200;
    preset BeamColor = Res::BeamColor2;
    preset BeamGlow = 0;
    preset DataProvider = DataSource1;
    preset Gain = 200;
  }

  $rect <20,20,160,60>
  object Application::Oscilloscope PreviewSource2
  {
    preset Bounds = <330,400,470,470>;
    preset GridColor = Res::GridColor0;
    preset Speed = 500;
    preset BeamColor = Res::BeamColor3;
    preset BeamGlow = 0;
    preset DataProvider = DataSource2;
  }

  $rect <20,20,160,60>
  object Application::Oscilloscope PreviewSource3
  {
    preset Bounds = <490,400,630,470>;
    preset GridColor = Res::GridColor0;
    preset BeamColor = Res::BeamColor4;
    preset BeamGlow = 0;
    preset DataProvider = DataSource3;
  }

  // This is a pulse color effect to fade out the active value text.
  $rect <660,450,860,490>
  object Effects::ColorEffect ColorEffectValueText
  {
    preset NoOfCycles = 1;
    preset InitialDelay = 5000;
    preset Value2 = #FFFFFF00;
    preset Value1 = #FFFFFFFF;
    preset Outlet = ^ActiveValueText.Color;
  }

  // This is the variant of the application class for a screen size of 640x480 pixels \
  // (VGA).
  // It contains a couple of buttons to configure the oscilloscope and it contains \
  // previews of the four data sources.
  // 
  // This variant is used when the profile Win32_VGA is used.
  note legend Note
  {
    attr Bounds = <0,500,650,620>;
  }
}

$rect <450,60,650,100>
$variant Win32_QVGA
vclass Application_QVGA : Application::Application
{
  // Slot method for changing the grid color of the oscilloscope.
  $rect <340,240,540,280>
  slot ChangeGridColorSlot
  {
    if ( sender == PushButtonUp )
    {
      GridColorIndex = GridColorIndex + 1;
      if ( GridColorIndex > 4 )
        GridColorIndex = 0;
    }

    if ( sender == PushButtonDown )
    {
      GridColorIndex = GridColorIndex - 1;
      if ( GridColorIndex < 0 )
        GridColorIndex = 4;
    }

    switch ( GridColorIndex )
    {
      case 0: 
      { 
        Oscilloscope.GridColor = Res::GridColor0;
        ActiveValueText.String = Res::GridColorText0;
      }
      case 1: 
      {
        Oscilloscope.GridColor = Res::GridColor1;
        ActiveValueText.String = Res::GridColorText1;
      }
      case 2: 
      {
        Oscilloscope.GridColor = Res::GridColor2;
        ActiveValueText.String = Res::GridColorText2;
      }
      case 3: 
      {
        Oscilloscope.GridColor = Res::GridColor3;
        ActiveValueText.String = Res::GridColorText3;
      }
      case 4: 
      {
        Oscilloscope.GridColor = Res::GridColor4;
        ActiveValueText.String = Res::GridColorText4;
      }
      default:;
    }


    // restart timer
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // Internal variable to store the index of the currently selected beam color.
  $rect <540,120,740,160>
  var int32 BeamColorIndex = 0;

  // Internal variable to store the index of the currently selected grid color.
  $rect <540,240,740,280>
  var int32 GridColorIndex = 0;

  // Slot method for changing the amplification of the oscilloscope.
  $rect <340,0,540,40>
  slot ChangeAmplificationSlot
  {
    /* query value from device */
    var int32 gain = Oscilloscope.Gain;

    if ( sender == PushButtonUp )
    {
      /* increase the amplification */
      switch ( gain )
      {
        case 1: gain = 2;
        case 2: gain = 5;
        case 5: gain = 10;
        case 10: gain = 20;
        case 20: gain = 50;
        case 50: gain = 100;
        case 100: gain = 200;
        case 200: gain = 500;
        case 500: gain = 1000;
        case 1000: gain = 1000;
        default: gain = 100;
      }
    }

    if ( sender == PushButtonDown )
    {
      /* decrease the amplification */
      switch ( gain )
      {
        case 1: gain = 1;
        case 2: gain = 1;
        case 5: gain = 2;
        case 10: gain = 5;
        case 20: gain = 10;
        case 50: gain = 20;
        case 100: gain = 50;
        case 200: gain = 100;
        case 500: gain = 200;
        case 1000: gain = 500;
        default: gain = 100;
      }
    }

    /* assign the new value to device */
    Oscilloscope.Gain = gain;

    /* create the string for value text */
    ActiveValueText.String = "Amplification: " + string( gain ) + "%";

    /* restart timer */
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // Slot method for changing the velocity of the oscilloscope.
  $rect <340,40,540,80>
  slot ChangeVelocitySlot
  {
    /* query value from device */
    var int32 speed = Oscilloscope.Speed;

    if ( sender == PushButtonUp )
    {
      /* increase the velocity */
      switch ( speed )
      {
        case 10: speed = 10;
        case 20: speed = 10;
        case 50: speed = 20;
        case 100: speed = 50;
        case 200: speed = 100;
        case 500: speed = 200;
        case 1000: speed = 500;
        default: speed = 100;
      }
    }

    if ( sender == PushButtonDown )
    {
      /* decrease the velocity */
      switch ( speed )
      {
        case 10: speed = 20;
        case 20: speed = 50;
        case 50: speed = 100;
        case 100: speed = 200;
        case 200: speed = 500;
        case 500: speed = 1000;
        case 1000: speed = 1000;
        default: speed = 100;
      }
    }

    /* assign the new value to device */
    Oscilloscope.Speed = speed;

    /* create the string for value text */
    ActiveValueText.String = "Velocity: " + string( speed ) + " ms/Div";

    /* restart timer */
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // Slot method for changing the source of the oscilloscope.
  $rect <340,80,540,120>
  slot ChangeSourceSlot
  {
    if ( sender == PushButtonUp )
    {
      SourceIndex = SourceIndex + 1;
      if ( SourceIndex > 3 )
        SourceIndex = 0;
    }

    if ( sender == PushButtonDown )
    {
      SourceIndex = SourceIndex - 1;
      if ( SourceIndex < 0 )
        SourceIndex = 3;
    }

    switch ( SourceIndex )
    {
      case 0: 
      { 
        Oscilloscope.DataProvider = DataSource0;
      }
      case 1: 
      {
        Oscilloscope.DataProvider = DataSource1;
      }
      case 2: 
      {
        Oscilloscope.DataProvider = DataSource2;
      }
      case 3: 
      {
        Oscilloscope.DataProvider = DataSource3;
      }
      default:;
    }

    ActiveValueText.String = "Data Source: Source " + string( SourceIndex );

    // restart timer
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // Slot method for changing the beam color of the oscilloscope.
  $rect <340,120,540,160>
  slot ChangeBeamColorSlot
  {
    if ( sender == PushButtonUp )
    {
      BeamColorIndex = BeamColorIndex + 1;
      if ( BeamColorIndex > 4 )
        BeamColorIndex = 0;
    }

    if ( sender == PushButtonDown )
    {
      BeamColorIndex = BeamColorIndex - 1;
      if ( BeamColorIndex < 0 )
        BeamColorIndex = 4;
    }

    switch ( BeamColorIndex )
    {
      case 0: 
      { 
        Oscilloscope.BeamColor = Res::BeamColor0;
        ActiveValueText.String = Res::BeamColorText0;
      }
      case 1: 
      {
        Oscilloscope.BeamColor = Res::BeamColor1;
        ActiveValueText.String = Res::BeamColorText1;
      }
      case 2: 
      {
        Oscilloscope.BeamColor = Res::BeamColor2;
        ActiveValueText.String = Res::BeamColorText2;
      }
      case 3: 
      {
        Oscilloscope.BeamColor = Res::BeamColor3;
        ActiveValueText.String = Res::BeamColorText3;
      }
      case 4: 
      {
        Oscilloscope.BeamColor = Res::BeamColor4;
        ActiveValueText.String = Res::BeamColorText4;
      }
      default:;
    }


    // restart timer
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // Slot method for changing the beam intensity of the oscilloscope.
  $rect <340,160,540,200>
  slot ChangeBeamIntensitySlot
  {
    /* query value from device */
    var int32 glow = Oscilloscope.BeamGlow;

    if ( sender == PushButtonUp )
    {
      /* increase the glow */
      glow = glow + 1;
      if ( glow > 3 )
        glow = 3;
    }

    if ( sender == PushButtonDown )
    {
      /* decrease the glow */
      glow = glow - 1;
      if ( glow < 0 )
        glow = 0;
    }

    /* assign the new value to device */
    Oscilloscope.BeamGlow = glow;

    /* create the string for value text */
    ActiveValueText.String = "BeamIntensity: " + string( glow );

    /* restart timer */
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // Slot method for changing the luminous period (screen wiper) of the oscilloscope.
  $rect <340,200,540,240>
  slot ChangeLuminousPeriodSlot
  {
    /* query value from device */
    var int32 wiper = Oscilloscope.ScreenWiper;

    if ( sender == PushButtonUp )
    {
      /* increase the luminous period means decreasing the size of screen wiper */
      if ( wiper > 66 )
        wiper = 50;
      else
        wiper = 0;
    }

    if ( sender == PushButtonDown )
    {
      /* decrease the luminous period means increasing the size of screen wiper */
      if ( wiper < 33 )
        wiper = 50;
      else
        wiper = 100;
    }

    /* assign the new value to device */
    Oscilloscope.ScreenWiper = wiper;

    /* create the string for value text */
    if ( wiper < 33 )
      ActiveValueText.String = "Luminous Period: High";
    else if ( wiper > 66 )
      ActiveValueText.String = "Luminous Period: Low";
    else
      ActiveValueText.String = "Luminous Period: Medium";

    /* restart timer */
    ActiveValueText.Color = #FFFFFFFF;
    ActiveValueText.Visible = true;
    ColorEffectValueText.Enabled = false; 
    ColorEffectValueText.Enabled = true; 
  }

  // Internal variable to store the index of the currently selected data source.
  $rect <540,80,740,120>
  var int32 SourceIndex = 0;

  // This slot method is called when the user pressed the power button.
  $rect <10,270,210,310>
  slot PowerSlot
  {
    // switch on/off scope and all buttons
    Oscilloscope.Enabled = PushButtonPower.Active;
    PushButtonInfo.Enabled = PushButtonPower.Active;
    PushButtonFunction.Enabled = PushButtonPower.Active;
    PushButtonUp.Enabled = PushButtonPower.Active;
    PushButtonDown.Enabled = PushButtonPower.Active;

    PushButtonInfo.Active = false;
    AboutText.Visible = false;
  }

  // This slot method is called when the user pressed the info button. As a result \
  // the info text is switched on and off.
  $rect <10,320,210,360>
  slot InfoSlot
  {
    AboutText.Visible = PushButtonInfo.Active;
    Oscilloscope.Enabled = !PushButtonInfo.Active;

  }

  // This slot method is called when the user pressed the function button. According \
  // the currently selected function, the buttons 'Up' and 'Down' are connected with \
  // the corresponding ChangeXxxSlot method.
  $rect <10,370,210,410>
  slot FunctionSlot
  {
    /* if there is currently the active function visible, the next function 
       will be selected, otherwise, the last active function appears again */
    if ( ColorEffectFunctionText.Enabled == true )
    {
      ActiveFunction = ActiveFunction + 1;
      if ( ActiveFunction > 6 )
        ActiveFunction = 0;
    }

    /* assign the corresponding text and connect the up/down butten with the corresponding slot */
    switch ( ActiveFunction )
    {
      case 0: 
      {
        ActiveFunctionText.String = "Active Function: Amplification";
        PushButtonUp.OnChange   = ChangeAmplificationSlot;
        PushButtonDown.OnChange = ChangeAmplificationSlot;
      }
      case 1: 
      {
        ActiveFunctionText.String = "Active Function: Velocity";
        PushButtonUp.OnChange   = ChangeVelocitySlot;
        PushButtonDown.OnChange = ChangeVelocitySlot;
      }
      case 2: 
      {
        ActiveFunctionText.String = "Active Function: Source";
        PushButtonUp.OnChange   = ChangeSourceSlot;
        PushButtonDown.OnChange = ChangeSourceSlot;
      }
      case 3: 
      {
        ActiveFunctionText.String = "Active Function: Beam Color";
        PushButtonUp.OnChange   = ChangeBeamColorSlot;
        PushButtonDown.OnChange = ChangeBeamColorSlot;
      }
      case 4: 
      {
        ActiveFunctionText.String = "Active Function: Beam Intensity";
        PushButtonUp.OnChange   = ChangeBeamIntensitySlot;
        PushButtonDown.OnChange = ChangeBeamIntensitySlot;
      }
      case 5: 
      {
        ActiveFunctionText.String = "Active Function: Luminous Period";
        PushButtonUp.OnChange   = ChangeLuminousPeriodSlot;
        PushButtonDown.OnChange = ChangeLuminousPeriodSlot;
      }
      case 6: 
      {  
        ActiveFunctionText.String = "Active Function: Grid Color";
        PushButtonUp.OnChange   = ChangeGridColorSlot;
        PushButtonDown.OnChange = ChangeGridColorSlot;
      }
      default:;
    }


    /* make text visible and restart timer */
    ActiveFunctionText.Color = #FFFFFFFF;
    ActiveFunctionText.Visible = true;
    ColorEffectFunctionText.Enabled = false; 
    ColorEffectFunctionText.Enabled = true; 

    /* clear value text */
    ActiveValueText.String = "";

  }

  // This variable stores the index of the currently active function.
  $rect <210,370,410,410>
  var int32 ActiveFunction = 0;

  // This is a push button control.
  $rect <20,20,160,60>
  object Application::Button PushButtonFunction
  {
    preset Bounds = <150,185,190,225>;
    preset OnChange = FunctionSlot;
  }

  // This is a push button control.
  $rect <20,20,160,60>
  object Application::Button PushButtonUp
  {
    preset Bounds = <270,185,310,225>;
  }

  // This is a push button control.
  $rect <20,20,160,60>
  object Application::Button PushButtonDown
  {
    preset Bounds = <220,185,260,225>;
  }

  $rect <20,20,160,60>
  object Application::ButtonRed PushButtonInfo
  {
    preset Bounds = <60,185,100,225>;
    preset OnChange = InfoSlot;
  }

  $rect <20,20,160,60>
  object Application::ButtonGreen PushButtonPower
  {
    preset Bounds = <10,185,50,225>;
    preset OnChange = PowerSlot;
    preset Active = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextPower
  {
    preset Bounds = <10,225,50,241>;
    preset Font = Res::DescriptionFont;
    preset String = "Power";
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextInfo
  {
    preset Bounds = <60,225,100,241>;
    preset Font = Res::DescriptionFont;
    preset String = "Info";
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextFunction
  {
    preset Bounds = <150,225,190,241>;
    preset Font = Res::DescriptionFont;
    preset String = "Function";
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextUp
  {
    preset Bounds = <270,225,310,241>;
    preset Font = Res::DescriptionFont;
    preset String = "Up";
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text TextDown
  {
    preset Bounds = <220,225,260,241>;
    preset Font = Res::DescriptionFont;
    preset String = "Down";
  }

  // This is a multiline text object.
  $rect <20,20,160,60>
  object Views::Text AboutText
  {
    preset Bounds = <0,0,320,150>;
    preset String = "Welcome to Embedded Wizard\nOscilloscope Demo\n\nwww.embedded-wizard.de";
    preset Font = Res::DisplayFont;
    preset Visible = false;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text ActiveFunctionText
  {
    preset Bounds = <5,142,315,162>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertCenter];
    preset String = "Active Function";
    preset Font = Res::DisplayFont;
    preset Visible = false;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text ActiveValueText
  {
    preset Bounds = <5,160,315,180>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertCenter];
    preset String = "Active Value";
    preset Font = Res::DisplayFont;
    preset Visible = false;
  }

  // This is a pulse color effect to fade out the active value text.
  $rect <340,300,540,340>
  object Effects::ColorEffect ColorEffectValueText
  {
    preset NoOfCycles = 1;
    preset InitialDelay = 5000;
    preset Value2 = #FFFFFF00;
    preset Value1 = #FFFFFFFF;
    preset Outlet = ^ActiveValueText.Color;
  }

  // This is a pulse color effect to fade out the active value text.
  $rect <540,300,740,340>
  object Effects::ColorEffect ColorEffectFunctionText
  {
    preset NoOfCycles = 1;
    preset InitialDelay = 5000;
    preset Value2 = #FFFFFF00;
    preset Value1 = #FFFFFFFF;
    preset Outlet = ^ActiveFunctionText.Color;
  }

  // This is the variant of the application class for a screen size of 320x240 pixels \
  // (QVGA).
  // It contains a few buttons to configure the oscilloscope. The 'Function' button \
  // is used to select the parameter that can be increased / decreased with the 'Up' \
  // / 'Down' buttons.
  // 
  // This variant is used when the profile Win32_QVGA is used.
  note legend Note
  {
    attr Bounds = <0,420,650,540>;
  }
}

// How to manage project variants?
// 
// https://doc.embedded-wizard.de/managing-project-variants
note legend Note6
{
  attr Bounds = <680,10,1070,120>;
}

// Application class and variants
note group Note2
{
  attr Bounds = <10,10,670,120>;
}

// Oscilloscope class
note group Note3
{
  attr Bounds = <10,130,250,230>;
}

// Button widgets
note group Note4
{
  attr Bounds = <10,240,670,340>;
}


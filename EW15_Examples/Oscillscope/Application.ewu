$version 15.00

// The oscilloscope class. An oscilloscope (abbreviated sometimes as scope or O-scope) \
// is a type of electronic test instrument that allows signal voltages to be viewed, \
// usually as a two-dimensional graph of one or more electrical potential differences \
// (vertical axis) plotted as a function of time or of some other voltage (horizontal \
// axis). Although an oscilloscope displays voltage on its vertical axis, any other \
// quantity that can be converted to a voltage can be displayed as well. In most \
// instances, oscilloscopes show events that repeat with either no change, or change \
// slowly. The oscilloscope is one of the most versatile and widely-used electronic \
// instruments. Within this demo application the oscilloscope displays the given \
// set of data by using a simulated electronic beam.
$rect <30,170,230,210>
$output false
class Oscilloscope : Core::Group
{
  $rect <0,270,200,310>
  inherited property Bounds = <0,0,320,240>;

  $rect <200,270,400,310>
  inherited method UpdateLayout()
  {
    /* create canvas */
    if ( Canvas == null )
      Canvas = new Graphics::Canvas;

    /* set size to bounds area */
    Canvas.FrameSize = aSize;

    /* and clear the complete bitmap with black color */
    var rect r = rect( 0, 0, aSize.x, aSize.y );
    Canvas.FillRectangle( r, r, #000000FF, #000000FF, #000000FF, #000000FF, false );

    /* assign the canvas to the image object */
    Image.Bitmap = Canvas;
    Image.Bounds.size = aSize;

    /* arrange all scale lines */
    var int32 x = aSize.x - 1;
    var int32 y = aSize.y - 1;

    /* all horizontal lines */
    LineH0.Point1 = point( 0, y * 0 / 10 );
    LineH0.Point2 = point( x, y * 0 / 10 );
    LineH1.Point1 = point( 0, y * 1 / 10 );
    LineH1.Point2 = point( x, y * 1 / 10 );
    LineH2.Point1 = point( 0, y * 2 / 10 );
    LineH2.Point2 = point( x, y * 2 / 10 );
    LineH3.Point1 = point( 0, y * 3 / 10 );
    LineH3.Point2 = point( x, y * 3 / 10 );
    LineH4.Point1 = point( 0, y * 4 / 10 );
    LineH4.Point2 = point( x, y * 4 / 10 );
    LineH5.Point1 = point( 0, y * 5 / 10 );
    LineH5.Point2 = point( x, y * 5 / 10 );
    LineH6.Point1 = point( 0, y * 6 / 10 );
    LineH6.Point2 = point( x, y * 6 / 10 );
    LineH7.Point1 = point( 0, y * 7 / 10 );
    LineH7.Point2 = point( x, y * 7 / 10 );
    LineH8.Point1 = point( 0, y * 8 / 10 );
    LineH8.Point2 = point( x, y * 8 / 10 );
    LineH9.Point1 = point( 0, y * 9 / 10 );
    LineH9.Point2 = point( x, y * 9 / 10 );
    LineH10.Point1 = point( 0, y * 10 / 10 );
    LineH10.Point2 = point( x, y * 10 / 10 );

    /* and all vertical lines */
    LineV0.Point1 = point( x * 0 / 10, 0 );
    LineV0.Point2 = point( x * 0 / 10, y );
    LineV1.Point1 = point( x * 1 / 10, 0 );
    LineV1.Point2 = point( x * 1 / 10, y );
    LineV2.Point1 = point( x * 2 / 10, 0 );
    LineV2.Point2 = point( x * 2 / 10, y );
    LineV3.Point1 = point( x * 3 / 10, 0 );
    LineV3.Point2 = point( x * 3 / 10, y );
    LineV4.Point1 = point( x * 4 / 10, 0 );
    LineV4.Point2 = point( x * 4 / 10, y );
    LineV5.Point1 = point( x * 5 / 10, 0 );
    LineV5.Point2 = point( x * 5 / 10, y );
    LineV6.Point1 = point( x * 6 / 10, 0 );
    LineV6.Point2 = point( x * 6 / 10, y );
    LineV7.Point1 = point( x * 7 / 10, 0 );
    LineV7.Point2 = point( x * 7 / 10, y );
    LineV8.Point1 = point( x * 8 / 10, 0 );
    LineV8.Point2 = point( x * 8 / 10, y );
    LineV9.Point1 = point( x * 9 / 10, 0 );
    LineV9.Point2 = point( x * 9 / 10, y );
    LineV10.Point1 = point( x * 10 / 10, 0 );
    LineV10.Point2 = point( x * 10 / 10, y );

    /* now intialize the clipping variable, which is used later 
       as clipping for all drawing operations */
    Clipping = rect( 0, 0, aSize.x, aSize.y );

  }

  $rect <200,310,400,350>
  inherited method UpdateViewState()
  {
    var bool enabled = aState.contains( Core::ViewState[ Enabled ]);

    UpdateTimer.Enabled = enabled;

    // center beam position on left side
    BeamPosition = point( 0, Bounds.h / 2 );

    // clear buffer in case of disabling
    if ( !enabled && Canvas != null )
    {
      /* clear complete area */
      var rect r = rect( 0, 0, Bounds.w, Bounds.h );
      Canvas.FillRectangle( r, r, #000000FF, #000000FF, #000000FF, #000000FF, false );
      InvalidateArea( r );
    }
  }

  // The property 'GridColor' stores the color value of all horizontal and vertical \
  // lines used for drawing the grid.
  $rect <410,0,610,40>
  property color GridColor = #88888888;

  // The onset method for the property 'GridColor' changes the color of all horizontal \
  // and vertical grid lines.
  $rect <410,40,610,80>
  onset GridColor
  {
    /* if color does not change, nothing to do... */
    if ( GridColor == value )
      return;

    /* assign the color */
    pure GridColor = value;

    /* now set the color value to all horizontal grid lines */
    LineH0.Color = value;
    LineH1.Color = value;
    LineH2.Color = value;
    LineH3.Color = value;
    LineH4.Color = value;
    LineH5.Color = value;
    LineH6.Color = value;
    LineH7.Color = value;
    LineH8.Color = value;
    LineH9.Color = value;
    LineH10.Color = value;

    /* and set the color value to all vertical grid lines */
    LineV0.Color = value;
    LineV1.Color = value;
    LineV2.Color = value;
    LineV3.Color = value;
    LineV4.Color = value;
    LineV5.Color = value;
    LineV6.Color = value;
    LineV7.Color = value;
    LineV8.Color = value;
    LineV9.Color = value;
    LineV10.Color = value;


  }

  // The property 'Speed' stores the speed of the beam in milliseconds per division. \
  // Depending on the speed, the necessary number of samples are displayed.
  $rect <620,180,820,220>
  property int32 Speed = 100;

  // The onset method for the property 'Speed' changes the speed of the beam in the \
  // range from 1 to 1000.
  $rect <620,220,820,260>
  onset Speed
  {
    /* limit the milliseconds per division to a range from 1 to 1000 */
    if ( value < 1 )
      value = 1;

    if ( value > 1000 )
      value = 1000;

    /* assign the value */
    pure Speed = value;

    /* and inform the data provider */
    if ( DataProvider != null )
      DataProvider.Speed = value;
  }

  // The property 'RefreshRate' stores the number of milliseconds between the single \
  // display updates. Depending on the RefreshRate, the necessary number of samples \
  // are displayed.
  $rect <830,0,1030,40>
  property int32 RefreshRate = 50;

  // The onset method for the property 'RefreshRate' changes the update interval \
  // in the range from 10 to 1000 ms.
  $rect <830,40,1030,80>
  onset RefreshRate
  {
    /* limit the refresh rate to a range from 10 to 1000 */
    if ( value < 10 )
      value = 10;

    if ( value > 1000 )
      value = 1000;

    /* assign the value and set the update timer to the new period */
    pure RefreshRate = value;
    UpdateTimer.Period = value;
  }

  // The property 'ScreenWiper' stores the width of the screen wiper in the range \
  // from 0 to 100 (percent). The screen wiper clears the area right of the current \
  // beam position with a soft fade our effect.
  $rect <620,0,820,40>
  property int32 ScreenWiper = 20;

  // The onset method for the property 'ScreenWiper' changes the width of the screen \
  // wiper in the range from 0 (off) to 100 percent.
  $rect <620,40,820,80>
  onset ScreenWiper
  {
    /* limit size of screen wiper to a range from 0 to 100 */
    if ( value < 0 )
      value = 0;

    if ( value > 100 )
      value = 100;

    /* assign the value */
    pure ScreenWiper = value;
  }

  // The property 'BeamColor' stores the color value of the simulated beam.
  $rect <410,90,610,130>
  property color BeamColor = #00FF06FF;

  // The onset method for the property 'BeamColor' changes the color of the simulated \
  // beam.
  $rect <410,130,610,170>
  onset BeamColor
  {
    /* if color does not change, nothing to do... */
    if ( BeamColor == value )
      return;

    /* assign the color */
    pure BeamColor = value;


  }

  // The property 'BeamGlow' stores the width of the simulated beam point in the \
  // range from 0 to 3.
  $rect <410,180,610,220>
  property int32 BeamGlow = 1;

  // The onset method for the property 'BeamGlow' changes the size of the simulated \
  // beam point.
  $rect <410,220,610,260>
  onset BeamGlow
  {
    /* limit size of beam glow to a range from 0 to 3 */
    if ( value < 0 )
      value = 0;

    if ( value > 3 )
      value = 3;

    pure BeamGlow = value;
  }

  // The property 'Gain' stores the scaling factor in vertical direction in the range \
  // from 0 to 1000 (percent).
  $rect <620,90,820,130>
  property int32 Gain = 100;

  // The onset method for the property 'Gain' changes the vertical scaling factor \
  // in the range from 0 to 1000 percent.
  $rect <620,130,820,170>
  onset Gain
  {
    /* limit size of gain to a range from 10 to 1000 */
    if ( value < 0 )
      value = 0;

    if ( value > 1000 )
      value = 1000;

    /* assign the value */
    pure Gain = value;
  }

  // The 'Image' view contains the prepared data bitmap of the oscilloscope.
  $rect <20,20,160,60>
  object Views::Image Image
  {
    preset Bounds = <0,0,48,48>;
  }

  // This is a simple line view.
  $rect <20,20,160,60>
  object Views::Line LineH0
  {
    preset Color = #88888888;
    preset Point2 = <500,0>;
    preset Point1 = <0,0>;
  }

  // This is a simple line view.
  $rect <20,20,160,60>

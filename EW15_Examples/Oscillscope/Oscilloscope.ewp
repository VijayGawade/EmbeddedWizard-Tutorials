$version 15.00

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,70,240,110>
unit Core
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,110,240,150>
unit Resources
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,150,240,190>
unit Graphics
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,190,240,230>
unit Effects
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,230,240,270>
unit Views
{
  attr Directory = $Mosaic;
}

$rect <40,270,240,310>
unit WidgetSet
{
  attr Directory = $Mosaic\;
}

// The 'default' Language. Each project has to contain at least one language brick \
// called 'Default'
$rect <540,70,740,110>
language Default;

// The unit Application contains all necessary classes of this sample project to \
// build the application.
$rect <40,380,240,420>
unit Application
{
  attr Directory = .\;
}

// The unit Res contains all resources of the project.
$rect <40,420,240,460>
unit Res
{
  attr Directory = .\;
}

// Mosaic Framework
note group Note1
{
  attr Bounds = <20,20,260,330>;
}

// Profile Configuration
note group Note2
{
  attr Bounds = <270,20,510,170>;
}

// Languages
note group Note3
{
  attr Bounds = <520,20,760,130>;
}

// Project Units
note group Note5
{
  attr Bounds = <20,340,260,480>;
}

// The sample application 'Oscilloscope' implements the user interface of a classic \
// oscilloscope with a simulated electron beam.
// The user can select the data source and adjust different parameters like speed, \
// gain or the colors of the beam and the grid. Additionally, the behavior of the \
// electron beam can be configured, e.g. the luminance period or the beam intensity \
// can be changed.
// 
// This demo application is implemented for two different screen sizes:
// QVGA with 320x240 pixels and VGA with 640x480 pixels.
// The two different screen sizes are realized by two variants of the application \
// class and by two profiles:
// Win32_VGA and Win32_QVGA 
// 
// You can double-click on the 'Application' brick to open the unit within the Composer \
// and to analyze the implementation.
// 
// To start the application within the Prototyper, select the desired profile in \
// the drop-down list and press 'Ctrl'+'F5'.
note legend Note
{
  attr Bounds = <270,180,760,510>;
}

// How to manage project variants?
// 
// https://doc.embedded-wizard.de/managing-project-variants
note legend Note6
{
  attr Bounds = <270,520,760,590>;
}

// This is the 'default' profile for the new project. This profile will be used for \
// test, prototyping, etc.
$rect <290,70,490,110>
profile Win32_VGA : Windows.Software.RGBA8888
{
  attr ScreenSize = <640,480>;
  attr Optimization = High;
  attr ApplicationClass = Application::Application;
  attr ApplicationTitle = "Embedded Wizard - Osci Demo VGA";
  attr ScreenOrientation = Normal;
  attr FontConversion = Windows;
  attr CleanOutputDirectories = false;
  attr OutputFileNameExtension = c;
  attr Verbose = false;
  attr StorageOfResources = Code;
  attr StorageOfConstants = Code;

  $rect <10,10,154,50>
  macro Author = "Dipl. Ing. Paul Banach and Dipl. Ing. Manfred Schweyer, Copyright (C) TARA Systems GmbH";
}

// This is the 'default' profile for the new project. This profile will be used for \
// test, prototyping, etc.
$rect <290,110,490,150>
profile Win32_QVGA : Windows.Software.RGBA8888
{
  attr ScreenSize = <320,240>;
  attr Optimization = High;
  attr ApplicationClass = Application::Application;
  attr ApplicationTitle = "Embedded Wizard - Osci Demo QVGA";
  attr ScreenOrientation = Normal;
  attr FontConversion = Windows;
  attr CleanOutputDirectories = false;
  attr OutputFileNameExtension = c;
  attr Verbose = false;
  attr StorageOfResources = Code;
  attr StorageOfConstants = Code;

  $rect <10,10,154,50>
  macro Author = "Dipl. Ing. Paul Banach and Dipl. Ing. Manfred Schweyer, Copyright (C) TARA Systems GmbH";
}

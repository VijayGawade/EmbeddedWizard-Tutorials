  // This method is intended to be called by the device to notify the GUI application \
  // about an alternation of its setting or state value.
  $rect <10,510,210,550>
  $output true
  method void UpdateDualSound( arg bool aNewValue )
  {
    // Only if the reported value does differ from the one stored currently in the property.
    if ( aNewValue != pure DualSound )
    {
      // Remember the new value in the internal memory of the property.
      pure DualSound = aNewValue;

      // Notify all associated property observers.
      notifyobservers ^DualSound;
    }
  }

  $rect <210,560,410,600>
  property int32 Language;

  $rect <410,560,610,600>
  onset Language
  {
    // The property doesn't change -> nothing to do.
    if ( pure Language == value )
      return;

    // Remember the new value in the internal memory of the property.
    pure Language = value;

    // Immediatelly update the UI language
    if ( value == 1 ) language = German;
    else              language = Default;

    $if $prototyper
      trace "Change language to", language;
    $endif

    // For target code generation you will use your specific device API 
    // to change the affected value.
    $if !$prototyper
      native ( value )
      {
        /*
           TO DO:

           You can call a function of your own device API or you simply
           modify a variable existing in your middleware to reflect the
           new value:

           YourDevice_SetSomeValue( value );

           or

           YourDevice_SomeVariable = value;
        */
      }
    $endif

    // Notify all associated property observers.
    notifyobservers ^Language;
  }

  // This method is intended to be called by the device to notify the GUI application \
  // about an alternation of its setting or state value.
  $rect <10,560,210,600>
  $output true
  method void UpdateLanguage( arg int32 aNewValue )
  {
    // Only if the reported value does differ from the one stored currently in the property.
    if ( aNewValue != pure Language )
    {
      // Remember the new value in the internal memory of the property.
      pure Language = aNewValue;

      // Immediatelly update the UI language
      if ( aNewValue == 1 ) language = German;
      else                  language = Default;

      // Notify all associated property observers.
      notifyobservers ^Language;
    }
  }

  $rect <630,380,830,420>
  method void ResetSoundSettings()
  {
    $if $prototyper
      trace "Reseting sound settings ...";
    $endif

    Balance         = 50;
    Bass            = 50;
    HeadphoneVolume = 50;
    Treble          = 50;
    VolumeOffset    = 50;
    DualSound       = false;
    Spatial         = false;
  }

  $rect <630,420,830,460>
  method void ResetPictureSettings()
  {
    $if $prototyper
      trace "Reseting picture settings ...";
    $endif

    Brightness = 50;
    Color      = 50;
    Contrast   = 50;
    Scroll     = 50;
    Sharpness  = 50;
    Auto16_9   = true;
  }

  $rect <210,600,410,640>
  property bool SleepTimer = false;

  $rect <410,600,610,640>
  onset SleepTimer
  {
    // The property doesn't change -> nothing to do.
    if ( pure SleepTimer == value )
      return;

    // Remember the new value in the internal memory of the property.
    pure SleepTimer = value;

    $if $prototyper
      trace "Change sleep timer mode to", value;
    $endif

    // For target code generation you will use your specific device API 
    // to change the affected value.
    $if !$prototyper
      native ( value )
      {
        /*
           TO DO:

           You can call a function of your own device API or you simply
           modify a variable existing in your middleware to reflect the
           new value:

           YourDevice_SetSomeValue( value );

           or

           YourDevice_SomeVariable = value;
        */
      }
    $endif

    // Notify all associated property observers.
    notifyobservers ^SleepTimer;
  }

  // This method is intended to be called by the device to notify the GUI application \
  // about an alternation of its setting or state value.
  $rect <10,600,210,640>
  $output true
  method void UpdateSleepTimer( arg bool aNewValue )
  {
    // Only if the reported value does differ from the one stored currently in the property.
    if ( aNewValue != pure SleepTimer )
    {
      // Remember the new value in the internal memory of the property.
      pure SleepTimer = aNewValue;

      // Notify all associated property observers.
      notifyobservers ^SleepTimer;
    }
  }
}


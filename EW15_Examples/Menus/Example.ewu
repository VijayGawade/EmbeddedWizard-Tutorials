$rect <60,190,240,230>
$output false
class SoundMenu : Example::Menu
{
  $rect <10,490,210,530>
  inherited property Bounds = <0,0,410,469>;

  $rect <430,100,630,140>
  inherited property Icon = Example::Sound;

  $rect <430,60,630,100>
  inherited property Caption = Example::SM_Caption;

  $rect <430,290,630,330>
  slot onResetAlertCancel
  {
    // From the sending button get the alert component
    var Core::Group button = (Core::Group)sender;
    var Core::Group alert  = button? button.Owner : null;

    // In order to avoid race condition verify whether the alert is actually
    // the top most dialog.
    if ( !alert || !alert.IsCurrentDialog())
      return;

    // Dismiss the alert now
    GetRoot().DismissDialog( alert, null, null, null, null, null, false );
  }

  $rect <430,250,630,290>
  slot onResetAlertReset
  {
    // From the sending button get the alert component
    var Core::Group button = (Core::Group)sender;
    var Core::Group alert  = button? button.Owner : null;

    // In order to avoid race condition verify whether the alert is actually
    // the top most dialog.
    if ( !alert || !alert.IsCurrentDialog())
      return;

    // Dismiss the alert now
    GetRoot().DismissDialog( alert, null, null, null, null, null, false );

    // Reset the sound settings ....
    Example::Device.ResetSoundSettings();
  }

  $rect <430,210,630,250>
  slot openResetAlert
  {
    // In order to avoid race condition verify whether the menu is actually
    // the top most dialog.
    if ( !IsCurrentDialog())
      return;

    // Create a new alert component
    var Example::Alert alert = new Example::Alert;

    // Initialize the alert
    alert.Caption      = Example::SM_Caption;
    alert.Message      = Example::SM_ResetMessage;
    alert.Button1Label = Example::AL_ResetButton;
    alert.Button2Label = Example::AL_CancelButton;
    alert.OnButton1    = onResetAlertReset;
    alert.OnButton2    = onResetAlertCancel;

    // ... and present it
    GetRoot().PresentDialog( alert, null, null, null, null, null, null, null, null, false );
  }

  $rect <20,20,160,60>
  object Example::SliderItem SliderItem1
  {
    preset Bounds = <10,54,392,94>;
    preset Outlet = ^Example::Device.Treble;
    preset Icon = Example::Treble;
    preset Caption = Example::SM_Treble;
  }

  $rect <20,20,160,60>
  object Example::SliderItem SliderItem2
  {
    preset Bounds = <11,94,393,134>;
    preset Outlet = ^Example::Device.Bass;
    preset Icon = Example::Base;
    preset Caption = Example::SM_Bass;
  }

  $rect <20,20,160,60>
  object Example::SliderItem SliderItem3
  {
    preset Bounds = <10,134,392,174>;
    preset Outlet = ^Example::Device.Balance;
    preset Icon = Example::Balance;
    preset Caption = Example::SM_Balance;
  }

  $rect <20,20,160,60>
  object Example::MenuItem MenuItem1
  {
    preset Bounds = <11,174,393,214>;
    preset OnActivate = openResetAlert;
    preset Icon = Example::Reset;
    preset Caption = Example::SM_Reset;
  }

  $rect <20,20,160,60>
  object Example::ToggleItem SwitchItem1
  {
    preset Bounds = <11,214,393,254>;
    preset Outlet = ^Example::Device.Spatial;
    preset Icon = Example::Spatial;
    preset Caption = Example::SM_Spatial;
  }

  $rect <20,20,160,60>
  object Example::ToggleItem SwitchItem2
  {
    preset Bounds = <9,254,391,294>;
    preset Outlet = ^Example::Device.DualSound;
    preset Icon = Example::Dual;
    preset Caption = Example::SM_DualSound;
  }

  $rect <20,20,160,60>
  object Example::SliderItem SliderItem4
  {
    preset Bounds = <11,294,393,334>;
    preset Outlet = ^Example::Device.VolumeOffset;
    preset Icon = Example::Volume;
    preset Caption = Example::SM_VolumeOffset;
  }

  $rect <20,20,160,60>
  object Example::SliderItem SliderItem5
  {
    preset Bounds = <13,334,395,374>;
    preset Outlet = ^Example::Device.HeadphoneVolume;
    preset Icon = Example::Headphone;
    preset Caption = Example::SM_HeadphoneVolume;
  }

  $rect <20,20,160,60>
  object Example::ToggleItem SwitchItem3
  {
    preset Bounds = <14,374,396,414>;
    preset Outlet = ^Example::Device.DualSound;
    preset Icon = Example::HeadphoneDual;
    preset Caption = Example::SM_HeadphoneDualSound;
  }

  $rect <20,20,160,60>

// This is the root component of the entire GUI application.
$rect <30,50,210,90>
$output false
class Application : Core::Root
{
  $rect <20,620,210,660>
  inherited property Bounds = <0,0,800,600>;

  // The variable maintains the controller object alive durring the entire runtime. \
  // Without the variable, the controller will be deinitialized if it is not used.
  $rect <20,660,210,700>
  $output true
  var Example::DeviceClass debviceObject = Example::Device;

  $rect <820,520,1010,560>
  slot openMainMenu
  {
    // In order to avoid race conditions ignore the push button events if there
    // is already a menu presented
    if ( FindCurrentDialog())
      return;

    // Create a new instance of the menu component
    var Example::TopMenu menu = new Example::TopMenu;

    // ... and present it by using a fade-in transition
    PresentDialog( menu, Effects::FadeInOutCentered, null, null, null, null, null, null, null, false );

    // Also hide the help text message
    Text.Visible        = false;
    ColorEffect.Enabled = false;
  }

  // This is a pulse color effect.
  $rect <230,660,420,700>
  object Effects::ColorEffect ColorEffect
  {
    preset Symmetric = true;
    preset Timing = Effects::Timing.EaseIn_EaseOut;
    preset CycleDuration = 4000;
    preset Enabled = true;
    preset Value2 = #4BB613FF;
    preset Value1 = #000000FF;
    preset Outlet = ^Text.Color;
  }

  $rect <20,20,160,60>
  object Views::Rectangle Background
  {
    preset Bounds = <0,0,800,600>;
    preset Color = #EEEEEEFF;
  }

  $rect <20,20,160,60>
  object WidgetSet::PushButton Button
  {
    preset Bounds = <614,500,780,576>;
    preset OnActivate = openMainMenu;
    preset Label = "Menu";
    preset Appearance = WidgetSet::PushButton_Lime_Medium;
  }

  $rect <20,20,160,60>
  object Views::Text Text
  {
    preset Bounds = <210,235,590,365>;
    preset WrapText = true;
    preset String = "Press the key 'OK' ('Enter' on PC) or click on the button 'Menu' in the bottom-right corner.";
    preset Font = Resources::FontMedium;
    preset Color = #000000FF;
  }

  $rect <20,20,160,60>
  object Views::Image EmWiLogo
  {
    preset Bounds = <10,511,190,576>;
    preset Bitmap = Example::LogoOfEmWi;
  }
}

// This example application implements a menu system and an interface to some (imaginary) \
// device. 
// 
// - On the right you see diverse components. These implement the common functionality \
// of the menu system. We created the components by using templates from the Gallery \
// folder 'Component Templates'. For example, the component 'Menu' has been created \
// by using the 'Menu' template. The templates are very simple and without any sophisticated \
// look&feel. Thus we had to adapt the components after creating them from the provided \
// templates.
// 
// - The bricks in the center implement the interface to the device. In our example, \
// the interface limits to display 'trace' messages only. In the practice, you can \
// edit the methods found in the 'DeviceClass' and e.g. adapt it to communicate with \
// a real device. To create this interface we used the templates from the Gallery \
// folder 'Device':
// 
// - On the left are found concrete menu implementations. These are classes descending \
// from the 'Menu' class. Thus all menus inherite the common functionality implemented \
// in the 'Menu' class. The 'Application' class represents the entire application.
// 
// To start the application within the Prototyper, press 'Ctrl'+'F5'.
note legend Note6
{
  attr Bounds = <10,390,930,680>;
}

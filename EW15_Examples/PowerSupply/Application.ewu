// This is the root component of the entire GUI application.
$rect <30,60,230,100>
$output false
$multilingual true
class Application : Core::Root
{
  $rect <510,400,710,440>
  inherited property Bounds = <0,0,640,384>;

  // This variable stores the currently opened settings menu. It is 'null' if no \
  // menu is visible.
  $rect <270,520,470,560>
  var Application::Menu menu = null;

  // This variable refers to the device object of the power supply device. This is \
  // the interface between the GUI application and the real device. This variable \
  // is used to keep the device object within the memory and to prevent it from beeing \
  // disposed by the Garbage Collector.
  $rect <510,440,710,480>
  var Application::PowerSupplyClass powerSupplyDevice = Application::PowerSupply;

  // This slot method is connected to the ButtonSettings button. When the user has \
  // pressed the button, the method shows a settings menu.
  $rect <270,440,470,480>
  slot onShowMenu
  {
    // Create a new menu instance
    menu = new Application::Menu;

    // Ensure, the menu appears in the center of the screen
    menu.MoveView( Bounds.orect.center - menu.Bounds.center, false );

    // Connect the onExitMenu slot method to the menu. This method is
    // invoked, when the user has decided to close the menu.
    menu.OnExitMenu = onExitMenu;

    // Make the menu visible and modal. Modal GUI components grab all 
    // user inputs.
    Add( menu, 0 );
    BeginModal( menu );
  }

  // This slot method is invoked, when the user has decided to close the settings \
  // menu.
  $rect <270,480,470,520>
  slot onExitMenu
  {
    // Finish the modal (exclusive) state of the menu and hide it
    EndModal( menu );
    Remove( menu );

    // Now, no menu is visible
    menu = null;
  }

  // This slot method is connected to the KeyHandler. It will be invoked, when the \
  // user has pressed the Left/Right/Up/Down keys.
  $rect <20,480,220,520>
  slot onKeyPressSlot
  {
    var Core::Direction direction = Core::Direction.None;
    var Core::View      view;

    // Depending on the pressed key, determine the direction to look for
    // other widgets.
    switch ( KeyHandler.Code )
    {
      case Core::KeyCode.Left  : direction = Core::Direction.Left;
      case Core::KeyCode.Right : direction = Core::Direction.Right;
      case Core::KeyCode.Up    : direction = Core::Direction.Top;
      case Core::KeyCode.Down  : direction = Core::Direction.Bottom;
      default :;
    }

    // Try to find another widget in the given direction relative to the
    // currently selected (Focus) widget. Search for widgets able to handle
    // keyboard inputs only (Enabled and Focusable).
    view = FindViewInDirection( Focus, direction, 
                                Core::ViewState[ Enabled, Focusable ]);

    // Item found? Select this widget then.
    if ( view != null )
      Focus = view;
  }

  // This is a key press handler. It responds to the Up/Down/Left/Right key events \
  // and passes them to the onPressKey slot method.
  $rect <20,440,220,480>
  object Core::KeyPressHandler KeyHandler
  {
    preset OnPress = onKeyPressSlot;
    preset Filter = Core::KeyCode.CursorKeys;
    preset OnHold = onKeyPressSlot;
  }

  $rect <20,20,160,60>
  object SteelWidgets::Background Background
  {
    preset Bounds = <0,0,640,384>;
  }

  $rect <20,20,160,60>
  object Views::Text LabelVoltage
  {
    preset Bounds = <214,279,334,309>;
    preset String = Application::VoltageText;
    preset Font = Resources::FontMedium;
    preset Color = #B7B7B7FF;
  }

  $rect <20,20,160,60>
  object Views::Text LabelCurrent
  {
    preset Bounds = <446,279,566,309>;
    preset String = Application::CurrentText;
    preset Font = Resources::FontMedium;
    preset Color = #B7B7B7FF;
  }

  $rect <20,20,160,60>
  object Views::Text LabelSettings
  {
    preset Bounds = <26,278,155,308>;
    preset String = Application::SettingsText;
    preset Font = Resources::FontMedium;
    preset Color = #B7B7B7FF;
  }

  $rect <20,20,160,60>
  object Views::Text LabelPower
  {
    preset Bounds = <26,156,155,186>;
    preset String = "Power";
    preset Font = Resources::FontMedium;
    preset Color = #B7B7B7FF;
  }

  $rect <20,20,160,60>
  object Views::Image ImageEmWiLogo
  {
    preset Bounds = <20,330,200,370>;
    preset Alignment = Views::ImageAlignment[AlignHorzLeft, AlignVertCenter];
    preset Bitmap = Application::LogoOfEmWi;
    preset Opacity = 128;
  }

  $rect <20,20,160,60>
  object WidgetSet::Gauge GaugeVoltage
  {
    preset Bounds = <190,48,362,170>;
    preset Outlet = ^Application::PowerSupply.MeasuredVoltage;
    preset MaxValue = 15000;
    preset Appearance = SteelWidgets::GaugeVoltageConfig;
  }

  $rect <20,20,160,60>
  object WidgetSet::Gauge GaugeCurrent
  {
    preset Bounds = <420,48,592,170>;
    preset Outlet = ^Application::PowerSupply.MeasuredCurrent;
    preset MaxValue = 5000;
    preset Appearance = SteelWidgets::GaugeCurrentConfig;
  }

  $rect <20,20,160,60>
  object WidgetSet::ToggleButton SwitchPower
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToTop];
    preset Bounds = <46,107,136,157>;
    preset Outlet = ^Application::PowerSupply.SwitchedOn;
    preset Appearance = SteelWidgets::SwitchConfig;
  }

  $rect <20,20,160,60>
  object WidgetSet::RotaryKnob RotaryKnobVoltage
  {
    preset Bounds = <224,192,324,292>;
    preset Outlet = ^Application::PowerSupply.Voltage;

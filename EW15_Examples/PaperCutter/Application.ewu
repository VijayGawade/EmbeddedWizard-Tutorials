$version 15.00

// This is the root component of the entire GUI application.
$rect <40,40,240,80>
$output false
class Application : Core::Root
{
  $rect <820,60,1020,100>
  inherited property Bounds = <0,0,800,480>;

  $rect <820,10,1020,50>
  inherited method Init()
  {
    /* just adjust the applications bounds... */
    Bounds.size = $ScreenSize;
    Cutter.Bounds = rect( 0, 0, $ScreenSize.x, $ScreenSize.y );
  }

  $rect <20,20,160,60>
  object Cutter::Cutter Cutter
  {
    preset Bounds = <0,0,800,480>;
  }
}

// Application class of the example
note group Note4
{
  attr Bounds = <20,0,660,100>;
}

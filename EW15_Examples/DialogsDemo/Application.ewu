$rect <20,360,220,400>
$output false
class Application : Core::Root
{
  $rect <330,70,530,110>
  inherited property Bounds = <0,0,300,450>;

  $rect <330,30,530,70>
  inherited method Init()
  {
    // Just in the moment when application is started present the main Dialog.
    PresentDialog( new Application::MainDialog, null, null, null, null, null, null, null, null, false );
  }

  $rect <20,20,160,60>
  object Views::Rectangle Rectangle
  {
    preset Bounds = <0,0,300,450>;
    preset Color = #E8E8E8FF;
  }

  // This example demonstrates how to create applications consisting of several Dialogs.
  // 
  // Just press the key F5 to start the Prototyper and play with application. Every \
  // time you activate a button, a new Dialog appears or the actually visible Dialog \
  // is dismissed again.
  // 
  // Every transition between the Dialogs is performed with an animation.
  note legend Note
  {
    attr Bounds = <330,170,860,340>;
  }
}

$rect <20,310,220,350>
$output false
class MainDialog : Core::Group
{
  $rect <10,480,210,520>
  inherited property Bounds = <0,0,300,450>;

  $rect <10,520,210,560>
  inherited property Focus = null;

  $rect <330,60,530,100>
  slot onNext
  {
    // Present a new Tab-Dialog
    if ( IsActiveDialog( true ))
      GetRoot().PresentDialog( new Application::TabDialog, Application::SlideLeftCentered, Application::SlideRightCentered, null, null, Application::SlideLeftCentered, Application::SlideRightCentered, null, null, false );
  }

  $rect <330,380,530,420>
  slot onShowAlert
  {
    // Present a new alert Dialog together with the scrim Dialog lying behind it
    if ( IsActiveDialog( true ))
    {
      GetRoot().PresentDialog( new Application::Scrim, Application::FadeInOutScrim, null, null, null, null, null, null, null, false );
      GetRoot().PresentDialog( new Application::Alert, Application::FadeInAlert, Application::FadeOutAlert, null, null, null, null, null, null, true );
    }
  }

  $rect <330,20,530,60>
  slot onInfo
  {
    // Present a new Dialog together with the scrim Dialog lying behind it
    if ( IsActiveDialog( true ))
    {
      GetRoot().PresentDialog( new Application::Scrim, Application::FadeInOutScrim, null, null, null, null, null, null, null, false );
      GetRoot().PresentDialog( new Application::Popup, Application::SlideInPopup, Application::SlideOutPopup, null, null, null, null, null, null, true );
    }
  }

  $rect <20,20,160,60>
  object Views::Rectangle Rectangle
  {
    preset Bounds = <0,0,300,450>;
    preset Color = #E8E8E8FF;
  }

  $rect <20,20,160,60>
  object Application::LabelButton ButtonInfo
  {
    preset Bounds = <0,0,120,50>;
    preset OnActivate = onInfo;
    preset Label = "INFO";
  }

  $rect <20,20,160,60>
  object Application::LabelButton ButtonNext
  {
    preset Bounds = <180,0,300,50>;
    preset OnActivate = onNext;
    preset Label = "NEXT";
  }

  $rect <20,20,160,60>
  object Application::LabelButton ButtonShowAlert
  {
    preset Bounds = <30,380,270,430>;
    preset OnActivate = onShowAlert;
    preset Label = "Show alert ...";
  }

  $rect <20,20,160,60>
  object Core::SlideTouchHandler SlideTouchHandler
  {
    preset Bounds = <10,85,290,345>;
    preset SnapNext = <0,32>;
    preset SlideHorz = false;
  }

  $rect <20,20,160,60>
  object Views::Text Text
  {
    preset Bounds = <10,85,290,345>;
    preset SlideHandler = SlideTouchHandler;
    preset WrapText = true;
    preset Alignment = Views::TextAlignment[AlignHorzCenter, AlignVertTop];
    preset String = "Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est. Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est.";
    preset Font = Application::Font;
    preset Color = #5C5C5CFF;
  }

  // This component implements a kind of 'main' Dialog. This Dialog appears as the \
  // first one, when the application is started.
  // 
  // From this Dialog the user can present other Dialogs:
  // 
  // - If the user activates the button 'Info', an Info-Dialog apears overlying this \
  // Dialog.
  // 
  // - If the user activates the button 'Next', a new Dialog is presented replacing \
  // the actual one.
  // 
  // - If the user presses the button 'Show alert ...' an alert Dialog is shown overlying \
  // this Dialog.
  note legend Note
  {
    attr Bounds = <330,130,850,350>;
  }
}

$rect <220,230,420,270>
$output false
class Scrim : Core::Group
{
  $rect <10,480,210,520>
  inherited property Bounds = <0,0,300,450>;

  $rect <20,20,160,60>
  object Views::Rectangle Rectangle
  {
    preset Bounds = <0,0,300,450>;
    preset Color = #00000081;
  }

  // This component implements a Dialog intended to serve as 'scrim' behind another \
  // Dialog.
  // 
  // Except to darkened and blurring the background, it has no particular functionality.
  note legend Note
  {
    attr Bounds = <340,10,760,120>;
  }

  $rect <20,20,160,60>
  object Views::FilterScreen FilterScreen
  {
    preset Bounds = <0,0,300,450>;
    preset BlurClampToEdges = true;
    preset BlurRadius = 5;
  }

  // Directives to adapt the order of the above members according to how these members 
  // where arranged when the project content was stored. In this manner the storage 
  // and the expected order of the members don't depend. Merging of changes in the 
  // project files is simplified.
  $member Bounds
  $member Rectangle
  $member FilterScreen
  $member Note
}

$rect <20,250,220,290>
$output false
class Popup : Core::Group
{
  $rect <330,200,530,240>
  inherited property Bounds = <0,0,300,450>;

  $rect <330,260,530,300>
  slot onOk
  {
    // Dismiss the Dialog together with the scrim Dialog lying behind it
    if ( IsDialog( false ))
    {
      GetRoot().DismissDialog( this, null, null, null, null, null, false );
      GetRoot().DismissDialog( GetRoot().FindActiveDialogByClass( Application::Scrim ), null, null, null, null, null, true );
    }
  }

  $rect <20,20,160,60>
  object Views::Rectangle Rectangle
  {
    preset Bounds = <10,200,290,440>;
    preset Color = #6D99B4C5;
  }

  $rect <20,20,160,60>
  object Views::Border Border
  {
    preset Bounds = <10,200,290,440>;
    preset Width = 3;
    preset Color = #F5FFF7FF;
  }

  $rect <20,20,160,60>
  object Application::LabelButton LabelButton
  {
    preset Bounds = <70,370,230,420>;
    preset OnActivate = onOk;
    preset Label = "Ok";
  }

  $rect <20,20,160,60>
  object Views::Text Text
  {
    preset Bounds = <20,210,280,360>;
    preset WrapText = true;
    preset String = "Lorem ipsum dolor sit amet ...";
    preset Font = Application::Font;
    preset Color = #F0F0F0FF;
  }

  // This component implements a simple 'Info' Dialog.
  // 
  // For the sake of simplicity, the displayed message is fixed defined.
  // 
  // When the user activates the button, the Dialog is dimissed again.
  note legend Note
  {
    attr Bounds = <330,340,750,440>;
  }
}


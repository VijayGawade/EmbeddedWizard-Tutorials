// The UI component shows a spinning watch.
$rect <240,90,440,130>
$output false
class SpinningWatch : Core::Group
{
  $rect <0,620,200,660>
  inherited property Bounds = <0, 0, 800,600>;

  $rect <0,810,200,850>
  inherited method UpdateLayout()
  {
    aSize;

    // Update the arrangement if screen size is changed
    postsignal AnimationTimerSlot;
  }

  $rect <0,660,200,700>
  inherited property Focus = BackButton;

  $rect <0,710,200,750>
  var float Angle;

  // This slot method is invoked durring the animation. It calculates the next position \
  // of the spinning watch.
  $rect <210,710,410,750>
  slot AnimationTimerSlot
  {
    // Get the next rotation angle
    Angle = Angle + 0.8;

    var float                scale   = float( Bounds.w ) / 800.0;
    var point                dstPos1 = point( Bounds.orect.center.x, int32( 170.0 * scale ));
    var point                dstPos2 = point( Bounds.orect.center.x, int32( 550.0 * scale ));
    var Graphics::WarpMatrix matrix  = new Graphics::WarpMatrix;

    matrix.EyeDistance = 308.0 * scale;
    matrix.Scale( scale, scale, scale );

    // Rotate the clock
    matrix.Push();
    matrix.Rotate( Angle * 0.9, Angle, Angle );
    Image.Warp3D( dstPos1, matrix );
    matrix.Pop();

    // ... and its mirror image
    matrix.Rotate( 180.0 - Angle * 0.9, Angle, -Angle );
    Mirror.Warp3D( dstPos2, matrix );
  }

  $rect <210,750,410,790>
  object Core::Timer AnimationTimer
  {
    preset OnTrigger = AnimationTimerSlot;
    preset Period = 16;
    preset Enabled = true;
  }

  $rect <210,660,410,700>
  onset OnBack
  {
    pure OnBack = value;
    BackButton.OnActivate = value;
  }

  $rect <20,20,160,60>
  object Views::WarpGroup Image
  {
    preset Layout = Core::Layout[];
    preset Point4 = <250,320>;
    preset Point3 = <550,320>;
    preset Point2 = <550,20>;
    preset Point1 = <250,20>;
    preset LightingEffect = 0.6;
    preset SourceAnchor = <150,150>;
    preset Group = Watch::WatchBerlin;
  }

  $rect <20,20,160,60>
  object Views::WarpGroup Mirror
  {
    preset Layout = Core::Layout[];
    preset Point4 = <250,400>;
    preset Point3 = <550,400>;
    preset Point2 = <550,700>;
    preset Point1 = <250,700>;
    preset Quality = false;
    preset SourceAnchor = <150,150>;
    preset Opacity = 50;
    preset Group = Watch::WatchBerlin;
  }

  $rect <20,20,160,60>
  object Application::MenuButton BackButton
  {
    preset Layout = Core::Layout[AlignToBottom, AlignToRight, ResizeHorz, ResizeVert];
    preset Bounds = <720,520,790,590>;
    preset Face = Application::BackItem;
  }

  // The property 'OnBack' can be connected with a slot method. As soon as the user \
  // has activated the back button, the attached slot method is invoked.
  $rect <210,620,410,660>
  property slot OnBack = null;
}


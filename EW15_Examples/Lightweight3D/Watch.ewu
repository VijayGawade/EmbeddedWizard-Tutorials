  // The property 'Mirroring' determines whether the mirror images should be shown \
  // or not.
  $rect <210,630,410,670>
  property bool Mirroring = false;

  // The property 'OnBack' can be connected with a slot method. As soon as the user \
  // has activated the back button, the attached slot method is invoked.
  $rect <410,630,610,670>

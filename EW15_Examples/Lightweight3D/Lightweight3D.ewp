$version 15.00

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,70,240,110>
unit Core
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,110,240,150>
unit Resources
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,150,240,190>
unit Graphics
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,190,240,230>
unit Effects
{
  attr Directory = $Mosaic;
}

// The 'default' Language. Each project has to contain at least one language brick \
// called 'Default'
$rect <540,70,740,110>
language Default;

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,230,240,270>
unit Views
{
  attr Directory = $Mosaic;
}

$rect <40,270,240,310>
unit WidgetSet
{
  attr Directory = $Mosaic\;
}

$rect <40,390,240,430>
unit Application
{
  attr Directory = .\;
}

// This unit contains resources and the 'ImageFlow' UI component
$rect <40,430,240,470>
unit ImageFlow
{
  attr Directory = .\;
}

// This unit contains resources and 'Watch' UI components
$rect <40,470,240,510>
unit Watch
{
  attr Directory = .\;
}

// Mosaic Framework
note group Note1
{
  attr Bounds = <20,20,260,330>;
}

// Profile Configuration
note group Note2
{
  attr Bounds = <270,20,510,130>;
}

// Languages
note group Note3
{
  attr Bounds = <520,20,760,130>;
}

// Project Units
note group Note4
{
  attr Bounds = <20,340,260,530>;
}

// This is the project of the UI application example 'Lightweight3D'.
// 
// This application contains an attractive image flow demo, a rotating clock, a world \
// clock carousel and a menu with mirror effects.
// This demo presents the 'lightweight3D' approach of Embedded Wizard.
//                                                                   
// You can double-click on the 'Application' brick to open the unit within the Composer \
// and to analyze the implementation.
// 
// To start the application within the Prototyper, press 'Ctrl'+'F5'.
note legend Note5
{
  attr Bounds = <270,140,760,400>;
}

// How to use Warp Image and Warp Group?
// https://doc.embedded-wizard.de/warp-image-view
// https://doc.embedded-wizard.de/warp-group-view
note legend Note
{
  attr Bounds = <270,410,760,530>;
}

// This is the 'default' profile for the new project. This profile will be used for \
// test, prototyping, etc.
$rect <290,70,490,110>
profile Win32 : Windows.Software.RGBA8888
{
  attr Verbose = false;
  attr ScreenSize = <800,600>;
  attr Optimization = High;
  attr ApplicationClass = Application::Application;
  attr ApplicationTitle = "Embedded Wizard - Lightweight3D Demo";
  attr CleanOutputDirectories = false;
  attr ScreenOrientation = Normal;
  attr FontConversion = Windows;
  attr OutputFileNameExtension = c;
  attr StorageOfResources = Code;
  attr StorageOfConstants = Code;

  $rect <10,10,154,50>
  macro Author = "Dipl. Ing. Paul Banach and Dipl. Ing. Manfred Schweyer, Copyright (C) TARA Systems GmbH";
}

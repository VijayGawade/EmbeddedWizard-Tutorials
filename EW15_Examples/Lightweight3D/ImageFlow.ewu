  // The property 'Mirroring' determines whether the mirror images should be shown \
  // or not.
  $rect <200,630,390,670>
  property bool Mirroring = false;

  // The property 'OnBack' can be connected with a slot method. As soon as the user \
  // has activated the back button, the attached slot method is invoked.
  $rect <390,630,580,670>
  property slot OnBack = null;

  // The property 'DataAdapter' is intended to refer to the data source, which provides \
  // the image flow with images.
  $rect <580,630,770,670>
  property ImageFlow::DataAdapter DataAdapter = null;

  // This is a variable.
  $rect <390,750,580,790>
  var bool repeat;
}

// Font resource used to display the image caption in the image flow
$rect <240,270,440,310>
$output false
resource Resources::Font CaptionFont
{
  attr fontname FontName = Verdana;
  attr fontheight Height = 40;
  attr fontquality Quality = High;
  attr fontranges Ranges = 0x20-0xFF;
  attr fontaspectratio AspectRatio = 1.0;
  attr fontbold Bold = false;
  attr fontitalic Italic = false;
  attr fontkerning Kerning = true;
  attr fontheightmode HeightMode = Compatible;
  attr fontrowdistance RowDistance;
}

// This class implements an abstraction of a 'data source', which is able to provide \
// the image flow UI component with images.
$rect <30,160,230,200>
$output false
class DataAdapter
{
  // The method MoveCursor() adapts the internal cursor position of the data source. \
  // The cursor is moved by the given offset.
  $rect <10,10,210,50>
  method void MoveCursor( arg int32 aOffset )
  {
    Cursor = ( aOffset + Cursor + 10 ) % 10;
  }

  // The method GetImage() returns the image at the given offset position relative \
  // to the current cursor position of the data source.
  $rect <10,50,210,90>
  method Resources::Bitmap GetImage( arg int32 aOffset )
  {
    var int32 index = ( aOffset + Cursor + 10 ) % 10;

    switch ( index )
    {
      case 0  : return ImageFlow::Pic1;
      case 1  : return ImageFlow::Pic2;
      case 2  : return ImageFlow::Pic3;
      case 3  : return ImageFlow::Pic4;
      case 4  : return ImageFlow::Pic5;
      case 5  : return ImageFlow::Pic6;
      case 6  : return ImageFlow::Pic7;
      case 7  : return ImageFlow::Pic8;
      case 8  : return ImageFlow::Pic9;
      case 9  : return ImageFlow::Pic10;
      default : return null;
    }

  }

  // The method GetCaption() returns the caption of the image at the given offset \
  // position relative to the current cursor position of the data source.
  $rect <10,90,210,130>
  method string GetCaption( arg int32 aOffset )
  {
    var int32 index = ( aOffset + Cursor + 10 ) % 10;

    switch ( index )
    {
      case 0  : return "Mediterranean Sea";
      case 1  : return "Kitty";
      case 2  : return "Mediterranean Sea";
      case 3  : return "The Cyclades";
      case 4  : return "Olive tree";
      case 5  : return "Treetop";
      case 6  : return "Mediterranean Sea";
      case 7  : return "Old Town";
      case 8  : return "Sea view";
      case 9  : return "Dewdrops";
      default : return "";
    }

  }

  // The cursor stores the current position in the data source.
  $rect <230,10,430,50>
  var int32 Cursor = 0;
}

// A global instance of the data source containing all the images to display in the \
// image flow UI component.
$rect <240,160,440,200>
$output false
autoobject ImageFlow::DataAdapter BuildInDataAdapter;

// Resources
note group Note
{
  attr Bounds = <10,230,460,690>;
}

// Image Provider
note group Note1
{
  attr Bounds = <10,120,460,220>;
}

// Image Flow Component
note group Note2
{
  attr Bounds = <10,10,460,110>;
}

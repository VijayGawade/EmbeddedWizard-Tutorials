$version 15.00

// This is the main application component
$rect <30,50,230,90>
class Application : Core::Root
{
  $rect <10,630,210,670>
  inherited property Bounds = <0,0,800,600>;

  // THis slot method is connected to the menu. It is invoked when the user has activated \
  // the corresponding menu button
  $rect <210,630,410,670>
  slot StartImageFlow
  {
    // Create a new instance of an image flow
    var ImageFlow::ImageFlow tmp = new ImageFlow::ImageFlow;

    // ... initialize it
    tmp.Bounds.size = Bounds.size;
    tmp.DataAdapter = ImageFlow::BuildInDataAdapter;
    tmp.Mirroring   = true;
    tmp.OnBack      = BackToMenuSlot;

    // ... and make it visible
    Add( tmp, 0 );
    Focus = tmp;

    // Durring the image flow is visible -> the menu may not react to user
    // inputs
    Menu.Enabled = false;
  }

  // THis slot method is connected to the menu. It is invoked when the user has activated \
  // the corresponding menu button
  $rect <210,670,410,710>
  slot StartWatchCarousel
  {
    // Create a new instance of a watch carousel
    var Watch::WatchCarousel tmp = new Watch::WatchCarousel;

    // ... initialize it
    tmp.Bounds.size = Bounds.size;
    tmp.Mirroring   = true;
    tmp.OnBack      = BackToMenuSlot;

    // ... and make it visible 
    Add( tmp, 0 );
    Focus = tmp;

    // Durring the watch carousel is visible -> the menu may not react to user
    // inputs
    Menu.Enabled = false;
  }

  // THis slot method is connected to the menu. It is invoked when the user has activated \
  // the corresponding menu button
  $rect <210,710,410,750>
  slot StartSpinningWatch
  {
    // Create a new instance of a spinning watch
    var Watch::SpinningWatch tmp = new Watch::SpinningWatch;

    // ... initialize it
    tmp.Bounds.size = Bounds.size;
    tmp.OnBack      = BackToMenuSlot;

    // ... and make it visible
    Add( tmp, 0 );
    Focus = tmp;

    // Durring the spinning watch is visible -> the menu may not react to user
    // inputs
    Menu.Enabled = false;
  }

  // This method is invoked when the user has activated the 'back' button in the \
  // running example.
  $rect <400,630,600,670>
  slot BackToMenuSlot
  {
    // Hide and close the current example application
    Remove( Focus );

    // Make the main menu visible again - it should also react to user inputs
    Menu.Visible = true;
    Menu.Enabled = true;
  }

  $rect <20,20,160,60>
  object Views::Rectangle Background
  {
    preset Layout = Core::Layout[AlignToBottom, AlignToLeft, AlignToRight, AlignToTop, ResizeHorz, ResizeVert];
    preset Bounds = <0,0,800,600>;
    preset Color = #000000FF;
  }

  $rect <20,20,160,60>
  object Application::Menu Menu
  {
    preset Layout = Core::Layout[AlignToBottom, AlignToLeft, AlignToRight, AlignToTop, ResizeHorz, ResizeVert];
    preset Bounds = <0,0,800,600>;
    preset OnItem1 = StartImageFlow;
    preset OnItem2 = StartWatchCarousel;
    preset OnItem3 = StartSpinningWatch;
  }

  $rect <20,20,160,60>
  object Views::Image LogoImage
  {
    preset Layout = Core::Layout[AlignToBottom, AlignToLeft, ResizeHorz, ResizeVert];
    preset Bounds = <0,510,170,597>;
    preset Alignment = Views::ImageAlignment[AlignHorzCenter, AlignVertCenter];
    preset Bitmap = Application::EmWiLogo;
  }
}

// Resource containing images for the menu
$rect <30,310,230,350>
$output false
resource Resources::Bitmap Item1Icon
{
  attr bitmapfile FileName = .\MenuRes\Item1.png;
  attr framesize FrameSize = <300,230>;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}

// Resource containing images for the menu
$rect <30,350,230,390>
$output false
resource Resources::Bitmap Item2Icon
{
  attr bitmapfile FileName = .\MenuRes\Item2.png;
  attr framesize FrameSize = <300,230>;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}

// Resource containing images for the menu
$rect <30,390,230,430>
$output false
resource Resources::Bitmap Item3Icon
{
  attr bitmapfile FileName = .\MenuRes\Item3.png;
  attr framesize FrameSize = <300,230>;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}

// This UI component implements the menu to select the animation
$rect <240,200,440,240>
$output false
class Menu : Core::Group
{
  $rect <10,620,150,660>
  inherited property Bounds = <0,0,800,600>;

  $rect <10,660,150,700>
  inherited property Focus = Item1;

  $rect <200,820,390,860>
  var Views::WarpGroup fadeOutView;

  // The effect drives the fade-out animation after the user has activated one of \
  // the menu buttons. The effect invokes the methods @onAnimate and @onFinished.
  $rect <10,860,200,900>
  object Effects::FloatEffect fadeOutEffect
  {
    preset OnFinished = onFinished;
    preset OnAnimate = onAnimate;
    preset NoOfCycles = 1;
    preset Timing = Effects::Timing.FastIn_EaseOut;
    preset CycleDuration = 750;
  }

  // This slot method is invoked when the user has selected the first button in the \
  // menu.
  $rect <200,620,390,660>
  slot Item1Slot
  {
    StartAnimation( Item1 );


  }

  // This slot method is invoked when the user has selected the second button in \
  // the menu.
  $rect <200,660,390,700>
  slot Item2Slot
  {
    StartAnimation( Item2 );
  }

  // This slot method is invoked when the user has selected the third button in the \
  // menu.
  $rect <200,700,390,740>
  slot Item3Slot
  {
    StartAnimation( Item3 );
  }

  // This method is invoked from the @fadeOutEffect durring the fade-out animation.
  $rect <200,860,390,900>
  slot onAnimate
  {
    var float phase = fadeOutEffect.Value;

    // In the first halftime of the animation - fade-out all items and mirrors
    if ( phase <= 0.5 )
    {
      Item1.Opacity = int32( 255.0 * ( 1.0 - ( phase * 2.0 )));
      Item2.Opacity = Item1.Opacity;
      Item3.Opacity = Item1.Opacity;

      Mirror1.Visible = false;
      Mirror2.Visible = false;
      Mirror3.Visible = false;
    }

    // Hide the invisible items
    if ( phase >= 0.5 )
    {
      Item1.Visible = false;
      Item2.Visible = false;
      Item3.Visible = false;
    }

    // Durring the fade-out animation ...
    var float scaleFactor = 1.0 + phase;
    var point pos1        = fadeOutView.Group.Bounds.center;
    var point pos2        = Bounds.orect.center;
    var point dstPos      = <0,0>;

    dstPos.x = int32( float( pos1.x ) * ( 1.0 - phase ) + float( pos2.x ) * phase );
    dstPos.y = int32( float( pos1.y ) * ( 1.0 - phase ) + float( pos2.y ) * phase );

    // ... zoom the image of the selected button 
    fadeOutView.RotateAndScale( dstPos, 0.0, scaleFactor, scaleFactor );
    fadeOutView.Opacity = int32( 255.0 * ( 1.0 - phase ));
  }

  // This method is invoked at the end of the fade-out animation.
  $rect <200,900,390,940>
  slot onFinished
  {
    // Which item was faded out (activated)? Inform the owner
    if ( fadeOutView.Group == Item1 ) idlesignal OnItem1;
    if ( fadeOutView.Group == Item2 ) idlesignal OnItem2;
    if ( fadeOutView.Group == Item3 ) idlesignal OnItem3;

    // Hide the animation view
    Remove( fadeOutView );
    fadeOutView = null;

    // Restore the default menu state and hide the entire menu
    Visible         = false;
    Item1.Opacity   = 255;
    Item2.Opacity   = 255;
    Item3.Opacity   = 255;
    Item1.Visible   = true;
    Item2.Visible   = true;
    Item3.Visible   = true;
    Mirror1.Visible = true;
    Mirror2.Visible = true;
    Mirror3.Visible = true;

    // Finally restore the event flow
    Enabled = true;
  }

  // The slot method is invoked from the @KeyHandler when the user has pressed one \
  // of th cursor keys up/down/left/right. Accordingly to the pressed key the appropriate \
  // button is selected.
  $rect <200,760,390,800>
  slot onPressKey
  {
    var Core::Direction dir  = Core::Direction.None;
    var Core::View      view = Focus;

    // Direction to look for menu buttons to select
    switch ( KeyHandler.Code )
    {
      case Core::KeyCode.Left  : dir = Core::Direction.Left;
      case Core::KeyCode.Right : dir = Core::Direction.Right;
      case Core::KeyCode.Up    : dir = Core::Direction.Top;
      case Core::KeyCode.Down  : dir = Core::Direction.Bottom;
      default :;
    }

    // Look for the button in the determined direction
    view = FindViewInDirection( view, dir, Core::ViewState[ Visible, Enabled, Focusable ]);

    // If found - select the button
    if ( view != null )
      Focus = view;
  }

  // This method is invoked after the user has activated one of the menu buttons. \
  // Thereupon an animation starts to fade-out the menu and show the corresponding \
  // example application.
  $rect <10,820,200,860>
  method void StartAnimation( arg Application::MenuButton aItem )
  {
    // Create an animation view for the fade out effect
    fadeOutView = new Views::WarpGroup;

    // Prepare an image view to display the faded item
    fadeOutView.Group        = aItem;
    fadeOutView.SourceAnchor = point( aItem.Bounds.w / 2, aItem.Bounds.h / 2 );
    Add( fadeOutView, 0 );

    // Start the animation sequence
    fadeOutEffect.Enabled = true;

    // Supress event dispatching durring the animation. 
    Enabled = false;
  }

  // The key handler to react to user keyboard inputs. It reacts to the cursor keys \
  // up/down/left/right only. If such key is pressed, the associated @onPressKey \
  // slot method is invoked.
  $rect <10,760,200,800>
  object Core::KeyPressHandler KeyHandler
  {
    preset OnPress = onPressKey;
    preset Filter = Core::KeyCode.CursorKeys;
  }

  $rect <20,20,160,60>
  object Views::WarpGroup Mirror1
  {
    preset Layout = Core::Layout[ResizeHorz, ResizeVert];
    preset Point4 = <60,225>;
    preset Point3 = <359,225>;
    preset Point2 = <359,454>;
    preset Point1 = <60,454>;
    preset Quality = false;
    preset Opacity4 = 150;
    preset Opacity3 = 150;
    preset Opacity2 = 0;
    preset Opacity1 = 0;
    preset Group = Item1;
  }

  $rect <20,20,160,60>
  object Views::WarpGroup Mirror2
  {
    preset Layout = Core::Layout[ResizeHorz, ResizeVert];
    preset Point4 = <440,225>;
    preset Point3 = <739,225>;
    preset Point2 = <739,454>;
    preset Point1 = <440,454>;
    preset Quality = false;
    preset Opacity4 = 150;
    preset Opacity3 = 150;
    preset Opacity2 = 0;
    preset Opacity1 = 0;
    preset Group = Item2;
  }

  $rect <20,20,160,60>
  object Views::WarpGroup Mirror3
  {
    preset Layout = Core::Layout[ResizeHorz, ResizeVert];
    preset Point4 = <254,480>;
    preset Point3 = <553,480>;
    preset Point2 = <553,709>;
    preset Point1 = <254,709>;
    preset Quality = false;
    preset Opacity4 = 150;
    preset Opacity3 = 150;
    preset Opacity2 = 0;
    preset Opacity1 = 0;
    preset Group = Item3;
  }

  $rect <20,20,160,60>
  object Application::MenuButton Item1
  {
    preset Layout = Core::Layout[ResizeHorz, ResizeVert];
    preset Bounds = <60,1,360,231>;
    preset Buffered = true;
    preset Face = Application::Item1Icon;
    preset OnActivate = Item1Slot;
  }

  $rect <20,20,160,60>
  object Application::MenuButton Item2
  {
    preset Layout = Core::Layout[ResizeHorz, ResizeVert];
    preset Bounds = <440,0,740,230>;
    preset Buffered = true;
    preset Face = Application::Item2Icon;
    preset OnActivate = Item2Slot;
  }

  $rect <20,20,160,60>
  object Application::MenuButton Item3
  {
    preset Layout = Core::Layout[ResizeHorz, ResizeVert];
    preset Bounds = <254,260,554,490>;
    preset Buffered = true;
    preset Face = Application::Item3Icon;
    preset OnActivate = Item3Slot;
  }

  // This property allows the menu to be connected to extern slot method. As soon \
  // as the user has activated the corresponding menu button, the associated method \
  // is invoked.
  $rect <390,620,570,660>
  property slot OnItem1 = null;

  // This property allows the menu to be connected to extern slot method. As soon \
  // as the user has activated the corresponding menu button, the associated method \
  // is invoked.
  $rect <390,660,570,700>
  property slot OnItem2 = null;

  // This property allows the menu to be connected to extern slot method. As soon \
  // as the user has activated the corresponding menu button, the associated method \
  // is invoked.
  $rect <390,700,570,740>
  property slot OnItem3 = null;
}


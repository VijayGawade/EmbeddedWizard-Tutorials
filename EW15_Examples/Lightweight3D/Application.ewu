$rect <240,310,440,350>
$output false
resource Resources::Bitmap EmWiLogo
{
  attr bitmapfile FileName = .\MenuRes\EmWiLogo.png;
  attr framesize FrameSize;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}

// This UI component implements a simple button
$rect <30,200,230,240>
$output false
class MenuButton : Core::Group
{
  $rect <0,110,180,150>
  inherited property Bounds = <0,0,70,70>;

  $rect <0,150,180,190>
  inherited method UpdateViewState()
  {
    // From the current state derive the corresponding image frame
    // for the face.
    if ( aState.contains( Core::ViewState[ Focused ]))
      ButtonFace.FrameNumber = 1;
    else
      ButtonFace.FrameNumber = 0;

    // If the user has pressed/released the button -> start an animation.
    // The pressed button should appear smaller
    if ( TouchHandler.Down && TouchHandler.Inside )
    {
      animationDirection = -0.05;
      ScaleTimer.Enabled = true;
    }

    // Released buttons appear bigger
    else
    {
      animationDirection = 0.05;
      ScaleTimer.Enabled = true;
    }

    // Trigger the first animation step immediatelly
    postsignal onAnimate;
  }

  $rect <190,390,370,430>
  var float animationDirection;

  $rect <190,430,370,470>
  var float animationPhase = 1.0;

  $rect <380,250,560,290>
  var bool wasActivated;

  // This method is invoked from the @TouchHandler when the user has moved in/out \
  // the finger over the button area.
  $rect <190,250,370,290>
  slot enterLeaveSlot
  {
    // Reprocess the state of the button
    InvalidateViewState();
  }

  // This method is invoked from the @TouchHandler when the user has pressed or released \
  // the button.
  $rect <190,290,370,330>
  slot pressReleaseSlot
  {
    // releasing the finger outside the button area is ignored
    if ( !TouchHandler.Down && TouchHandler.Inside )
      wasActivated = true;

    // Reprocess the state of the button
    InvalidateViewState();
  }

  // This slot method is invoked from the @KeyHandlerOk when the user has pressed \
  // the key 'OK'. The method activates the button.
  $rect <190,210,370,250>
  slot onOkSlot
  {
    animationPhase = 0.8;
    wasActivated   = true;

    // Reprocess the state of the button
    InvalidateViewState();
  }

  // The slot method is triggered from the @ScaleTimer. Its job is to adapt the button \
  // size.
  $rect <190,350,370,390>
  slot onAnimate
  {
    // Get the next scale factor
    animationPhase = animationPhase + animationDirection;

    // The end of animation reached
    if ( animationPhase >= 1.0 )
    {
      animationPhase     = 1.0;
      ScaleTimer.Enabled = false;
    }

    // The end of animation reached
    if ( animationPhase <= 0.8 )
    {
      animationPhase     = 0.8;
      ScaleTimer.Enabled = false;
    }

    // Nothing to show in the button
    if ( Face == null )
      return;

    var float scaleFactor;

    // Stretch factors to fill the entire width/height of the button
    // with the button face.
    var float factorX = float( Bounds.w ) / float( Face.FrameSize.x );
    var float factorY = float( Bounds.h ) / float( Face.FrameSize.y );

    // Select the factor, so the entire button face appears without be
    // distorted
    if ( factorX < factorY ) scaleFactor = factorX;
    else                     scaleFactor = factorY;

    // Calculate the scale factor accordingly to the current animation phase
    scaleFactor = scaleFactor * animationPhase;

    // Scale the content of the button
    ButtonFace.RotateAndScale( point( Bounds.w / 2, Bounds.h / 2 ), 0.0, 
                               scaleFactor, scaleFactor );

    // At the end of the animation inform the owner about the interaction
    if ( !ScaleTimer.Enabled && wasActivated )
    {
      idlesignal OnActivate;
      wasActivated = false;
    }
  }

  // The timer drives an animation. Durring the animation the button appears smaller.
  $rect <0,350,180,390>
  object Core::Timer ScaleTimer
  {
    preset OnTrigger = onAnimate;
    preset Period = 16;
  }

  $rect <190,40,370,80>
  onset Face
  {
    // Any changes? If no - nothing to do.
    if ( pure Face == value )
      return;

    // Remember the new button face bitmap
    pure Face = value;

    ButtonFace.Bitmap = value;

    // The button face should be scaled relatively to the center of the face image.
    if ( value != null )
      ButtonFace.SourceAnchor = point( value.FrameSize.x / 2, value.FrameSize.y / 2 );

  }

  // Handler for keyboard user inputs. It reacts to the 'OK' key and invokes the \
  // attached @onOkSlot method.
  $rect <0,210,180,250>
  object Core::KeyPressHandler KeyHandlerOk
  {
    preset OnPress = onOkSlot;
    preset Filter = Core::KeyCode.Ok;
  }

  $rect <20,20,160,60>
  object Core::SimpleTouchHandler TouchHandler
  {
    preset Layout = Core::Layout[AlignToBottom, AlignToLeft, AlignToRight, AlignToTop, ResizeHorz, ResizeVert];
    preset Point4 = <0,70>;
    preset Point3 = <70,70>;
    preset Point2 = <70,0>;
    preset Point1 = <0,0>;
    preset OnLeave = enterLeaveSlot;
    preset OnEnter = enterLeaveSlot;
    preset OnRelease = pressReleaseSlot;
    preset OnPress = pressReleaseSlot;
  }

  $rect <20,20,160,60>
  object Views::WarpImage ButtonFace
  {
    preset Point4 = <0,70>;
    preset Point3 = <70,70>;
    preset Point2 = <70,0>;
    preset Point1 = <0,0>;
    preset SourceAnchor = <30,30>;
    preset Bitmap = Application::BackItem;
  }

  // The property 'Face' determines the face of the button by assigning a bitmap \
  // resource.
  $rect <190,0,370,40>
  property Resources::Bitmap Face = Application::BackItem;

  // The property 'OnActivate' can refer to a slot method, which will receive a signal \
  // as soon as the user has pressed the button. Thereupon the method's logic will \
  // be executed.
  $rect <370,0,560,40>
  property slot OnActivate = null;
}

// This is a variant of the main application component. This variant handles the \
// automatic size adjustment according to the screen size.
$rect <60,90,260,130>
vclass Application_AutoSize : Application::Application
{
  $rect <10,640,210,680>
  inherited property Bounds = rect(<0,0>, $ScreenSize );
}


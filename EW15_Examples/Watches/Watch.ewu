  {
    preset OnTrigger = updateTime;
    preset Period = 500;
    preset Enabled = true;
  }

  $rect <460,0,660,40>
  onset Hour
  {
    // Validate the value
    value = value % 12;

    // Nothing to do
    if ( pure Hour == value )
      return;

    // Remember the new value
    pure Hour = value;

    // Recalculate the position of the watch hands
    InvalidateViewState();
  }

  $rect <460,40,660,80>
  onset Minute
  {
    // Validate the value
    value = value % 60;

    // Nothing to do
    if ( pure Minute == value )
      return;

    // Remember the new value
    pure Minute = value;

    // Recalculate the position of the watch hands
    InvalidateViewState();
  }

  $rect <460,80,660,120>
  onset Second
  {
    // Validate the value
    value = value % 60;

    // Nothing to do
    if ( pure Second == value )
      return;

    // Recalculate the position of the watch hands
    InvalidateViewState();
    InvalidateArea( Bounds );

    // Remember the new value
    pure Second = value;
  }

  $rect <460,120,660,160>
  onset AutoUpdate
  {
    // No changes? Nothing to do.
    if ( pure AutoUpdate == value )
      return;

    // Remember the new value
    pure AutoUpdate = value;

    // Start/Stop the update Timer
    updateTimer.Enabled = value;

    // If the current time view has been activated - update the screen
    // immediatelly.
    if ( value )
      postsignal updateTime;
  }

  $rect <460,160,660,200>
  onset TimeZone
  {
    // No changes? Nothing to do.
    if ( pure TimeZone == value )
      return;

    // Remember the new value
    pure TimeZone = value;

    // Recalculate the position of the watch hands
    InvalidateViewState();
  }

  $rect <20,20,160,60>
  object Views::Image Background
  {
    preset Bounds = <0,0,240,240>;
    preset Bitmap = Watch::Watch6Background;
  }

  // This is a line view.
  $rect <20,20,160,60>
  object Views::Line LineHM
  {
    preset Point2 = <160,170>;
    preset Point1 = <60,70>;
    preset Width2 = 15;
    preset Width1 = 21;
  }

  // This is a line view.
  $rect <20,20,160,60>
  object Views::Line LineMS
  {
    preset Point2 = <160,170>;
    preset Point1 = <60,70>;
    preset Width2 = 9;
    preset Width1 = 15;
  }

  // This is a line view.

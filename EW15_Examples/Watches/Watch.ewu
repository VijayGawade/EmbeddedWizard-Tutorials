// This UI component implements a watch.
$rect <10,420,210,460>
$output false
class Watch4 : Core::Group
{
  $rect <10,300,210,340>
  inherited property Bounds = <0,0,240,240>;

  $rect <10,340,210,380>
  inherited method UpdateViewState()
  {
    aState;
    var int32 h = ( Hour + TimeZone ) % 12;
    if ( h == 0 ) 
      h = 12; 

    // hour is from 6° to 84° in steps of 7.3°
    var float hou = 92.0 - ((float)h * 7.3 );

    // min and sec are from 90° to 180°
    var float min = (float)(Minute % 60 ) * 1.5 + 90.0;
    var float sec = (float)(Second % 60 ) * 1.5 + 90.0;

    // Rotate the three indicators arround the center of the clock
    HoursImage.  RotateAndScale(<240,240>, hou, 1.0, 1.0 );
    MinutesImage.RotateAndScale(<0,0>, -min, 1.0, 1.0 );
    SecondsImage.RotateAndScale(<0,0>, -sec, 1.0, 1.0 );


  }

  $rect <10,260,210,300>
  inherited method Init()
  {
    if ( pure AutoUpdate )
      signal updateTime;
  }

  // Tis method is invoked periodically to update the current time.
  $rect <470,340,670,380>
  slot updateTime
  {
    // Get the current time
    var Core::Time time = Time.CurrentTime;

    Hour   = time.Hour;
    Minute = time.Minute;
    Second = time.Second;


  }

  $rect <260,300,460,340>
  object Core::Time Time;

  $rect <260,340,460,380>
  object Core::Timer updateTimer
  {
    preset OnTrigger = updateTime;
    preset Period = 500;
    preset Enabled = true;
  }

  $rect <460,0,660,40>
  onset Hour
  {
    // Validate the value
    value = value % 12;

    // Nothing to do
    if ( pure Hour == value )
      return;

    // Remember the new value
    pure Hour = value;

    // Recalculate the position of the watch hands
    InvalidateViewState();
  }

  $rect <460,40,660,80>
  onset Minute
  {
    // Validate the value
    value = value % 60;

    // Nothing to do
    if ( pure Minute == value )
      return;

    // Remember the new value
    pure Minute = value;

    // Recalculate the position of the watch hands
    InvalidateViewState();
  }

  $rect <460,80,660,120>
  onset Second
  {
    // Validate the value
    value = value % 60;

    // Nothing to do
    if ( pure Second == value )
      return;

    // Recalculate the position of the watch hands
    InvalidateViewState();

    // Remember the new value
    pure Second = value;
  }

  $rect <460,120,660,160>
  onset AutoUpdate
  {
    // No changes? Nothing to do.
    if ( pure AutoUpdate == value )
      return;

    // Remember the new value
    pure AutoUpdate = value;

    // Start/Stop the update Timer
    updateTimer.Enabled = value;

    // If the current time view has been activated - update the screen
    // immediatelly.
    if ( value )
      postsignal updateTime;
  }

  $rect <460,160,660,200>
  onset TimeZone
  {
    // No changes? Nothing to do.
    if ( pure TimeZone == value )
      return;

    // Remember the new value
    pure TimeZone = value;

    // Recalculate the position of the watch hands
    InvalidateViewState();
  }

  $rect <20,20,160,60>
  object Views::Image Background
  {
    preset Bounds = <0,0,240,240>;
    preset Bitmap = Watch::Watch4Background;
  }

  $rect <20,20,160,60>
  object Views::WarpImage HoursImage
  {
    preset Point4 = <130,171>;
    preset Point3 = <171,171>;
    preset Point2 = <171,58>;
    preset Point1 = <130,58>;
    preset SourceAnchor = <4,111>;
    preset Color = #662483FF;
    preset Bitmap = Watch::Watch4Needle;
  }

  $rect <20,20,160,60>
  object Views::WarpImage MinutesImage
  {
    preset Point4 = <130,171>;
    preset Point3 = <171,171>;
    preset Point2 = <171,28>;
    preset Point1 = <130,28>;
    preset SourceAnchor = <4,141>;
    preset Color = #B6577CFF;
    preset Bitmap = Watch::Watch4Needle;
  }

  $rect <20,20,160,60>
  object Views::WarpImage SecondsImage
  {
    preset Point4 = <140,182>;
    preset Point3 = <161,182>;
    preset Point2 = <161,29>;
    preset Point1 = <140,29>;
    preset SourceAnchor = <4,111>;
    preset Color = #777777FF;
    preset Bitmap = Watch::Watch4Needle;
  }

  $rect <20,20,160,60>
  object Views::Image ForegroundTL
  {
    preset Bounds = <0,0,60,60>;
    preset Alignment = Views::ImageAlignment[AlignHorzLeft, AlignVertTop];
    preset Bitmap = Watch::Watch4ForegroundTL;
  }

  $rect <20,20,160,60>
  object Views::Image ForegroundBR
  {
    preset Bounds = <160,150,240,240>;
    preset Alignment = Views::ImageAlignment[AlignHorzRight, AlignVertBottom];
    preset Bitmap = Watch::Watch4ForegroundBR;
  }

  // The property 'Hour' stores the time to show in the watch.
  $rect <260,0,460,40>
  property int32 Hour = 0;

  // The property 'Minute' stores the time to show in the watch.
  $rect <260,40,460,80>
  property int32 Minute = 0;

  // The property 'Second' stores the time to show in the watch.
  $rect <260,80,460,120>
  property int32 Second = 0;

  // This property 'AutoUpdate' determines, whether the watch should update itself \
  // with the current time. Otherwise, the displayed time is taken from the properties \
  // @Hour, @Minute and @Second.
  $rect <260,120,460,160>
  property bool AutoUpdate = true;

  // The property 'TimeZone' contains an additional time zone offset in hours.
  $rect <260,160,460,200>
  property int32 TimeZone = 0;

  // This class implements a fancy analog watch based on three needle indicators \
  // pointing on a 12h or 60min/sec scale.
  // The watch can either show a given time by setting the properties 'Hour', 'Minute' \
  // and 'Second', or it can show the current system time if the property 'AutoUpdate' \
  // is true.
  // The calculation of the needle rotation is done within the method 'UpdateViewState'. 
  note legend Note
  {
    attr Bounds = <0,390,660,520>;
  }
}


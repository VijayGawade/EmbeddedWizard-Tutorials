    var float min = ((float)Minute * 6.0 ) /* + ((float)Second * 0.1 )*/ - 45.0;
    var float hou = ((float)( Hour + TimeZone ) * 30.0 ) + ((float)Minute * 0.5 ) + ((float)Second * ( 0.5 / 60.0 )) + 65.0;
    var float sec = (float)Second * 6.0 - 150.0;

    // Rotate the three indicators arround the center of the clock
    HoursImage.  RotateAndScale(<120,120>, hou, 1.0, 1.0 );
    MinutesImage.RotateAndScale(<120,120>, min, 1.0, 1.0 );
    SecondsImage.RotateAndScale(<120,120>, sec, 1.0, 1.0 );


  }

  $rect <10,260,210,300>
  inherited method Init()
  {
    if ( pure AutoUpdate )
      signal updateTime;
  }

  // Tis method is invoked periodically to update the current time.
  $rect <470,340,670,380>
  slot updateTime
  {
    // Get the current time
    var Core::Time time = Time.CurrentTime;

    Hour   = time.Hour;
    Minute = time.Minute;
    Second = time.Second;


  }

  $rect <260,300,460,340>
  object Core::Time Time;

  $rect <260,340,460,380>
  object Core::Timer updateTimer
  {
    preset OnTrigger = updateTime;
    preset Period = 500;
    preset Enabled = true;
  }

  $rect <460,0,660,40>
  onset Hour
  {
    // Validate the value
    value = value % 12;

    // Nothing to do
    if ( pure Hour == value )
      return;

    // Remember the new value
    pure Hour = value;

    // Recalculate the position of the watch hands
    InvalidateViewState();
  }

  $rect <460,40,660,80>
  onset Minute
  {
    // Validate the value
    value = value % 60;

    // Nothing to do
    if ( pure Minute == value )
      return;

    // Remember the new value
    pure Minute = value;

    // Recalculate the position of the watch hands
    InvalidateViewState();
  }

  $rect <460,80,660,120>
  onset Second
  {
    // Validate the value
    value = value % 60;

    // Nothing to do
    if ( pure Second == value )
      return;

    // Recalculate the position of the watch hands
    InvalidateViewState();

    // Remember the new value
    pure Second = value;

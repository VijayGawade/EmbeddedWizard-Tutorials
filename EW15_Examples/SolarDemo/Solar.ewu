  // Enum item for unit Hour.
  $rect <10,60,150,100>
  item Hour;

  // Enum item for unit KiloWattHour.
  $rect <160,60,300,100>
  item KiloWattHour;

  // Enum item for unit Celsius.
  $rect <310,60,450,100>
  item Celsius;

  // Enum item for no unit.
  $rect <10,10,150,50>
  item None;

  // Enum item for unit Hertz.
  $rect <460,60,600,100>
  item Hertz;
}


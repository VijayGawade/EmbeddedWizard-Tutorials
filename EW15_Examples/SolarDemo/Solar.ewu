// The class 'MeterCounterBlack' implements a single black digit of the electricity \
// meter 'ElectricMeter'.
$rect <490,350,690,390>
$output false
class MeterCounterBlack : Core::Group
{
  $rect <40,0,240,40>
  inherited property Bounds = <0, 0, 20, 30>;

  // This is an simple image view.
  $rect <20,20,160,60>
  object Views::Image Image
  {
    preset Bitmap = SolarRes::MeterNumbersBlack;
    preset Bounds = <0,0,20,330>;
  }

  // The property 'Value' contains the currently displayed number.
  $rect <250,0,450,40>
  property int32 Value = 0;

  // The onset method of the property 'Value' changes the currently displayed number.
  $rect <250,40,450,80>
  onset Value
  {
    if ( value < 0 )
      value = 0;
    value = value % 10;

    if ( value == pure Value )
      return;

    pure Value = value;
    Timer.Enabled = true;
  }

  // This is a timer object to trigger the slow motion of the counter.
  $rect <40,50,240,90>
  object Core::Timer Timer
  {
    preset OnTrigger = Slot;
    preset Period = 25;
  }

  // Slot method to make the counter motion.
  $rect <40,90,240,130>
  slot Slot
  {
    /* calculate final position of the bitmap */
    var int32 y = -Value * 30;

    /* if end position is reached, timer can be disabled */
    if ( Image.Bounds.origin.y == y )
    {
      Timer.Enabled = false;
      return;
    }

    /* move the image a little bit */
    Image.Bounds.origin.y = Image.Bounds.origin.y - 1;

    /* avoid overflow */
    if ( Image.Bounds.origin.y <= -300 )
      Image.Bounds.origin.y = 0;


  }

  // This class implements a single digit of an electricity meter with a smooth movement \
  // of the displayed value.
  note legend Note
  {
    attr Bounds = <0,140,450,190>;
  }
}

// The class 'MeterCounterBlack' implements a single red digit of the electricity \
// meter 'ElectricMeter'.
$rect <700,350,900,390>
$output false
class MeterCounterRed : Core::Group
{
  $rect <40,0,240,40>
  inherited property Bounds = <0, 0, 20, 30>;

  // This is an simple image view.
  $rect <20,20,160,60>
  object Views::Image Image
  {
    preset Bitmap = SolarRes::MeterNumbersRed;
    preset Bounds = <0,0,20,330>;
  }

  // The property 'Value' contains the currently displayed number.
  $rect <250,0,450,40>
  property int32 Value = 0;

  // The onset method of the property 'Value' changes the currently displayed number.
  $rect <250,40,450,80>
  onset Value
  {
    if ( value < 0 )
      value = 0;
    value = value % 100;

    if ( value == pure Value )
      return;

    pure Value = value;
    Timer.Enabled = true;
  }

  // This is a timer object to trigger the slow motion of the counter.
  $rect <40,50,240,90>
  object Core::Timer Timer
  {
    preset OnTrigger = Slot;
    preset Period = 25;
  }

  // Slot method to make the counter motion.
  $rect <40,90,240,130>
  slot Slot
  {
    /* calculate final position of the bitmap */
    var int32 y = -Value * 3;

    /* if end position is reached, timer can be disabled */
    if ( Image.Bounds.origin.y == y )
    {
      Timer.Enabled = false;
      return;
    }

    /* move the image a little bit */
    Image.Bounds.origin.y = Image.Bounds.origin.y - 1;

    /* avoid overflow */
    if ( Image.Bounds.origin.y <= -300 )
      Image.Bounds.origin.y = 0;


  }

  // This class implements a single digit of an electricity meter with a smooth movement \
  // of the displayed value.
  note legend Note
  {
    attr Bounds = <0,140,450,190>;
  }
}

// The class 'ElectricMeter' implements the simulation of an electricity meter.
$rect <280,350,480,390>
$output false
class ElectricMeter : Core::Group
{
  $rect <290,10,490,50>
  inherited property Bounds = <0,0,270,390>;

  // The property 'EnergyYield' contains the currently displayed value of the electricity \
  // meter. The value contains two digits after the decimal point (1 kWh = value \
  // 100).
  $rect <290,120,490,160>
  property int32 EnergyYield = 0;

  // The onset method of the property 'EnergyYield' changes the conter value of the \
  // electricity meter.
  $rect <290,160,490,200>
  onset EnergyYield
  {
    /* avoid negative values */
    if ( value < 0 )
      value = 0;

    /* set all digits of the counter */
    Energy0.Value = value % 100;
    Energy1.Value = ( value / 100 ) % 10;
    Energy2.Value = ( value / 1000 ) % 10;
    Energy3.Value = ( value / 10000 ) % 10;
    Energy4.Value = ( value / (int32)100000 ) % 10;
    Energy5.Value = ( value / (int32)1000000 ) % 10;
    Energy6.Value = ( value / (int32)10000000 ) % 10;

    /* store the property value */
    pure EnergyYield = value;


  }

  // The property 'Runtime' contains the currently displayed value of the operating \
  // hours counter. The value contains two digits after the decimal point (1 h = \
  // value 100).
  $rect <500,120,700,160>
  property int32 Runtime = 0;

  // The onset method of the property 'Runtime' changes the value of the operating \
  // hours counter.
  $rect <500,160,700,200>
  onset Runtime
  {
    /* avoid negative values */
    if ( value < 0 )
      value = 0;

    /* set all digits of the counter */
    Time0.Value = value % 100;
    Time1.Value = ( value / 100 ) % 10;
    Time2.Value = ( value / 1000 ) % 10;
    Time3.Value = ( value / 10000 ) % 10;
    Time4.Value = ( value / (int32)100000 ) % 10;
    Time5.Value = ( value / (int32)1000000 ) % 10;
    Time6.Value = ( value / (int32)10000000 ) % 10;

    /* store the property value */
    pure Runtime = value;


  }

  $rect <20,20,160,60>
  object Solar::MeterCounterRed Energy0
  {
    preset Bounds = <180,120,200,150>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Energy1
  {
    preset Bounds = <160,120,180,150>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Energy2
  {
    preset Bounds = <140,120,160,150>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Energy3
  {
    preset Bounds = <120,120,140,150>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Energy4
  {
    preset Bounds = <100,120,120,150>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Energy5
  {
    preset Bounds = <80,120,100,150>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Energy6
  {
    preset Bounds = <60,120,80,150>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterRed Time0
  {
    preset Bounds = <180,190,200,220>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Time1
  {
    preset Bounds = <160,190,180,220>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Time2
  {
    preset Bounds = <140,190,160,220>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Time3
  {
    preset Bounds = <120,190,140,220>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Time4
  {
    preset Bounds = <100,190,120,220>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Time5
  {
    preset Bounds = <80,190,100,220>;
  }

  $rect <20,20,160,60>
  object Solar::MeterCounterBlack Time6
  {
    preset Bounds = <60,190,80,220>;
  }

  $rect <20,20,160,60>
  object Solar::MeterDisc MeterDisc
  {
    preset Bounds = <60,65,200,79>;
  }

  // This is an simple image view.
  $rect <20,20,160,60>
  object Views::Image Image
  {
    preset Bounds = <0,0,268,388>;
    preset AutoSize = true;
    preset Bitmap = SolarRes::MeterChassis;
  }

  // This slot method will receive a signal, if the value of the property assigned \
  // to @Outlet has been changed by another widget or by the application logic. In \
  // response to this notification, the widget will update itself.
  $rect <290,310,490,350>
  slot outletSlotEnergyYield
  {
    /* update the current state of the widget */
    if ( OutletEnergyYield != null )
      EnergyYield = OutletEnergyYield^;
  }

  $rect <290,260,490,300>
  onset OutletEnergyYield
  {
    /* check if the new outlet differs from the currently used outlet */
    if ( pure OutletEnergyYield == value )
      return;

    /* detach from the previous outlet */
    if ( pure OutletEnergyYield != null )
      detachobserver outletSlotEnergyYield, pure OutletEnergyYield;

    /* store the new outlet */
    pure OutletEnergyYield = value;

    /* ... and attach to the new one */
    if ( value != null )
      attachobserver outletSlotEnergyYield, value;

    /* finally, update the current state of the widget by posting a signal to the outlet slot */
    if ( value != null )
      postsignal outletSlotEnergyYield;
  }

  // The property 'Outlet' provides an interface for the Model-View-Controller (MVC). \
  // In the MVC, the widgets (views) and the application logic (model) are always \
  // kept apart. An automatism behind this model ensures, that widgets are notified \
  // automatically as soon as the affected model has changed its state. On the other \
  // hand, user interactions on a widget cause the affected model to execute the \
  // application logic. Usually, a model is a simple Chora object containg several \
  // properties and the implementation of onget/onset method.
  // By assigning a property reference, Outlet establishes a connection between the \
  // widget and the model object, the affected property belongs to. After this, the \
  // widget is able to read and modify the referred property in response to the user \
  // interactions. It is also able to adapt the widget appearance, if the value of \
  // the referred property has been modified by another widget or by the application \
  // logic itself.
  $rect <290,220,490,260>
  property ^int32 OutletEnergyYield = null;

  // The class 'ElectricMeter' implements an old-style electricity meter.
  // Within this solar demo application, it is enhanced to show the "produced" solar \
  // energy and the operating hours. 
  // The property 'EnergyYield' represents the total energy yield in kWh. The property \
  // 'Runtime' represents the overall runtime of the inverter in hours.
  // The electric meter can be connected with the int32 'OutletEnergyYield' and 'OutletRuntime' \
  // properties to show the current values of these properties.
  note legend Note
  {
    attr Bounds = <0,410,710,570>;
  }

  // This slot method will receive a signal, if the value of the property assigned \
  // to @Outlet has been changed by another widget or by the application logic. In \
  // response to this notification, the widget will update itself.
  $rect <500,310,700,350>
  slot outletSlotRuntime
  {
    /* update the current state of the widget */
    if ( OutletRuntime != null )
      Runtime = OutletRuntime^;
  }

  $rect <500,260,700,300>
  onset OutletRuntime
  {
    /* check if the new outlet differs from the currently used outlet */
    if ( pure OutletRuntime == value )
      return;

    /* detach from the previous outlet */
    if ( pure OutletRuntime != null )
      detachobserver outletSlotRuntime, pure OutletRuntime;

    /* store the new outlet */
    pure OutletRuntime = value;

    /* ... and attach to the new one */
    if ( value != null )
      attachobserver outletSlotRuntime, value;

    /* finally, update the current state of the widget by posting a signal to the outlet slot */
    if ( value != null )
      postsignal outletSlotRuntime;
  }

  // The property 'Outlet' provides an interface for the Model-View-Controller (MVC). \
  // In the MVC, the widgets (views) and the application logic (model) are always \
  // kept apart. An automatism behind this model ensures, that widgets are notified \
  // automatically as soon as the affected model has changed its state. On the other \
  // hand, user interactions on a widget cause the affected model to execute the \
  // application logic. Usually, a model is a simple Chora object containg several \
  // properties and the implementation of onget/onset method.
  // By assigning a property reference, Outlet establishes a connection between the \
  // widget and the model object, the affected property belongs to. After this, the \
  // widget is able to read and modify the referred property in response to the user \
  // interactions. It is also able to adapt the widget appearance, if the value of \
  // the referred property has been modified by another widget or by the application \
  // logic itself.
  $rect <500,220,700,260>
  property ^int32 OutletRuntime = null;
}


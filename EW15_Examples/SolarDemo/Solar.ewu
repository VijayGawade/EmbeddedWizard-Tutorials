  {
    preset Bitmap = SolarRes::PlotterScale;
    preset Bounds = <458,80,536,468>;
    preset AutoSize = true;
  }

  // This is a simple line view.
  $rect <20,20,160,60>
  object Views::Line Line1
  {
    preset Point2 = <482,410>;
    preset Point1 = <464,410>;
    preset Color = #000080FF;
    preset AlphaBlended = false;
  }

  // This is a simple line view.
  $rect <20,20,160,60>
  object Views::Line Line2
  {
    preset Point2 = <482,340>;
    preset Point1 = <464,340>;
    preset Color = #000080FF;
    preset AlphaBlended = false;
  }

  // This is a simple line view.
  $rect <20,20,160,60>
  object Views::Line Line3
  {
    preset Point2 = <482,270>;
    preset Point1 = <464,270>;
    preset Color = #000080FF;
    preset AlphaBlended = false;
  }

  // This is a simple line view.
  $rect <20,20,160,60>
  object Views::Line Line4
  {
    preset Point2 = <482,200>;
    preset Point1 = <464,200>;
    preset Color = #000080FF;
    preset AlphaBlended = false;
  }

  // This is a simple line view.
  $rect <20,20,160,60>
  object Views::Line Line5
  {
    preset Point2 = <482,130>;
    preset Point1 = <464,130>;
    preset Color = #000080FF;
    preset AlphaBlended = false;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text ValueText1
  {
    preset Bounds = <486,398,516,418>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertBottom];
    preset String = "0";
    preset Font = SolarRes::DescrFont;
    preset Color = #000080FF;
    preset Visible = true;
  }

  // This is a text object.
  $rect <20,20,160,60>

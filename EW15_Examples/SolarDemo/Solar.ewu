// The class 'DataDisplay' implements the simulation of a data display that writes \
// metered values with a light-pen on the screen.
$rect <280,150,480,190>
$output false
class DataDisplay : Core::Group
{
  $rect <10,400,210,440>
  inherited property Bounds = <0,0,320,340>;

  $rect <210,400,410,440>
  inherited method Init()
  {
    Bounds.size = Background.Bitmap.FrameSize;
  }

  // The method 'AddSamples' is called to feed new data into the intraday display.
  $rect <780,290,980,330>
  method void AddSample( arg int32 aData )
  {
    var int32 x;
    var int32 y;
    var int32 deltaX;
    var int32 borderY = 0;

    if ( aData > MaxValue )
      aData = MaxValue;
    if ( aData < MinValue )
      aData = MinValue;

    SampleNumber = SampleNumber + 1;
    if ( SampleNumber > NoOfSamples )
      return;

    deltaX = Bounds.w / NoOfSamples;

    /* draw data with a new dot image */
    y = Bounds.h - borderY;
    x = SampleNumber * deltaX;

    if ( MaxValue > 0 )
      y =  y - (( aData - MinValue ) * ( Bounds.h - 2 * borderY ) / MaxValue );

    var Views::Image img = new Views::Image;
    img.Bitmap = Dot.Bitmap;
    img.Bounds = Dot.Bounds;
    img.Bounds.origin.x = x - img.Bounds.w / 2;
    img.Bounds.origin.y = y - img.Bounds.h / 2;

    Add( img, 0 );


  }

  // The property 'MaxValue' stores the upper level of the data range.
  $rect <780,180,980,220>
  property int32 MaxValue = 100;

  // The onset method for the property 'MaxValue' changes the maximum data value.
  $rect <780,220,980,260>
  onset MaxValue
  {
    /* ensure that maximum value is positive */
    if ( value < 1 )
      value = 1;

    pure MaxValue = value;
  }

  // The property 'MinValue' stores the lower level of the data range.
  $rect <780,90,980,130>
  property int32 MinValue = 0;

  // The onset method for the property 'MinValue' changes the minimum data value.
  $rect <780,130,980,170>
  onset MinValue
  {
    /* ensure that minimum value is positive */
    if ( value < 0 )
      value = 0;

    pure MinValue = value;
  }

  // This is an simple image view.
  $rect <20,20,160,60>
  object Views::Image Background
  {
    preset Bitmap = SolarRes::IntradayBackground;
    preset Bounds = <0,0,760,380>;
    preset AutoSize = true;
  }

  // The variable 'LastX' stores the current position of the simulated pen in horizontal \
  // direction.
  $rect <780,340,980,380>
  var int32 SampleNumber = 0;

  // The property 'NoOfSamples' stores the number of samples that can be added to \
  // the display.
  $rect <780,0,980,40>
  property int32 NoOfSamples = 10;

  // The onset method for the property 'NoOfSamples' changes the maximum number of \
  // samples.
  $rect <780,40,980,80>
  onset NoOfSamples
  {
    /* ensure that maximum value is positive */
    if ( value < 1 )
      value = 1;

    pure NoOfSamples = value;
  }

  // This is an simple image view.
  $rect <20,20,160,60>
  object Views::Image Dot
  {
    preset Visible = false;
    preset Bitmap = SolarRes::IntradayDot;
    preset Bounds = <0,0,15,15>;
    preset AutoSize = true;
  }

  // The class 'DataDisplay' implements a data display that writes metered values \
  // with small sun images on the screen.
  // This display item is used to show the intraday energy yield of the solar inverter.
  // The data have to be provided from outside by calling the method AddSample().
  note legend Note
  {
    attr Bounds = <420,400,970,510>;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text Time5
  {
    preset Bounds = <624,360,664,380>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertBottom];
    preset String = "18:00";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text Time4
  {
    preset Bounds = <504,360,544,380>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertBottom];
    preset String = "15:00";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text Time3
  {
    preset Bounds = <384,360,424,380>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertBottom];
    preset String = "12:00";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text Time2
  {
    preset Bounds = <264,360,304,380>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertBottom];
    preset String = "9:00";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text Time1
  {
    preset Bounds = <144,360,184,380>;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertBottom];
    preset String = "6:00";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = true;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text Text
  {
    preset Bounds = <5,10,140,60>;
    preset WrapText = true;
    preset Alignment = Views::TextAlignment[AlignHorzLeft, AlignVertTop];
    preset String = "Solar Power of Today";
    preset Font = SolarRes::TextFont;
    preset Color = SolarRes::TextColor;
  }
}

// The class 'IntradayPanel' displays the energy yield per day by using the class \
// 'DataDisplay'.
$rect <30,150,230,190>
$output false
class IntradayPanel : Solar::Panel
{
  $rect <20,20,160,60>
  inherited object CaptionText
  {
    preset String = "Intraday Performance";
  }

  $rect <820,10,1020,50>
  inherited method Unlock()
  {
    super();

    AnimationTimer.Enabled = true;

  }

  $rect <20,20,160,60>
  object Solar::DataDisplay DataDisplay
  {
    preset Bounds = <20,90,780,470>;
    preset MaxValue = 100;
    preset NoOfSamples = 64;
  }

  // This is a timer object.
  $rect <10,510,210,550>
  object Core::Timer AnimationTimer
  {
    preset OnTrigger = AnimationSlot;
    preset Period = 25;
  }

  // This is a slot method.
  $rect <210,510,410,550>
  slot AnimationSlot
  {
    /* please note: instead of reading data from a real solar power system
       only a few dummy data are calculated for displaying them within this 
       solar demo application */

    var int32 x = Counter;
    var int32 y;

    var float f = math_sin( (float)x * 180.0 / (float) DataDisplay.NoOfSamples );

    y = (int32)( f * f * (float)DataDisplay.MaxValue * 0.9 ) + math_rand( -2, 3 );

    DataDisplay.AddSample( y );

    /* until all values are shown... */
    Counter = Counter + 1;
    if ( Counter >= DataDisplay.NoOfSamples )
      AnimationTimer.Enabled = false;


  }

  // This is a variable.
  $rect <410,510,610,550>
  var int32 Counter = 0;

  // The class 'IntradayPanel' displays the energy yield per day by using the class \
  // 'Solar::DataDisplay'.
  // As soon as this panel is unlocked, the timer driven animation provides some \
  // random data for the data display.
  note legend Note
  {
    attr Bounds = <10,560,800,640>;
  }
}


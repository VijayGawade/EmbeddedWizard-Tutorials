}

// This is a GUI component.
$rect <280,400,480,440>
$output false
class AnalogDisplay : Core::Group
{
  $rect <0,180,200,220>
  inherited property Bounds = <0,0,148,128>;

  $rect <0,220,200,260>
  inherited method UpdateViewState()
  {
    // Avoid Chora warnings due to unused parameters.
    aState;

    /* calculate angle of needle in the range from -38 to +38 degrees */
    var float angle = 38.0;
    var int32 val = CurrentValue;

    /* check the limits of the display value */
    if ( CurrentValue < MinValue )
      val = MinValue;
    if ( CurrentValue > MaxValue )
      val = MaxValue;

    /* ensure that the current set value and the given minimum and maximum values are valid */
    if ( MaxValue > MinValue )
    {
      /* calculate the new rotation angle of the needle */
      angle = angle - 76.0 * (float)( val - MinValue ) / (float)( MaxValue - MinValue );
    }

    /* if calculated angle is different from the current angle, let's start an animation to move the needle smooth */
    if ( angle != needleAngle )
    {
      RotateNeedleEffect.Enabled = false;
      RotateNeedleEffect.Value1  = needleAngle;
      RotateNeedleEffect.Value2  = angle;
      RotateNeedleEffect.Enabled = true;
    }

  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image Back
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToTop];
    preset Bounds = <0,0,148,128>;
    preset AutoSize = true;
    preset Bitmap = SolarRes::MultimeterScale;
  }

  // This is a 2D/3D warp image view.
  $rect <20,20,160,60>
  object Views::WarpImage Needle
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToTop];
    preset Point4 = <66,113>;
    preset Point3 = <73,108>;
    preset Point2 = <18,38>;
    preset Point1 = <11,43>;
    preset SourceAnchor = <3,89>;
    preset Bitmap = SolarRes::MultimeterNeedle;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image Front
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToTop];
    preset Bounds = <0,0,148,128>;
    preset AutoSize = true;
    preset Bitmap = SolarRes::MultimeterChassis;
  }

  // This is a 'float' change effect.
  $rect <0,270,200,310>
  object Effects::FloatEffect RotateNeedleEffect
  {
    preset Timing = Effects::Timing.FastIn_EaseOut;
    preset NoOfCycles = 1;
    preset CycleDuration = 1000;
    preset Outlet = ^needleAngle;
  }

  // This is an internal property to drive the smooth needle animation.
  $rect <0,310,200,350>
  property float needleAngle = 38.0;

  $rect <0,350,200,390>
  onset needleAngle
  {
    /* limit the given value to the range between MinValue and MaxValue */
    if ( value > 38.0 )
      value = 38.0;
    if ( value < -38.0 )
      value = -38.0;

    /* check if the given value differs from the current value */
    if ( pure needleAngle == value )
      return;

    /* store the new value */
    pure needleAngle = value;

    /* rorate the needle to the given angle */
    Needle.RotateAndScale( <70,110>, needleAngle, 1.0, 1.0 );



  }

  // The property 'CurrentValue' stores the momentary value of the widget. The value \
  // is limited automatically to the range from @MinValue to @MaxValue.
  $rect <200,0,400,40>
  property int32 CurrentValue = 0;

  $rect <200,40,400,80>
  onset CurrentValue
  {
    /* check if the given value differs from the current value */
    if ( pure CurrentValue == value )
      return;

    /* store the new value */
    pure CurrentValue = value;

    /* ...and finally, force an update */
    InvalidateViewState();
  }

  // The property 'MinValue' defines the lower boundary of the widgets value range.
  $rect <400,0,600,40>
  property int32 MinValue = 0;

  $rect <400,40,600,80>
  onset MinValue
  {
    /* check if the given value differs from the current value */
    if ( pure MinValue == value )
      return;

    /* store the new value */
    pure MinValue = value;

    /* ...and finally, force an update */
    InvalidateViewState();
  }

  // The property 'MaxValue' defines the upper boundary of the widgets value range.
  $rect <600,0,800,40>
  property int32 MaxValue = 100;

  $rect <600,40,800,80>
  onset MaxValue
  {
    /* check if the given value differs from the current value */
    if ( pure MaxValue == value )
      return;

    /* store the new value */
    pure MaxValue = value;

    /* ...and finally, force an update */
    InvalidateViewState();
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text ScaleTextUnit
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToTop];
    preset Bounds = <42,55,102,77>;
    preset String = "xy";
    preset Font = Resources::FontMedium;
    preset Color = #000000FF;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text ScaleText0
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToTop];
    preset Bounds = <13,48,41,61>;
    preset String = "0";
    preset Font = SolarRes::ScaleFont;
    preset Color = #000000FF;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text ScaleText1
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToTop];
    preset Bounds = <34,36,62,49>;
    preset String = "1";
    preset Font = SolarRes::ScaleFont;
    preset Color = #000000FF;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text ScaleText2
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToTop];
    preset Bounds = <57,31,85,44>;
    preset String = "2";
    preset Font = SolarRes::ScaleFont;
    preset Color = #000000FF;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text ScaleText3
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToTop];
    preset Bounds = <81,36,109,49>;
    preset String = "3";
    preset Font = SolarRes::ScaleFont;
    preset Color = #000000FF;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text ScaleText4
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToTop];
    preset Bounds = <101,48,129,61>;
    preset String = "4";
    preset Font = SolarRes::ScaleFont;
    preset Color = #000000FF;
  }

  // The property 'TextUnit' represents the unit of the analog meter. The string \
  // is displayed at the center of the scale to show the dimension unit of the gauge, \
  // for example: 'mV', 'mA', 'prm', '°C', 'mph", ...
  $rect <402,90,602,130>
  property string TextUnit = "";

  $rect <402,130,602,170>
  onset TextUnit
  {
    pure TextUnit = value;
    ScaleTextUnit.String = value;
  }

  // The property 'TextScale0' stores the string of the measured value, shown at \
  // the scale position 0.
  $rect <400,180,600,220>
  property string TextScale0 = "";

  $rect <402,220,602,260>
  onset TextScale0
  {
    pure TextScale0 = value;
    ScaleText0.String = value;
  }

  // The property 'TextScale1' stores the string of the measured value, shown at \
  // the scale position 1.
  $rect <402,270,602,310>
  property string TextScale1 = "";

  $rect <402,310,602,350>
  onset TextScale1
  {
    pure TextScale1 = value;
    ScaleText1.String = value;
  }

  // The property 'TextScale2' stores the string of the measured value, shown at \
  // the scale position 2.
  $rect <402,360,602,400>
  property string TextScale2 = "";

  $rect <402,400,602,440>
  onset TextScale2
  {
    pure TextScale2 = value;
    ScaleText2.String = value;
  }

  // The property 'TextScale3' stores the string of the measured value, shown at \
  // the scale position 3.
  $rect <612,180,812,220>
  property string TextScale3 = "";

  $rect <612,220,812,260>
  onset TextScale3
  {
    pure TextScale3 = value;
    ScaleText3.String = value;
  }

  // The property 'TextScale4' stores the string of the measured value, shown at \
  // the scale position 4.
  $rect <612,270,812,310>
  property string TextScale4 = "";

  $rect <612,310,812,350>
  onset TextScale4
  {
    pure TextScale4 = value;
    ScaleText4.String = value;
  }

  // This slot method will receive a signal, if the value of the property assigned \
  // to @Outlet has been changed by another widget or by the application logic. In \
  // response to this notification, the widget will update itself.
  $rect <200,180,400,220>
  slot outletSlot
  {
    /* update the current state of the widget */
    if ( Outlet != null )
      CurrentValue = Outlet^;
  }

  $rect <200,130,400,170>
  onset Outlet
  {
    /* check if the new outlet differs from the currently used outlet */
    if ( pure Outlet == value )
      return;

    /* detach from the previous outlet */
    if ( pure Outlet != null )
      detachobserver outletSlot, pure Outlet;

    /* store the new outlet */
    pure Outlet = value;

    /* ... and attach to the new one */
    if ( value != null )
      attachobserver outletSlot, value;

    /* finally, update the current state of the widget by posting a signal to the outlet slot */
    if ( value != null )
      postsignal outletSlot;
  }

  // The property 'Outlet' provides an interface for the Model-View-Controller (MVC). \
  // In the MVC, the widgets (views) and the application logic (model) are always \
  // kept apart. An automatism behind this model ensures, that widgets are notified \
  // automatically as soon as the affected model has changed its state. On the other \
  // hand, user interactions on a widget cause the affected model to execute the \
  // application logic. Usually, a model is a simple Chora object containg several \
  // properties and the implementation of onget/onset method.
  // By assigning a property reference, Outlet establishes a connection between the \
  // widget and the model object, the affected property belongs to. After this, the \
  // widget is able to read and modify the referred property in response to the user \
  // interactions. It is also able to adapt the widget appearance, if the value of \
  // the referred property has been modified by another widget or by the application \
  // logic itself.
  $rect <200,90,400,130>
  property ^int32 Outlet = null;

  // The class 'AnalogDisplay' implements a widget to illustrate a value by using \
  // a rotating needle. 
  // The property 'CurrentValue' represents the momentary value of the gauge and \
  // corresponds to the position of the needle. The supported value range of the \
  // gauge can be defined by setting the properties 'MinValue' and 'MaxValue'.
  // Optinally, the widget displays a unit text in the center of the scale by using \
  // the property 'TextUnit' and it can display the scaling by using the properties \
  // 'TextScale0'...'TextScale5'.
  // A gauge can be connected with an Int32 'Outlet' property to show the current \
  // value of this property.
  note legend Note
  {
    attr Bounds = <10,450,720,630>;
  }
}

// The class 'PanelCarousel' arranges the different solar demo panels horizontally \
// and manages them as an endless carousel.
$rect <280,50,480,90>
$output false
class PanelCarousel : Core::Group
{
  $rect <820,10,1020,50>
  inherited property Bounds = <0,0,800,480>;

  $rect <820,60,1020,100>
  inherited method Init()
  {
    /* create the first panel at startup */
    ArrangeCarousel( new Solar::InfoPanel );

  }

  // The variable 'CenterPanel' refers to the currently visible panel.
  $rect <1020,180,1220,220>
  var Solar::Panel CenterPanel = null;

  // The variable 'LeftPanel' refers to the left neighbour of the currently visible \
  // panel.
  $rect <820,180,1020,220>
  var Solar::Panel LeftPanel = null;

  // The variable 'RightPanel' refers to the right neighbour of the currently visible \
  // panel.
  $rect <1220,180,1420,220>
  var Solar::Panel RightPanel = null;

  // This is a slide gesture handler.
  $rect <20,20,160,60>
  object Core::SlideTouchHandler SlideTouchHandler
  {
    preset Bounds = <0,0,800,480>;
    preset OnEnd = onEndAnimation;
    preset SnapNext = <800,0>;
    preset SlideVert = false;
    preset ResetSpace = 100;
  }

  // This is an outline view to group other views together.
  $rect <20,20,160,60>
  object Core::Outline Outline
  {
    preset Bounds = <0,0,800,480>;
    preset SlideHandler = SlideTouchHandler;
  }

  // This is a method.
  $rect <820,130,1020,170>
  method void ArrangeCarousel( arg Solar::Panel aCenterPanel )
  {
    /* remove all current panels */
    if ( LeftPanel != null )
    {
      Remove( LeftPanel );
      LeftPanel = null;
    }
    if ( CenterPanel != null )
    {
      Remove( CenterPanel );
      CenterPanel = null;
    }
    if ( RightPanel != null )
    {
      Remove( RightPanel );
      RightPanel = null;
    }

    /* create new left/right neighbours depending on type of center panel */
    if (( Solar::InfoPanel)aCenterPanel != null )
    {
      LeftPanel  = new Solar::YearPanel;
      RightPanel = new Solar::DigitalPanel;
    }
    else if (( Solar::DigitalPanel)aCenterPanel != null )
    {
      LeftPanel  = new Solar::InfoPanel;
      RightPanel = new Solar::AnalogPanel;
    }
    else if (( Solar::AnalogPanel)aCenterPanel != null )
    {
      LeftPanel  = new Solar::DigitalPanel;
      RightPanel = new Solar::PowerPanel;
    }
    else if (( Solar::PowerPanel)aCenterPanel != null )
    {
      LeftPanel  = new Solar::AnalogPanel;
      RightPanel = new Solar::IntradayPanel;
    }
    else if (( Solar::IntradayPanel)aCenterPanel != null )
    {
      LeftPanel  = new Solar::PowerPanel;
      RightPanel = new Solar::MonthPanel;
    }
    else if (( Solar::MonthPanel)aCenterPanel != null )
    {
      LeftPanel  = new Solar::IntradayPanel;
      RightPanel = new Solar::YearPanel;
    }
    else if (( Solar::YearPanel)aCenterPanel != null )
    {
      LeftPanel  = new Solar::MonthPanel;
      RightPanel = new Solar::InfoPanel;
    }

    /* store the center panel */
    CenterPanel = aCenterPanel;

    /* now arrange the three panels and reset the outline */
    LeftPanel.Bounds = <-800,0,0,480>;
    CenterPanel.Bounds = <0,0,800,480>;
    RightPanel.Bounds = <800,0,1600,480>;
    Outline.ScrollOffset = <0,0>;

    /* set all three panels to embedded in order to arrange them by the outline box */
    LeftPanel.Embedded = true;
    CenterPanel.Embedded = true;
    RightPanel.Embedded = true;

    /* add the three panels to this UI component */
    Add( LeftPanel, 0 );
    Add( CenterPanel, 0 );
    Add( RightPanel, 0 );

    /* start the build-up animation of the panel (if any) */
    CenterPanel.Unlock();

  }

  // Slot method to react on the end of a slide animation.
  $rect <820,240,1020,280>
  slot onEndAnimation
  {
    /* choose new center panel according current outline position */
    if ( Outline.ScrollOffset.x < -400 )
      ArrangeCarousel( RightPanel );
    if ( Outline.ScrollOffset.x > 400 )
      ArrangeCarousel( LeftPanel );



  }

  // This is a move point effect used by the outline box to get a smooth scrolling \
  // between the screens.
  $rect <820,300,1020,340>
  object Effects::PointEffect PointEffect
  {
    preset Timing = Effects::Timing.FastIn_EaseOut;
    preset CycleDuration = 500;
  }

  // The class 'PanelCarousel' manages the different panels of the solar demo. It \
  // arranges the panels in a horizontally order, so that the user can navigate through \
  // the pages by a left/right key input or by a horizontal slide gesture.
  // 
  // The method ArrangeCarousel() creates the left and the right neighbor of the \
  // current center panel. This makes it possible, that the user can slide to the \
  // left or to the right side and the panels will follow the finger. The three panels \
  // are managed by an outline box and a slide touch handler. After the slide animation \
  // has finished, the left/right neighbors are created again. By using this approach, \
  // it is possible to implement an endless list of items (carousel).
  note legend Note
  {
    attr Bounds = <0,500,800,690>;
  }

  // How to manage scrollable content within an outline box?
  // 
  // https://doc.embedded-wizard.de/outline-box
  note legend Note5
  {
    attr Bounds = <820,500,1200,580>;
  }

  // This is a key press handler.
  $rect <820,350,1020,390>
  object Core::KeyPressHandler KeyHandler
  {
    preset OnPress = KeySlot;
    preset Filter = Core::KeyCode.CursorKeys;
  }

  // This is a slot method.
  $rect <820,390,1020,430>
  slot KeySlot
  {
    /* start the transition with the desired direction */
    if ( KeyHandler.Code == Core::KeyCode.Left )
      Outline.EnsureVisible( LeftPanel, true, PointEffect, onEndAnimation );
    else if ( KeyHandler.Code == Core::KeyCode.Right )
      Outline.EnsureVisible( RightPanel, true, PointEffect, onEndAnimation );

  }

  // Slot method to switch to the next panel during the auto demo.
  $rect <820,440,1020,480>
  slot OnTriggerAutoDemo
  {
    /* start animation to show the right panel */
    Outline.EnsureVisible( RightPanel, true, PointEffect, onEndAnimation );

  }
}

// This class implements the interface between the GUI application and the device.
$rect <30,560,230,600>
$output false
class DeviceClass
{
  // The property 'SolarPower' represents the solar power in watt.
  $rect <220,60,420,100>
  property int32 SolarPower = 0;

  // This method is intended to be called by the device to notify the GUI application \
  // about an alternation of its setting or state value.
  $rect <20,60,220,100>
  $output true
  method void UpdateSolarPower( arg int32 aNewValue )
  {
    // Only if the reported value does differ from the one stored currently in the property.
    if ( aNewValue != pure SolarPower )
    {
      // Remember the new value in the internal memory of the property.
      pure SolarPower = aNewValue;

      // Notify all associated property observers.
      notifyobservers ^SolarPower;
    }
  }

  // Data interface of the solar inverter
  note group Note1
  {
    attr Bounds = <10,10,440,420>;
  }

  // The property 'SolarVoltage' represents the solar voltage in volt.
  $rect <220,100,420,140>
  property int32 SolarVoltage = 0;

  // This method is intended to be called by the device to notify the GUI application \
  // about an alternation of its setting or state value.
  $rect <20,100,220,140>
  $output true
  method void UpdateSolarVoltage( arg int32 aNewValue )
  {
    // Only if the reported value does differ from the one stored currently in the property.
    if ( aNewValue != pure SolarVoltage )
    {
      // Remember the new value in the internal memory of the property.
      pure SolarVoltage = aNewValue;

      // Notify all associated property observers.
      notifyobservers ^SolarVoltage;
    }
  }

  // The property 'SolarCurrent' represents the solar current in milliampere.
  $rect <220,140,420,180>
  property int32 SolarCurrent = 0;

  // This method is intended to be called by the device to notify the GUI application \
  // about an alternation of its setting or state value.
  $rect <20,140,220,180>
  $output true
  method void UpdateSolarCurrent( arg int32 aNewValue )
  {
    // Only if the reported value does differ from the one stored currently in the property.
    if ( aNewValue != pure SolarCurrent )
    {
      // Remember the new value in the internal memory of the property.
      pure SolarCurrent = aNewValue;

      // Notify all associated property observers.
      notifyobservers ^SolarCurrent;
    }
  }

  // The property 'InverterPower' represents the resulting power of the solar inverter \
  // in watt.
  $rect <220,190,420,230>
  property int32 InverterPower = 0;

  // This method is intended to be called by the device to notify the GUI application \
  // about an alternation of its setting or state value.
  $rect <20,190,220,230>
  $output true
  method void UpdateInverterPower( arg int32 aNewValue )
  {
    // Only if the reported value does differ from the one stored currently in the property.
    if ( aNewValue != pure InverterPower )
    {
      // Remember the new value in the internal memory of the property.
      pure InverterPower = aNewValue;

      // Notify all associated property observers.
      notifyobservers ^InverterPower;
    }
  }

  // The property 'InverterVoltage' represents the solar inverter voltage in volt.
  $rect <220,230,420,270>
  property int32 InverterVoltage = 0;

  // This method is intended to be called by the device to notify the GUI application \
  // about an alternation of its setting or state value.
  $rect <20,230,220,270>
  $output true
  method void UpdateInverterVoltage( arg int32 aNewValue )
  {
    // Only if the reported value does differ from the one stored currently in the property.
    if ( aNewValue != pure InverterVoltage )
    {
      // Remember the new value in the internal memory of the property.
      pure InverterVoltage = aNewValue;

      // Notify all associated property observers.
      notifyobservers ^InverterVoltage;
    }
  }

  // The property 'InverterCurrent' represents the solar inverter current in milliampere.
  $rect <220,270,420,310>
  property int32 InverterCurrent = 0;

  // This method is intended to be called by the device to notify the GUI application \
  // about an alternation of its setting or state value.
  $rect <20,270,220,310>
  $output true
  method void UpdateInverterCurrent( arg int32 aNewValue )
  {
    // Only if the reported value does differ from the one stored currently in the property.
    if ( aNewValue != pure InverterCurrent )
    {
      // Remember the new value in the internal memory of the property.
      pure InverterCurrent = aNewValue;

      // Notify all associated property observers.
      notifyobservers ^InverterCurrent;
    }
  }

  // The property 'Runtime' represents the operating hours of the solar inverter.
  $rect <220,320,420,360>
  property int32 Runtime = 1854357;

  // This method is intended to be called by the device to notify the GUI application \
  // about an alternation of its setting or state value.
  $rect <20,320,220,360>
  $output true
  method void UpdateRuntime( arg int32 aNewValue )
  {
    // Only if the reported value does differ from the one stored currently in the property.
    if ( aNewValue != pure Runtime )
    {
      // Remember the new value in the internal memory of the property.
      pure Runtime = aNewValue;

      // Notify all associated property observers.
      notifyobservers ^Runtime;
    }
  }

  // The property 'EnergyYield' represents the total energy yield in kWh of the solar \
  // inverter.
  $rect <220,370,420,410>
  property int32 EnergyYield = 2384250;

  // This method is intended to be called by the device to notify the GUI application \
  // about an alternation of its setting or state value.
  $rect <20,370,220,410>
  $output true
  method void UpdateEnergyYield( arg int32 aNewValue )
  {
    // Only if the reported value does differ from the one stored currently in the property.
    if ( aNewValue != pure EnergyYield )
    {
      // Remember the new value in the internal memory of the property.
      pure EnergyYield = aNewValue;

      // Notify all associated property observers.
      notifyobservers ^EnergyYield;
    }
  }

  // This is a timer object.
  $rect <460,60,660,100>
  object Core::Timer SimulationTimer
  {
    preset OnTrigger = SimulationSlot;
    preset Period = 500;
    preset Enabled = true;
  }

  // This is a slot method.
  $rect <660,60,860,100>
  slot SimulationSlot
  {
    /* create some solar voltage and current values */
    var int32 u = SolarVoltage + math_rand( -7, 8 );
    var int32 i = SolarCurrent + math_rand( -199, 200 );
    var int32 p;

    /* limit voltage between 300V and 400V */
    if ( u < 300 )
      u = 300;
    if ( u > 400 )
      u = 400;

    /* limit current between 5A and 6A */
    if ( i < 5000 )
      i = 5000;
    if ( i > 6000 )
      i = 6000;

    /* calculate power in W */
    p = u * i / 1000;

    /* update solar values */
    UpdateSolarVoltage( u );
    UpdateSolarCurrent( i );
    UpdateSolarPower( p ); 

    /* assume the inverter has 95% efficiency */
    p = p * 95 / 100;
    u = 230;
    i = p * 1000 / u;

    /* update inverter values */
    UpdateInverterVoltage( u );
    UpdateInverterCurrent( i );
    UpdateInverterPower( p ); 

    /* update runtime and yield */
    Counter = Counter + 1;
    if (( Counter % 8 ) == 0 )
      UpdateEnergyYield( EnergyYield + 1 );
    if (( Counter % 10 ) == 0 )
      UpdateRuntime( Runtime + 1 );


  }

  // This is a variable.
  $rect <660,100,860,140>
  var int32 Counter = 0;

  // Simulation of solar inverter data
  note group Note2
  {
    attr Bounds = <450,10,870,150>;
  }

  // This is the data interface class of the solar inverter device.
  // Within a real system the underlying device driver will update the different \
  // properties by calling the corresponding 'Update' methods.
  // Within this demo application a timer driven simulation animates the properties.
  note legend Note
  {
    attr Bounds = <450,160,870,300>;
  }

  // How to integrate your UI application with a real device?
  // 
  // https://doc.embedded-wizard.de/integrating-with-the-device
  // https://doc.embedded-wizard.de/device-class-and-device-driver
  note legend Note5
  {
    attr Bounds = <450,310,870,420>;
  }
}

// This object represents an instance of the device interface implemented in the \
// class Solar::DeviceClass.
$rect <30,600,230,640>
autoobject Solar::DeviceClass Device;

// The class 'DeviceClass' implements the interface between the GUI application and \
// the solar inverter device.
// The object 'Device' represents the instance of the device interface. It exists \
// for convenience. As an autoobject it is globaly available for all GUI components \
// within the project.
note legend Note
{
  attr Bounds = <10,670,500,790>;
}

// Solar Demo Panels
note group Note1
{
  attr Bounds = <10,10,250,510>;
}

// Solar Demo Widgets
note group Note2
{
  attr Bounds = <260,120,1130,510>;
}

// Panel Carousel
note group Note3
{
  attr Bounds = <260,10,500,110>;
}

// Device Class
note group Note4
{
  attr Bounds = <10,520,250,660>;
}

// The class 'PanelCarousel' arranges the different solar demo panels horizontally \
// and manages them as an endless carousel.
// The user can slide through the different panels by left/right key or by a simple \
// slide touch gesture.
note legend Note5
{
  attr Bounds = <510,10,950,110>;
}

// A set of digital and analog instruments are implemented as independent UI components \
// (widgets) with their own specific look and feel.
// The widgets can be configured by a set of properties and they are used to build \
// up the different solar demo panels.
note legend Note6
{
  attr Bounds = <600,520,1130,630>;
}

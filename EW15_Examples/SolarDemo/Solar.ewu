$version 15.00

// The panel class is used as base class for all display panels of the GUI application.
$rect <30,50,230,90>
$output false
class Panel : Core::Group
{
  $rect <820,0,1020,40>
  inherited property Bounds = <0,0,800,480>;

  // This is an simple image view.
  $rect <20,20,160,60>
  object Views::Image Background
  {
    preset Bounds = <0,0,800,480>;
    preset AutoSize = true;
    preset Bitmap = SolarRes::Background;
    preset AlphaBlended = false;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text CaptionText
  {
    preset Bounds = <30,10,770,60>;
    preset Alignment = Views::TextAlignment[AlignHorzRight, AlignVertCenter];
    preset String = "Solar Demo";
    preset Font = SolarRes::CaptionFont;
    preset Color = SolarRes::CaptionColor;
  }

  // The method 'Unlock' is used to start some build-up effects in derived panels.
  $rect <820,50,1020,90>
  method void Unlock()
  {
    //Buffered = false;
  }

  // The class 'Panel' is used as base class for all panels of the solar demo.
  // It contains the background image and a caption.
  note legend Note
  {
    attr Bounds = <10,500,800,570>;
  }
}

//  The class 'YearPanel' display the overall energy yield for all months of one \
// year. The animated bars are drawen by using the class 'MeteringBar'.
$rect <30,250,230,290>
$output false
class YearPanel : Solar::Panel
{
  $rect <20,20,160,60>
  inherited object CaptionText
  {
    preset String = "Annual Statistics";
  }

  $rect <820,10,1020,50>
  inherited method Unlock()
  {
    super();

    /* start the build up animation... */
    AnimationTimer.Enabled = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text YearText
  {
    preset Bounds = <30,10,170,60>;
    preset Alignment = Views::TextAlignment[AlignHorzCenter, AlignVertCenter];
    preset String = "2018";
    preset Font = SolarRes::CaptionFont;
    preset Color = SolarRes::TextColor;
  }

  // This is a timer object.
  $rect <10,510,210,550>
  object Core::Timer AnimationTimer
  {
    preset OnTrigger = AnimationSlot;
    preset Period = 100;
  }

  // This is a slot method.
  $rect <210,510,410,550>
  slot AnimationSlot
  {
    /* please note: instead of reading data from a real solar power system
       only a few dummy data are calculated for displaying them within this 
       solar demo application */

    Counter = Counter + 1;

    switch ( Counter )
    {
      case 1: 
      {
        YieldBar1.MaxValue = 100;
        YieldBar1.SetValue = 30;
        YieldBar1.ActualValue = 35;
      }
      case 2: 
      {
        YieldBar2.MaxValue = 100;
        YieldBar2.SetValue = 30;
        YieldBar2.ActualValue = 38;
      }
      case 3: 
      {
        YieldBar3.MaxValue = 100;
        YieldBar3.SetValue = 40;
        YieldBar3.ActualValue = 50;
      }
      case 4: 
      {
        YieldBar4.MaxValue = 100;
        YieldBar4.SetValue = 65;
        YieldBar4.ActualValue = 66;
      }
      case 5: 
      {
        YieldBar5.MaxValue = 100;
        YieldBar5.SetValue = 80;
        YieldBar5.ActualValue = 81;
      }
      case 6: 
      {
        YieldBar6.MaxValue = 100;
        YieldBar6.SetValue = 90;
        YieldBar6.ActualValue = 89;
      }
      case 7: 
      {
        YieldBar7.MaxValue = 100;
        YieldBar7.SetValue = 90;
        YieldBar7.ActualValue = 96;
      }
      case 8: 
      {
        YieldBar8.MaxValue = 100;
        YieldBar8.SetValue = 80;
        YieldBar8.ActualValue = 82;
      }
      case 9: 
      {
        YieldBar9.MaxValue = 100;
        YieldBar9.SetValue = 65;
        YieldBar9.ActualValue = 75;
      }
      case 10: 
      {
        YieldBar10.MaxValue = 100;
        YieldBar10.SetValue = 45;
        YieldBar10.ActualValue = 35;
      }
      case 11: 
      {
        YieldBar11.MaxValue = 100;
        YieldBar11.SetValue = 30;
        YieldBar11.ActualValue = 28;
      }
      case 12: 
      {
        YieldBar12.MaxValue = 100;
        YieldBar12.SetValue = 12;
        YieldBar12.ActualValue = 10;
      }
      default:
        AnimationTimer.Enabled = false;
    }


  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar1
  {
    preset Bounds = <20,100,60,470>;
    preset Caption = Resources::JanuaryAbbr;
  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar2
  {
    preset Bounds = <85,100,125,470>;
    preset Caption = Resources::FebruaryAbbr;
  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar3
  {
    preset Bounds = <150,100,190,470>;
    preset Caption = Resources::MarchAbbr;
  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar4
  {
    preset Bounds = <215,100,255,470>;
    preset Caption = Resources::AprilAbbr;
  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar5
  {
    preset Bounds = <280,100,320,470>;
    preset Caption = Resources::MayAbbr;
  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar6
  {
    preset Bounds = <345,100,385,470>;
    preset Caption = Resources::JuneAbbr;
  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar7
  {
    preset Bounds = <410,100,450,470>;
    preset Caption = Resources::JulyAbbr;
  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar8
  {
    preset Bounds = <475,100,515,470>;
    preset Caption = Resources::AugustAbbr;
  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar9
  {
    preset Bounds = <540,100,580,470>;
    preset Caption = Resources::SeptemberAbbr;
  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar10
  {
    preset Bounds = <605,100,645,470>;
    preset Caption = Resources::OctoberAbbr;
  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar11
  {
    preset Bounds = <670,100,710,470>;
    preset Caption = Resources::NovemberAbbr;
  }

  $rect <20,20,160,60>
  object Solar::MeteringBar YieldBar12
  {
    preset Bounds = <735,100,775,470>;
    preset Caption = Resources::DecemberAbbr;
  }

  // This is a variable.
  $rect <410,510,610,550>
  var int32 Counter = 0;

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text DescrText
  {
    preset Bounds = <340,80,770,120>;
    preset Alignment = Views::TextAlignment[AlignHorzRight, AlignVertCenter];
    preset String = "Energy Yield per Month in kWh";
    preset Font = SolarRes::TextFont;
    preset Color = SolarRes::TextColor;
  }

  // The class 'YearPanel' display the overall energy yield for all months of one \
  // year. The animated bars are drawn by using the class 'Solar::MeteringBar'.
  // As soon as this panel is unlocked, the timer driven animation provides some \
  // random data for the metering bars.
  note legend Note
  {
    attr Bounds = <10,560,800,640>;
  }
}

// The class 'MeteringBar' implements a graphical bar for displaying a metering value. \
// When the metering bar is shown, a simple damped vibration creates a nice build-up \
// effect.
$rect <280,250,480,290>
$output false
class MeteringBar : Core::Group
{
  $rect <90,0,290,40>
  inherited property Bounds = <0,0,40,370>;

  $rect <300,0,500,40>
  inherited method UpdateViewState()
  {
    aState;

    /* decide if we have to display a red or a green bar */
    if ( ActualValue >= SetValue )
      Frame.Bitmap = SolarRes::MeteringBarGreen;
    else
      Frame.Bitmap = SolarRes::MeteringBarRed;

    postsignal AnimationSlot;

  }

  // This is a simple filled rectangle object.
  $rect <20,20,160,60>
  object Views::Rectangle Rectangle
  {
    preset Layout = Core::Layout[AlignToBottom, AlignToLeft, AlignToRight, AlignToTop, ResizeHorz, ResizeVert];
    preset Bounds = <0,230,40,370>;
    preset Color = #40404080;
    preset Visible = false;
  }

  // This is a frame view.
  $rect <20,20,160,60>
  object Views::Frame Frame
  {
    preset Layout = Core::Layout[AlignToBottom, AlignToLeft, AlignToRight, AlignToTop, ResizeVert];
    preset Bounds = <8,40,32,370>;
    preset Bitmap = SolarRes::MeteringBarGreen;
    preset Visible = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text DescrText
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToRight, AlignToTop, ResizeHorz];
    preset Bounds = <0,0,40,20>;
    preset Alignment = Views::TextAlignment[AlignHorzCenter, AlignVertTop];
    preset String = "Text";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = false;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text ValueText
  {
    preset Layout = Core::Layout[AlignToLeft, AlignToRight, AlignToTop, ResizeHorz];
    preset Bounds = <0,20,40,40>;
    preset Alignment = Views::TextAlignment[AlignHorzCenter, AlignVertTop];
    preset String = "1234";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = false;
  }

  // The property 'MaxValue' defines the maximum range of the metering bar.
  $rect <90,50,290,90>
  property int32 MaxValue = 0;

  // The onset method of the property 'MaxValue' changes the maximum range of the \
  // metering bar.
  $rect <300,50,500,90>
  onset MaxValue
  {
    /* avoid negative values */
    if ( value < 0 )
      value = 0;

    pure MaxValue = value;

    /* check other values to keep them in range */
    if ( SetValue > MaxValue )
      SetValue = MaxValue;
    if ( ActualValue > MaxValue )
      pure ActualValue = MaxValue;

    /* finally, force an update of the component */
    InvalidateViewState();

  }

  // The property 'SetValue' defines the expected nominal value.
  $rect <90,90,290,130>
  property int32 SetValue = 0;

  // The onset method for the property 'SetValue'.
  $rect <300,90,500,130>
  onset SetValue
  {
    /* check limits of the value */
    if ( value < 0 )
      value = 0;
    if ( value > MaxValue )
      value = MaxValue;

    pure SetValue = value;

    /* finally, force an update of the component */
    InvalidateViewState();

  }

  // The property 'ActualValue' defines the actual metering value.
  $rect <90,130,290,170>
  property int32 ActualValue = 0;

  // The onset method for the property 'ActualValue'.
  $rect <300,130,500,170>
  onset ActualValue
  {
    /* check limits of the value */
    if ( value < 0 )
      value = 0;
    if ( value > MaxValue )
      value = MaxValue;

    /* check for news... */
    if ( value == pure ActualValue )
      return;

    /* now take the new value */
    pure ActualValue = value;

    /* in case that the value is set the first time, we start a nice animation... */
    if ( AnimationCounter == 0 )
      AnimationTimer.Enabled = true;

    /* finally, force an update of the component */
    InvalidateViewState();

  }

  // The slot method 'Update' performs the build-up effect of the metereing bar.
  $rect <90,260,290,300>
  slot AnimationSlot
  {
    var int32 y = 0;

    /* in case that the end value is already reached, set the final arrangement */
    if ( AnimationCounter == AnimationArray.size )
    {
      AnimationTimer.Enabled = false;
      
      /* calculate the size of the bar in pixel */
      if ( MaxValue > 0 )
        y = ( Bounds.size.y - 40 ) * ActualValue / MaxValue;

      /* avoid to small bar */
      if ( y < 32 ) 
        y = 32;

      /* set position of bar */
      Frame.Bounds.y1 = Bounds.size.y - y;

      /* ensure to display the right value */
      ValueText.String = string( ActualValue );
      
      /* calculate the best position for the text fields */
      if ( SetValue > ActualValue )
        y = ( Bounds.size.y - 40 ) * SetValue / MaxValue;

      ValueText.Bounds.origin.y = Bounds.size.y - y - 20;
      DescrText.Bounds.origin.y = Bounds.size.y - y - 40;
      ValueText.Visible = true;
      DescrText.Visible = true;

      /* draw a rectangle to indicate the expected set value */
      if (( MaxValue > 0 ) && ( SetValue > 0 ))
      {
        y = ( Bounds.size.y - 40 ) * SetValue / MaxValue;
        Rectangle.Bounds.y1 = Bounds.size.y - y;
        Rectangle.Visible = true;
      }
    }
    else if ( AnimationCounter == 0 )
    {
      Frame.Bounds.y1 = Frame.Bounds.y2;
    }

    /* otherwise the next step of animation is requested */
    else
    {
      /* calculate the size of the bar in pixel */
      if ( MaxValue > 0 )
        y = ( Bounds.size.y - 40 ) * ActualValue / MaxValue * AnimationArray[ AnimationCounter ] / 1000;

      /* avoid to small bar */
      if ( y < 32 ) 
        y = 32;

      /* set position of bar and text fields */
      Frame.Bounds.y1 = Bounds.size.y - y;
    }

    if ( AnimationTimer.Enabled )
      AnimationCounter = AnimationCounter + 1;




  }

  // This is a timer object to drive the build-up effect.
  $rect <90,220,290,260>
  object Core::Timer AnimationTimer
  {
    preset OnTrigger = AnimationSlot;
    preset Period = 25;
  }

  // The variable 'AnimationCounter' stores the currently active step of the build-up \
  // effect.
  $rect <300,220,500,260>
  var int32 AnimationCounter = 0;

  // Array of precalculated values for the damped vibration (harmonic oscillation).
  $rect <300,260,500,300>
  array int32 AnimationArray[ 60 ] =
  (
    Default[0] = 100;
    Default[1] = 300;
    Default[2] = 440;
    Default[3] = 570;
    Default[4] = 690;
    Default[5] = 800;
    Default[6] = 900;
    Default[7] = 990;
    Default[8] = 1070;
    Default[9] = 1130;
    Default[10] = 1180;
    Default[11] = 1200;
    Default[12] = 1210;
    Default[13] = 1190;
    Default[14] = 1160;
    Default[15] = 1120;
    Default[16] = 1080;
    Default[17] = 1020;
    Default[18] = 970;
    Default[19] = 920;
    Default[20] = 890;
    Default[21] = 870;
    Default[22] = 860;
    Default[23] = 870;
    Default[24] = 890;
    Default[25] = 920;
    Default[26] = 960;
    Default[27] = 1000;
    Default[28] = 1030;
    Default[29] = 1050;
    Default[30] = 1070;
    Default[31] = 1080;
    Default[32] = 1090;
    Default[33] = 1080;
    Default[34] = 1070;
    Default[35] = 1050;
    Default[36] = 1030;
    Default[37] = 1010;
    Default[38] = 990;
    Default[39] = 970;
    Default[40] = 960;
    Default[41] = 950;
    Default[42] = 940;
    Default[43] = 950;
    Default[44] = 960;
    Default[45] = 970;
    Default[46] = 990;
    Default[47] = 1000;
    Default[48] = 1010;
    Default[49] = 1015;
    Default[50] = 1018;
    Default[51] = 1020;
    Default[52] = 1018;
    Default[53] = 1015;
    Default[54] = 1010;
    Default[55] = 1005;
    Default[56] = 1003;
    Default[57] = 1001;
    Default[58] = 1000;
    Default[59] = 1000;
  );

  // The property 'Caption' contains the title of the metering bar.
  $rect <90,170,290,210>
  property string Caption = "";

  // The onset method for the property 'Caption' contains changes the title of the \
  // metering bar.
  $rect <300,170,500,210>
  onset Caption
  {
    pure Caption = value;
    DescrText.String = value;
  }

  // The class 'MeteringBar' implements a graphical bar for displaying a metering \
  // value. When the metering bar is shown, a simple damped vibration creates a nice \
  // build-up effect.
  note legend Note
  {
    attr Bounds = <90,320,500,430>;
  }
}

// The class 'MonthPanel' displays the energy yield per day during the last 30 days.
$rect <30,200,230,240>
$output false
class MonthPanel : Solar::Panel
{
  $rect <20,20,160,60>
  inherited object CaptionText
  {
    preset String = "Last 30 Days";
  }

  $rect <820,10,1020,50>
  inherited method Unlock()
  {
    super();

    /* start the build up animation... */
    AnimationTimer.Enabled = true;
  }

  // This is a timer object.
  $rect <10,510,210,550>
  object Core::Timer AnimationTimer
  {
    preset OnTrigger = AnimationSlot;
    preset Period = 50;
  }

  // This is a slot method.
  $rect <210,510,410,550>
  slot AnimationSlot
  {
    /* please note: instead of reading data from a real solar power system
       only a few dummy data are calculated for displaying them within this 
       solar demo application */

    var int32 left   = 10;
    var int32 bottom = 470;
    var int32 height = 350;
    var int32 right  = 765;
    var int32 deltaX = 25;

    var int32 maxValue = 100;
    var int32 actValue = math_rand( 10, 90 );

    var int32 x;
    var int32 y = 0;
    var rect rStart;
    var rect rEnd;


    /* calculate the final height of the bar in pixel */
    if ( maxValue > 0 )
      y = height * actValue / maxValue;

    /* avoid to small bar */
    if ( y < 20 ) 
      y = 20;

    /* calculate start position of bar in horizontal direction */
    x = right - DayCounter * deltaX + 5;

    /* now lets define the final rectangle */
    rEnd = rect( x, bottom - y, x + 15, bottom );

    /* and let's find a start rectangle */
    x = left;//math_rand( left, right );
    rStart = rect( x, 0, x + 15, 0 );

    /* create the bar object */
    var Views::Frame frame = new Views::Frame;
    frame.Bitmap = SolarRes::MeteringBarYellow;
    frame.Bounds = rStart;

    /* add the frame object to make it visible */
    Add( frame, 0 );

    /* create an animation timer */
    var Effects::RectEffect effect = new Effects::RectEffect;
    effect.Outlet = ^frame.Bounds;
    effect.Timing = Effects::Timing.FastIn_EaseOut;
    effect.Enabled = true;
    effect.NoOfCycles = 1;
    effect.CycleDuration = 500;
    effect.Value1 = rStart;
    effect.Value2 = rEnd;

    /* store the effect in order to avoid that the GC removes it... */
    if ( DayCounter < EffectArray.size )
      EffectArray[ DayCounter ] = effect;

    /* until all 30 days are shown... */
    DayCounter = DayCounter + 1;
    if ( DayCounter == 30 )
      AnimationTimer.Enabled = false;


  }

  // This is a variable.
  $rect <410,510,610,550>
  var int32 DayCounter = 0;

  // This is an array.
  $rect <610,510,810,550>
  array Effects::RectEffect EffectArray[ 30 ];

  // This is a simple line view.
  $rect <20,20,160,60>
  object Views::Line Line1
  {
    preset Point2 = <779,399>;
    preset Point1 = <50,399>;
    preset Color = #B0B0B3FF;
    preset AlphaBlended = false;
  }

  // This is a simple line view.
  $rect <20,20,160,60>
  object Views::Line Line2
  {
    preset Point2 = <779,329>;
    preset Point1 = <50,329>;
    preset Color = #B0B0B3FF;
    preset AlphaBlended = false;
  }

  // This is a simple line view.
  $rect <20,20,160,60>
  object Views::Line Line3
  {
    preset Point2 = <779,260>;
    preset Point1 = <50,260>;
    preset Color = #B0B0B3FF;
    preset AlphaBlended = false;
  }

  // This is a simple line view.
  $rect <20,20,160,60>
  object Views::Line Line4
  {
    preset Point2 = <779,190>;
    preset Point1 = <50,190>;
    preset Color = #B0B0B3FF;
    preset AlphaBlended = false;
  }

  // This is a simple line view.
  $rect <20,20,160,60>
  object Views::Line Line5
  {
    preset Point2 = <779,120>;
    preset Point1 = <50,120>;
    preset Color = #B0B0B3FF;
    preset AlphaBlended = false;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text ValueText1
  {
    preset Bounds = <10,380,40,400>;
    preset Alignment = Views::TextAlignment[AlignHorzRight, AlignVertBottom];
    preset String = "20";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text ValueText2
  {
    preset Bounds = <10,310,40,330>;
    preset Alignment = Views::TextAlignment[AlignHorzRight, AlignVertBottom];
    preset String = "40";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text ValueText3
  {
    preset Bounds = <10,240,40,260>;
    preset Alignment = Views::TextAlignment[AlignHorzRight, AlignVertBottom];
    preset String = "60";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text ValueText4
  {
    preset Bounds = <10,170,40,190>;
    preset Alignment = Views::TextAlignment[AlignHorzRight, AlignVertBottom];
    preset String = "80";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text ValueText5
  {
    preset Bounds = <10,100,40,120>;
    preset Alignment = Views::TextAlignment[AlignHorzRight, AlignVertBottom];
    preset String = "100";
    preset Font = SolarRes::DescrFont;
    preset Color = SolarRes::DescrColor;
    preset Visible = true;
  }

  // This is a text object.
  $rect <20,20,160,60>
  object Views::Text DescrText
  {
    preset Bounds = <340,80,770,120>;
    preset Alignment = Views::TextAlignment[AlignHorzRight, AlignVertCenter];
    preset String = "Energy Yield per Day in kWh";
    preset Font = SolarRes::TextFont;
    preset Color = SolarRes::TextColor;
  }

  // The class 'MonthPanel' displays the energy yield per day during the last 30 \
  // days.
  // As soon as this panel is unlocked, the timer driven animation provides some \
  // random data for the data display.
  note legend Note
  {
    attr Bounds = <10,560,800,640>;
  }
}

// The class 'DataPlotter' implements the simulation of a data plotter that writes \
// metered values with a pen on a moving paper.
$rect <280,450,480,490>
$output false
class DataPlotter : Core::Group
{
  $rect <340,0,540,40>
  inherited property Bounds = <0,0,320,340>;

  $rect <340,40,540,80>
  inherited method UpdateViewState()
  {
    aState;

    /* create canvas if necessary */
    if ( Canvas == null )
      InitPlotter();

    /* arrange items in case of composer */
    $if $composer
    PaperImage.Visible = true;
    PaperImage.Bounds.origin.x = Bounds.w - PaperImage.Bounds.w;
    PaperFirstImage.Visible = true;
    PaperFirstImage.Bounds.origin.x = Bounds.w - PaperImage.Bounds.w - PaperFirstImage.Bounds.w;
    Needle.Visible = true;
    Needle.Bounds.origin.x = Bounds.w - Needle.Bounds.w;
    $endif


  }

  // The variable 'Canvas' stores the internal bitmap used to prepare all drawing \
  // operations.
  $rect <10,360,210,400>
  var Graphics::Canvas Canvas = null;

  // The method 'DrawPenLine' is called to draw a line at the given horizontal position \
  // 'aX' from the vertical start position 'aY1' to the end position 'aY2'.
  $rect <430,440,630,480>
  method void DrawPenLine( arg color aColor, arg int32 aX, arg int32 aY1, arg int32 aY2 )
  {
    var int32 y1;
    var int32 y2;
    var rect  r;
    var color c;

    /* just to be sure... */
    if ( Canvas == null )
      return;

    /* sort the give y values */
    if ( aY1 < aY2 )
    {
      y1 = aY1;
      y2 = aY2;
    }  
    else
    {
      y1 = aY2;
      y2 = aY1;
    }  

    /* draw a little bit arround the pen to unsharpen the pen */
    c = color( aColor.red, aColor.green, aColor.blue, 0x40 );
    r = rect( aX - 1, y1, aX + 2, y2 + 1 );
    Canvas.FillRectangle( Clipping, r, c, c, c, c, true );

    r = rect( aX, y1 - 1, aX + 1, y2 + 2 );
    Canvas.FillRectangle( Clipping, r, c, c, c, c, true );

    /* draw the center point of the pen */
    c = color( aColor.red, aColor.green, aColor.blue, 0x80 );
    r = rect( aX, y1, aX + 1, y2 + 1 );
    Canvas.FillRectangle( Clipping, r, c, c, c, c, true );

  }

  // The variable 'Clipping' contains the clipping area used for all drawing operations \
  // within the Canvas.
  $rect <10,400,210,440>
  var rect Clipping = <0,0,0,0>;

  // The variable 'LastValue' stores the current position of the simulated pen in \
  // vertical direction.
  $rect <220,440,420,480>
  var int32 LastValue = 0;

  // The property 'PenColor' stores the color value of the simulated pen used for \
  // drawing the data channel.
  $rect <340,110,540,150>
  property color PenColor = #000080FF;

  // The onset method for the property 'PenColor' changes the color of the simulated \
  // pen used for drawing the data channel.
  $rect <540,110,740,150>
  onset PenColor
  {
    /* check if the given value differs from the current value */
    if ( pure PenColor == value )
      return;

    /* assign the color */
    pure PenColor = value;

    /* ...and finally, force an update */
    InvalidateViewState();
  }

  // The method 'AddSamples' is called to feed new data into the simulated plotter.
  $rect <430,360,630,400>
  method void AddSample( arg int32 aData )
  {
    /* accumulate the sample in SampleStorage */
    if ( NoOfStoredSamples < SamplesPerUpdate )
    {
      if ( aData > MaxValue )
        aData = MaxValue;
      if ( aData < MinValue )
        aData = MinValue;
      SampleStorage[ NoOfStoredSamples ] = aData;
      NoOfStoredSamples = NoOfStoredSamples + 1;
    }

    /* in case that enough samples are collected, let's draw the samples... */
    if ( NoOfStoredSamples >= SamplesPerUpdate )
      DrawSamples();



  }

  // The variable 'PaperPosition' contains the total offset of the paper in pixel. \
  // The variable is used to copy the paper pattern to the right location.
  $rect <10,440,210,480>
  var int32 PaperPosition = 0;

  // The property 'MaxValue' stores the upper level of the data range.
  $rect <340,190,540,230>
  property int32 MaxValue = 0;

  // The onset method for the property 'MaxValue' changes the maximum data value.
  $rect <540,190,740,230>
  onset MaxValue
  {
    /* check if the given value differs from the current value */
    if ( pure MaxValue == value )
      return;

    /* ensure that maximum value is positive */
    if ( value < 1 )
      value = 1;

    /* store the new value */
    pure MaxValue = value;

    /* ...and finally, force an update */
    InvalidateViewState();
  }

  // The property 'SamplesPerUpdate' defines the number of samples that has to be \
  // added until a redraw happens.
  $rect <340,230,540,270>
  property int32 SamplesPerUpdate = 1;

  // The onset method for the property 'SamplesPerUpdate' changes the number of samples \
  // that have to be added until they are drawn.
  $rect <540,230,740,270>
  onset SamplesPerUpdate
  {
    /* check if the given value differs from the current value */
    if ( pure SamplesPerUpdate == value )
      return;

    /* limit range between 1 and 64 */
    if ( value < 1 )
      value = 1;
    if ( value > 64 )
      value = 64;

    /* store the new value */
    pure SamplesPerUpdate = value;

    /* ...and finally, force an update */
    InvalidateViewState();
  }

  // The variable 'NoOfStoredSamples' contains the number of samples that are currently \
  // stored in the SampleStorage.
  $rect <220,360,420,400>
  var int32 NoOfStoredSamples = 0;

  // The array 'SampleStorage' keeps the added data values of the data channel until \
  // they are drawn.
  $rect <220,400,420,440>
  array int32 SampleStorage[ 64 ];

  // The property 'MinValue' stores the lower level of the data range.
  $rect <340,150,540,190>
  property int32 MinValue = 0;

  // The onset method for the property 'MinValue' changes the minimum data value.
  $rect <540,150,740,190>
  onset MinValue
  {
    /* check if the given value differs from the current value */
    if ( pure MinValue == value )
      return;

    /* ensure that minimum value is positive */
    if ( value < 0 )
      value = 0;

    /* store the new value */
    pure MinValue = value;

    /* ...and finally, force an update */
    InvalidateViewState();
  }

  // The method 'DrawSamples' is called when a sequence of samples have to be drawn.
  $rect <430,400,630,440>
  method void DrawSamples()
  {
    var int32 x;
    var int32 y;
    var int32 w = Bounds.w;
    var int32 h = Bounds.h;
    var int32 borderY = 30;
    var int32 paperW = SamplesPerUpdate;
    var int32 paperX = PaperPosition % w;

    /* create canvas if necessary */
    if ( Canvas == null )
      InitPlotter();

    /* add a piece of paper at the current position within the canvas */
    Canvas.CopyBitmap( Clipping, PaperImage.Bitmap, 0, rect( paperX, 0, paperX + paperW, h ), 
      point( PaperPosition % 64, 0 ), #FFFFFFFF, #FFFFFFFF, #FFFFFFFF, #FFFFFFFF, false );

    /* if necessary, handle the wrap-arround and put the remaining piece of paper at the beginning of the canvas */
    if ( paperX + paperW > w )
      Canvas.CopyBitmap( Clipping, PaperImage.Bitmap, 0, rect( paperX - w, 0, paperX - w + paperW, h ), 
        point( PaperPosition % 64, 0 ), #FFFFFFFF, #FFFFFFFF, #FFFFFFFF, #FFFFFFFF, false );

    /* draw all samples of the last sequence */
    for ( x = 0; x <  SamplesPerUpdate; x = x + 1 )
    {
      /* draw data of channel */
      y = Bounds.h - borderY;

      if ( MaxValue > 0 )
        y =  y - (( SampleStorage[ x ] - MinValue ) * ( Bounds.h - 2 * borderY ) / MaxValue );

      DrawPenLine( PenColor, ( PaperPosition + x - 10 ) % w, LastValue, y );
      LastValue = y;
    }

    /* set position of needle to last value */
    Needle.Bounds.origin.y = LastValue - Needle.Bounds.h / 2;
    Needle.Bounds.origin.x = Bounds.w - Needle.Bounds.w;

    /* clear the storage of the data channel */
    NoOfStoredSamples = 0;

    /* finally, we have to move the content within the wallpaper to the left */
    PaperPosition = PaperPosition + paperW;
    Image.ScrollOffset = point( -( PaperPosition % w ), 0 );



  }

  // This is an simple image view.
  $rect <20,20,160,60>
  object Views::Image PaperImage
  {
    preset Visible = false;
    preset Bitmap = SolarRes::Paper;
    preset Bounds = <168,0,296,340>;
    preset AutoSize = true;
  }

  // This is an simple image view.
  $rect <20,20,160,60>
  object Views::Image PaperFirstImage
  {
    preset Visible = false;
    preset Bitmap = SolarRes::PaperFirst;
    preset Bounds = <40,0,168,340>;
    preset AutoSize = true;
  }

  // This is an simple image view.
  $rect <20,20,160,60>
  object Views::Image Needle
  {
    preset Visible = false;
    preset Bitmap = SolarRes::Needle;
    preset Bounds = <280,160,295,175>;
    preset AutoSize = true;
  }

  // This is a method.
  $rect <540,40,740,80>
  method void InitPlotter()
  {
    /* intialize the clipping variable, which is used later 
       as clipping for all drawing operations */
    Clipping = rect( 0, 0, Bounds.w, Bounds.h );

    /* create canvas */
    if ( Canvas == null )
      Canvas = new Graphics::Canvas;

    /* set size to bounds area */
    Canvas.FrameSize = Bounds.size;

    /* and clear the complete bitmap with transparent color */
    var rect r = rect( 0, 0, Bounds.w, Bounds.h );
    Canvas.FillRectangle( r, r, #00000000, #00000000, #00000000, #00000000, false );

    /* copy the first paper image :-) */
    Canvas.CopyBitmap( Clipping, PaperFirstImage.Bitmap, 0, 
      rect( Bounds.w - PaperFirstImage.Bitmap.FrameSize.x, 0, Bounds.w, Bounds.h ), 
      point( 0, 0 ), #FFFFFFFF, #FFFFFFFF, #FFFFFFFF, #FFFFFFFF, false );

    /* assign the canvas to the image object */
    Image.Bitmap = Canvas;
    Image.Bounds.size = Bounds.size;

    /* initialize the last value to center */
    LastValue = Bounds.h / 2;

    /* set position of the needle to last value */
    Needle.Visible = true;
    Needle.Bounds.origin.y = LastValue - Needle.Bounds.h / 2;
    Needle.Bounds.origin.x = Bounds.w - Needle.Bounds.w;


  }

  // This is a wallpaper view.
  $rect <20,20,160,60>
  object Views::Wallpaper Image
  {
    preset Bounds = <0,0,320,340>;
  }

  // The class 'DataPlotter' implements the simulation of a data plotter that writes \
  // metered values with a pen on a moving paper.
  // The data are feed into the plotter by calling the method AddSample() - as soon \
  // as enough samples are available (determined via the property 'SamplesPerUpdate'), \
  // the method DrawSamples() take care that the paper is shifted and that the new \
  // data values are drawn by using the method DrawPenLine().
  // The data range of the plotter can be configured via the properties 'MinValue' \
  // and 'MaxValue'. The color of the plotter pen can be defined with the property \
  // 'PenColor'.
  note legend Note
  {
    attr Bounds = <10,490,740,660>;
  }

  // Directives to adapt the order of members belonging to this class so they appear 
  // correctly arranged relative to the members inherited from the ancestor (super) 
  // classes. The numbers indicate the order-displacement to apply on the respective 
  // member once all members have been loaded and combined with members from the 
  // ancestor classes.
  $reorder Canvas 1
  $reorder DrawPenLine 1
  $reorder Clipping 1
  $reorder LastValue 1
}

// The class 'PowerPanel' shows the current power values on a simulated data writer.
$rect <30,450,230,490>
$output false
class PowerPanel : Solar::Panel
{
  $rect <20,20,160,60>
  inherited object CaptionText
  {
    preset String = "Momentary Power";
  }

  $rect <820,10,1020,50>
  inherited method Unlock()
  {
    super();

    /* start the build up animation... */
    AnimationTimer.Enabled = true;
  }

  $rect <20,20,160,60>
  object Solar::DataPlotter Plotter
  {
    preset Bounds = <40,100,749,440>;
    preset MaxValue = 100;
    preset SamplesPerUpdate = 64;
  }

  // This is a timer object.
  $rect <10,510,210,550>
  object Core::Timer AnimationTimer
  {
    preset OnTrigger = AnimationSlot;
    preset Period = 50;
  }

  // This is a slot method.
  $rect <210,510,410,550>
  slot AnimationSlot
  {
    var int32 i;

    /* please note: instead of reading data from a real solar power system
       only a few dummy data are calculated for displaying them within this 
       solar demo application */
    for ( i = 0; i < Plotter.SamplesPerUpdate; i = i + 1 )
    {
      var int32 delta = math_rand(-3,4 );

      if ( SimPower + delta > 100 )
        delta = -delta;
      if ( SimPower + delta < 0 )
        delta = -delta;

      SimPower = SimPower + delta;

      Plotter.AddSample( SimPower );
    }

    if ( Plotter.SamplesPerUpdate > 1 )
      Plotter.SamplesPerUpdate = Plotter.SamplesPerUpdate - 4;
    else
    {
      Plotter.SamplesPerUpdate = 1;
      AnimationTimer.Period = 100;
    }

  }

  // This is a variable.
  $rect <410,510,610,550>
  var int32 SimPower = 50;

  // This is an simple image view.
  $rect <20,20,160,60>
  object Views::Image PlotterBox
  {
    preset Bitmap = SolarRes::PlotterBox;
    preset Bounds = <708,80,786,468>;
    preset AutoSize = true;
  }

  // This is an simple image view.
  $rect <20,20,160,60>

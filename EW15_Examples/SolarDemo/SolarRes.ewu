$version 15.00

// Bitmap resource of the panel background.
$rect <20,10,230,50>
$output false
resource Resources::Bitmap Background
{
  attr bitmapfile FileName = .\Res\Background.png;
  attr framesize FrameSize;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}

// Font resource for caption strings.
$rect <20,470,230,510>
$output false
resource Resources::Font CaptionFont
{
  attr fontname FontName = Verdana;
  attr fontheight Height = 48;
  attr fontquality Quality = High;
  attr fontranges Ranges = 0x20-0x7F;
  attr fontaspectratio AspectRatio = 1.0;
  attr fontbold Bold = false;
  attr fontitalic Italic = false;
  attr fontkerning Kerning = true;
  attr fontheightmode HeightMode = Compatible;
  attr fontrowdistance RowDistance;
}

// Font resource for all text or descriptions.
$rect <230,470,440,510>
$output false
resource Resources::Font TextFont
{
  attr fontname FontName = Verdana;
  attr fontheight Height = 24;
  attr fontquality Quality = High;
  attr fontranges Ranges = 0x20-0x7F;
  attr fontaspectratio AspectRatio = 1.0;
  attr fontbold Bold = false;
  attr fontitalic Italic = false;
  attr fontkerning Kerning = true;
  attr fontheightmode HeightMode = Compatible;
  attr fontrowdistance RowDistance;
}

// Color constant for drawing caption.
$rect <20,530,230,570>
$output false
const color CaptionColor = #FFFFFFFF;

// Bitmap resource for drawing a red metering bar.
$rect <20,80,230,120>
$output false
resource Resources::Bitmap MeteringBarRed
{
  attr bitmapfile FileName = .\Res\YieldBarRed.png;
  attr framesize FrameSize;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}


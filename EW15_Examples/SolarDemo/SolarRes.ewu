// Color constant for drawing text.
$rect <230,530,440,570>
$output false
const color TextColor = #DDDDDDFF;

// Font resource for all text or descriptions.
$rect <440,470,660,510>
$output false
resource Resources::Font DescrFont
{
  attr fontname FontName = Arial;
  attr fontheight Height = 16;
  attr fontquality Quality = High;
  attr fontranges Ranges = 0x20-0xFF;
  attr fontaspectratio AspectRatio = 1.0;
  attr fontbold Bold = true;
  attr fontitalic Italic = false;
  attr fontkerning Kerning = true;
  attr fontheightmode HeightMode = Compatible;
  attr fontrowdistance RowDistance;
}

// Color constant for drawing descriptions.
$rect <440,530,650,570>
$output false
const color DescrColor = #DDDDDDFF;


$version 15.00

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,70,240,110>
unit Core
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,110,240,150>
unit Resources
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,150,240,190>
unit Graphics
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,190,240,230>
unit Effects
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,230,240,270>
unit Views
{
  attr Directory = $Mosaic;
}

$rect <40,270,240,310>
unit WidgetSet
{
  attr Directory = $Mosaic\;
}

// The 'default' Language. Each project has to contain at least one language brick \
// called 'Default'
$rect <540,70,740,110>
language Default;

// The unit 'Solar' contains the implementation of all instruments and screens of \
// the solar demo.
$rect <40,430,240,470>
unit Solar
{
  attr Directory = .\;
}

// The unit Res contains all resources used within the project.
$rect <40,470,240,510>
unit SolarRes
{
  attr Directory = .\;
}

// The unit 'Application' contains the application class.
$rect <40,390,240,430>
unit Application
{
  attr Directory = .\;
}

// Mosaic Framework
note group Note1
{
  attr Bounds = <20,20,260,330>;
}

// Profile Configuration
note group Note2
{
  attr Bounds = <270,20,510,130>;
}

// Languages
note group Note3
{
  attr Bounds = <520,20,760,130>;
}

// Project Units
note group Note5
{
  attr Bounds = <20,340,260,530>;
}

// The sample application 'SolarDemo' implements the user interface of a solar inverter \
// data logger.
// A couple of special analog and digital instruments are implemented to create the \
// different panels of the solar data logger, e.g. to show power, voltage and current \
// of the solar string and the inverter, or to show the energy yield of different \
// time spans.
// The user can navigate between the different panels by a simple slide touch gesture.
// The data of the solar demo application is accessed via a device class.
// 
// This solar data logger demo is designed for a screen size of 800x480 pixels.
// 
// You can double-click on the 'Solar' brick to open the unit within the Composer \
// and to analyze the implementation.
// 
// To start the application within the Prototyper, press 'Ctrl'+'F5'.
note legend Note
{
  attr Bounds = <270,140,760,530>;
}

// This is the 'default' profile for the new project. This profile will be used for \
// test, prototyping, etc.
$rect <290,70,490,110>
profile Win32 : Windows.Software.RGBA8888
{
  attr ScreenSize = <800,480>;
  attr Optimization = High;
  attr ApplicationClass = Application::Application;
  attr CleanOutputDirectories = false;
  attr Verbose = false;
  attr ScreenOrientation = Normal;
  attr FontConversion = Windows;
  attr OutputFileNameExtension = c;
  attr StorageOfResources = Code;
  attr StorageOfConstants = Code;

  $rect <10,10,154,50>
  macro Author = "Dipl. Ing. Paul Banach and Dipl. Ing. Manfred Schweyer, Copyright (C) TARA Systems GmbH";
}

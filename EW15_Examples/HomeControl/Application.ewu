  }

  $rect <230,540,460,580>
  property class CurrentContentClass;

  $rect <230,580,460,620>
  onset CurrentContentClass
  {
    // The value doesn't change - nothing to do.
    if ( pure CurrentContentClass == value )
      return;

    // Remember the property's new value.
    pure CurrentContentClass = value;


    // Accept classes derived from Application::Content only
    if ( ( value != null ) && ( (Application::Group)value == null ) )
    {
      trace "The specified CurrentContentClass is not descending from Application::Content.";
      return;
    }

    // if it is the same content class -> nothing to do
    if ( ( currentContent != null ) && ( classof currentContent == value ) )
      return;

    // remove the current content
    if ( currentContent != null && currentContent.Owner == ContentContainer )
    {
      ContentContainer.Remove( currentContent );
      currentContent = null;
    }

    // create new content and display it
    currentContent = (Application::Group)new value;
    if ( currentContent != null )
      ContentContainer.Add( currentContent, 0 )  ;


  }

  // Style update
  note group Note
  {
    attr Bounds = <510,500,800,600>;
  }

  $rect <530,540,730,580>
  slot onStyleUpdate
  {
    // Color exception handling:
    // For Dark mode use a different color for TabButton Label in On state ( ColorSelection is not visible on a dark background ).
    var color c = Application::ColorSelection;
    if ( styles.contains( [ DarkMode] ) )
      c = Application::ColorSelectionBackground;

    TabButtonConfig.LabelOnColorActive = TabButtonConfig.LabelOnColorDefault = TabButtonConfig.LabelOnColorFocused = c;

  }

  // Current content
  note group Note1
  {
    attr Bounds = <210,500,500,740>;
  }

  // MainMenu
  note group Note2
  {
    attr Bounds = <510,610,800,710>;
  }

  $rect <230,640,460,680>
  var Application::Group currentContent;

  $rect <230,680,460,720>
  slot onCurrentContentChange
  {
    // set the coresponding current content class
    switch( Application::Device.CurrentContent )
    {
      case (int32)Application::ContentType.Heat   : CurrentContentClass = Application::HeaterGroup;
      case (int32)Application::ContentType.Lights : CurrentContentClass = Application::LightsGroup;
      default                                     : CurrentContentClass = null;
    }

  }


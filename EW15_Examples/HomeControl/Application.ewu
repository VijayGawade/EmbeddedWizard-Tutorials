    var bool isSelected = aState.contains( Core::ViewState[ Selected ]);
    var bool isPressed  = ( TouchHandler.Down && TouchHandler.Inside ) ||
                            FlashTimer.Enabled;
    // update ToggleImage color based on the current state
    if ( !isEnabled )
    {
      ToggleImage.Color = Application::ColorDisabled;
    }

    else if ( isPressed )
    {
      ToggleImage.Color = Application::ColorSelection;
    }

    else if ( isSelected )
    {
      ToggleImage.Color = Application::ColorSelection;
    }

    // Enabled but not pressed nor selected.
    else
    {

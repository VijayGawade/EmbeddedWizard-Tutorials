    {
      PreviewText.Color = Application::ColorDisabled;
    }

    else if ( isPressed )
    {
      PreviewText.Color = Application::ColorSelection;
    }

    else if ( isSelected )
    {
      PreviewText.Color = Application::ColorSelection;
    }

    // Enabled but not pressed nor selected.

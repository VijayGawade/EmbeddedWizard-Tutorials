$output false
class OpacityFader : Effects::OpacityFader
{
  $rect <10,50,210,90>
  inherited method OnEnd()
  {
    super();

    var Core::Group overlay = getOverlay();
    if ( overlay == null || Owner == null )
      return;

    // Set Overlay opacity to the final value
    if ( Visible )
    {
      overlay.Opacity = Effect.Value2;
    }

    // Remove Overlay if group is hidden or removed
    if ( Group.Owner == null || ( !Visible && ( Group.Opacity == 0 ) ) )
    {
      Owner.Remove( overlay );
      overlay = null;
    }

  }

  $rect <10,10,210,50>
  inherited method OnStart()
  {
    super();

    // do nothing if Owner or Group are not set
    if ( Owner == null || Group == null || Group.Owner == null )
      return;

    // Use a local property as Outlet to synchronize Owner Overlay opacity with Group opacity
    Effect.Outlet = ^opacity;

    // create Overlay object if not created already
    var Core::Group overlay = getOverlay();
    if ( overlay == null )
    {
      overlay = new Application::Overlay;
      // add overlay to the Owner
      Owner.AddBehind( overlay, Group );
    }
    else
    {
      // restack overlay behind the group
      Owner.RestackBehind( overlay, Group );
    }

    // set Overlay initial Opacity and make it visible
    overlay.Opacity = Effect.Value1;
    overlay.Visible = true;

  }

  $rect <220,10,420,50>
  property int32 opacity;

  $rect <220,50,420,90>
  onset opacity
  {
    // The value doesn't change - nothing to do.
    if ( pure opacity == value )
      return;

    // Remember the property's new value.
    pure opacity = value;

    if ( Group != null )
      Group.Opacity = value;

    var Core::Group overlay = getOverlay();
    if ( overlay == null )
      return;

    // synchronize Owner Overlay opacity with Group opacity
    overlay.Opacity = value;


  }

  $rect <430,10,630,50>
  method Core::Group getOverlay()
  {
    var Application::Overlay overlay = null;
    var Core::View view = Owner.last;

    while( view != null && overlay == null )
    {
      overlay = (Application::Overlay)view;
      view = view.prev;
    }

    return overlay;
  }
}


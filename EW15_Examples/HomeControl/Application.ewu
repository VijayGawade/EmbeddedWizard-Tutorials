$rect <560,640,810,680>
$output false
class PositionFader : Effects::PositionFader
{
  $rect <10,50,210,90>
  inherited method OnEnd()
  {
    super();

    var Core::Group overlay = getOverlay();
    if ( overlay == null || Owner == null )
      return;

    // Set Overlay opacity to the final value
    if ( Visible )
    {
      overlay.Opacity = OpacityEffect.Value2;
    }

    // Hide Overlay if group is hidden
    if ( !Visible && ( Group.Opacity == 0 ) )
    {
      overlay.Visible = false;
    }

    // Remove Overlay if group was removed
    if ( Group.Owner == null )
      Owner.Remove( overlay );

  }

  $rect <10,10,210,50>
  inherited method OnStart()
  {
    super();

    // Use a local property as Outlet to synchronize  Owner Overlay opacity with Group opacity
    OpacityEffect.Outlet = ^opacity;

    if ( Owner == null || Group == null )
      return;

    // create Overlay object if not created already
    var Core::Group overlay = getOverlay();
    if ( overlay == null )
    {
      overlay = new Application::Overlay;
      // add overlay to the Owner
      Owner.AddBehind( overlay, Group );
    }
    else
    {
      // restack overlay behind the group
      Owner.RestackBehind( overlay, Group );
    }

    // set Overlay initial Opacity and visibility
    overlay.Opacity = OpacityEffect.Value1;
    overlay.Visible = Group.Visible;

  }

  $rect <220,10,420,50>
  property int32 opacity;

  $rect <220,50,420,90>
  onset opacity

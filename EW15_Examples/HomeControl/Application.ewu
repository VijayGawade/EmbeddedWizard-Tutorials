$rect <20,250,220,290>
$variant Win32
vclass DeviceClassSimulation : Application::DeviceClass
{
  $rect <320,40,520,80>
  object Core::Timer dateTimeTimer
  {
    preset OnTrigger = updateDateTime;
  }

  $rect <320,80,520,120>
  slot updateDateTime
  {
    // simulate Datetime update by the middleware
    UpdateDateTime( DateTime + ( dateTimeTimer.Period / 1000 ) );

  }

  // Init device properties
  note group Note
  {
    attr Bounds = <0,0,290,140>;
  }

  // DateTime update simulation
  note group Note1
  {
    attr Bounds = <300,0,590,140>;
  }

  $rect <20,80,220,120>
  method void initValues()
  {
    CurrentPage = (int32)Application::PageType.SplashScreen;
    CurrentContent = (int32)Application::ContentType.Heat;
    Language = (int32)Application::Language.English;
    HeaterOn = true;
    HeaterTemperature = 25;
    HeaterTempMin = 5;
    HeaterTempMax = 35;
    OutdoorTemperature = 18;
    LightsOn = true;
    LightsBrightness = 75;

    DateTime = (uint32)(new Core::Time).CurrentTime.Time;
    dateTimeTimer.Enabled = true;

  }

  $rect <20,40,220,80>
  inherited method Init()
  {
    initValues();
  }


    itemView.String    = string( itemNo + 1, 2 );
    itemView.Font      = Resources::FontLarge;
    itemView.Color     = Application::ColorText;

    itemView.Alignment = Views::TextAlignment[ AlignHorzCenter, AlignVertCenter ];


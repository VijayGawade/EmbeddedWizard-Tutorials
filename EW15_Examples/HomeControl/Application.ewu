$rect <300,90,530,130>
$output false
class SplashScreen : Application::Page
{
  $rect <20,20,160,60>
  inherited object Background
  {
    preset Color = #1D1D1DFF;
  }

  $rect <20,20,160,60>
  inherited object BackgroundImage
  {
    preset Color = #006399FF;
    preset Bitmap = Application::splash_bg_group;
  }

  $rect <0,510,200,550>
  inherited slot OnOpen
  {
    closeTimer.Enabled = true;

  }

  $rect <20,20,160,60>
  object Core::SimpleTouchHandler SimpleTouchHandler
  {
    preset Point4 = <0,0>;
    preset Point3 = <800,0>;
    preset Point2 = <800,480>;
    preset Point1 = <0,480>;
    preset OnPress = close;
  }

  $rect <220,510,420,550>
  object Core::Timer closeTimer
  {
    preset OnTrigger = close;
    preset Period = 0;
    preset Begin = 2000;
  }

  $rect <220,550,420,590>
  slot close
  {
    // disable timer
    closeTimer.Enabled = false;

    // go to Home
    Application::Device.CurrentPage = (int32)Application::PageType.Home;

  }

  // Effects
  note group Note3
  {
    attr Bounds = <430,510,670,640>;
  }

  $rect <20,20,160,60>
  object Views::WarpImage WarpImage
  {
    preset Point4 = <290,350>;
    preset Point3 = <510,350>;
    preset Point2 = <510,130>;
    preset Point1 = <290,130>;
    preset SourceAnchor = <109,109>;
    preset Bitmap = Application::Emwi_Logo_rund;
  }

  $rect <450,550,650,590>
  object Effects::FloatEffect ShowLogoEffect
  {
    preset OnAnimate = onShowLogo;

  // response to this notification, the item will update itself.
  $rect <250,510,450,550>
  slot onOutlet
  {
    // Read the current value of the associated property and update accordingly
    // the state of the radio button.
    if ( Outlet != null )
      Selected = Outlet^ == OutletSelector;
  }

  $rect <710,170,910,210>
  slot closeMenu
  {
    // close menu
    if ( Owner != null && Owner.Owner != null )
      Owner.Owner.DismissDialog( Owner, null, null, null, null, null, false );


      if ( appear != null )
      {
        if ( textView1 != null )
          textView1.Color = appear.ValueColorDisabled;
        if ( textView2 != null )
          textView1.Color = appear.UnitColorDisabled;
      }
    }

  }

  $rect <0,50,200,90>
  inherited slot onFormatValue
  {
    super( sender );

    // add Unit to the value
    valueString = valueString + Unit;
  }
}


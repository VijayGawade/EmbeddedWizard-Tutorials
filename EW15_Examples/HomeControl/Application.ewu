$version 15.00

// This is the root component of the entire GUI application.
$rect <20,50,220,90>
$output false
class Application : Core::Root
{
  $rect <0,500,200,540>
  inherited method Init()
  {
    // observe Device Language change
    attachobserver onLanguageChange, ^Device.Language;
    postsignal onLanguageChange;

    // observe Device DarkMode changes
    attachobserver onStyleChange, ^Device.DarkMode;
    postsignal onStyleChange;

    // observe Device CurrentPageClass changes
    attachobserver onCurrentPageChange, ^Device.CurrentPage;
    postsignal onCurrentPageChange;

  }

  $rect <810,0,1010,40>
  inherited property Bounds = rect(0,0,$ScreenSize.x,$ScreenSize.y);

  // The property 'CurentPageClass' determines the class of a GUI component presented \
  // actually as the active dialog within the application.
  // Changing this property triggers automatically a transition to the new page. \
  // In such case, a new instance of the specified class is created and presented \
  // by using the method @SwitchToDialog() directly in context of the application \
  // component. In turn, setting this property to the value 'null' triggers the @DismissDialog() \
  // operation for the actually existing active dialog.
  // This is a convenience property to simply switch the dialogs existing in the \
  // application component. Please note, the transition between two dialogs is performed \
  // instantly without any animations. If you expect the transition to be performed \
  // with an animation, please use the method @SwitchToDialog(). Similarly, if you \
  // want the dialogs to be stacked (or nested) you have to use the methods @PresentDialog() \
  // and @DismissDialog().
  $rect <250,540,470,580>
  property class CurrentPageClass;

  $rect <250,580,470,620>
  onset CurrentPageClass
  {
    // Accept classes representing GUI components only
    if ( ( value != null ) && (Core::Group)value == null )
      throw "The specified CurentPageClass is not descending from Core::Group.";

    var class currentPage = CurrentPageClass;

    // The value doesn't change - nothing to do.
    if ( currentPage == value )
      return;

    // Switch to a new dialog?
    if ( value != null )
    {

      if ( GetDialogAtIndex( 0 ) != null )
        DismissDialog( GetDialogAtIndex( 0 ), null, null, null, null, null, false );

      var Application::Page page = (Application::Page)new value;
      if ( page != null )
      {
        PresentDialog( page, Effects::FadeInOutCentered, Effects::FadeInOutCentered, null, null, null, null, page.OnOpen, null, false );
      }
    }

    // ... or just dismiss an existing dialog?
    else if ( GetDialogAtIndex( 0 ) != null )
      DismissDialog( GetDialogAtIndex( 0 ), null, null, null, null, null, false );

  }

  $rect <250,620,470,660>
  onget CurrentPageClass
  {
    return classof GetDialogAtIndex( 0 );
  }

  $rect <10,600,210,640>
  var Application::DeviceClass Device = Application::Device;

  // Device instance
  note group Note
  {
    attr Bounds = <0,550,230,690>;
  }

  // Page handling
  note group Note1
  {
    attr Bounds = <240,500,720,690>;
  }

  $rect <480,540,700,580>
  slot onCurrentPageChange
  {
    switch( Device.CurrentPage )
    {
      case (int32)Application::PageType.SplashScreen : CurrentPageClass = Application::SplashScreen;
      case (int32)Application::PageType.Home         : CurrentPageClass = Application::Home;
      default                                        : CurrentPageClass = null;
    }

  }

  $rect <20,20,160,60>
  object Views::Rectangle Background
  {
    preset Bounds = <0,0,800,480>;
    preset Color = #1D1D1DFF;
  }

  // Style change
  note group Note3
  {
    attr Bounds = <240,700,470,840>;
  }

  $rect <250,740,450,780>
  slot onStyleChange
  {
    // set the new style
    if ( Device.DarkMode )
    {
      styles = styles - [ LightMode ];
      styles = styles + [ DarkMode ];
    }
    else
    {
      styles = styles - [ DarkMode ];
      styles = styles + [ LightMode ];
    }
  }

  // Language change
  note group Note4
  {
    attr Bounds = <0,700,230,840>;
  }

  $rect <10,740,210,780>
  slot onLanguageChange
  {
    switch( Device.Language )
    {
      case (int32)Application::Language.German : language = German;
      default                                  : language = Default;
    }
  }
}

// Application
note group Note
{
  attr Bounds = <10,10,250,110>;
}

// Screens
note group Note1
{
  attr Bounds = <260,10,540,340>;
}

// Strings
note group Note4
{
  attr Bounds = <10,1789,860,2189>;
}

// Colors DarkMode
note group Note5
{
  attr Bounds = <269,1010,540,1780>;
}

// Device
note group Note6
{
  attr Bounds = <10,120,250,340>;
}

// Fonts
note group Note7
{
  attr Bounds = <550,1010,829,1240>;
}

// Bitmaps
note group Note8
{
  attr Bounds = <549,1249,829,1780>;
}


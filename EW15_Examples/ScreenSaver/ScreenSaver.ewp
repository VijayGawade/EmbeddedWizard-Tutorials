$version 15.00

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,70,240,110>
unit Core
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,110,240,150>
unit Resources
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,150,240,190>
unit Graphics
{
  attr Directory = $Mosaic;
}

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,190,240,230>
unit Effects
{
  attr Directory = $Mosaic;
}

// The 'default' Language. Each project has to contain at least one language brick \
// called 'Default'
$rect <540,70,740,110>
language Default;

// This unit is a part of the Embedded Wizard framework 'Mosaic'
$rect <40,230,240,270>
unit Views
{
  attr Directory = $Mosaic;
}

$rect <40,270,240,310>
unit WidgetSet
{
  attr Directory = $Mosaic\;
}

// This is a unit.
$rect <40,390,240,430>
unit Application
{
  attr Directory = .\;
}

// This is a unit.
$rect <40,430,240,470>
unit ScreenSaver
{
  attr Directory = .\;
}

// The unit 'Res' contains all fonts and bitmap resources of the project.
$rect <40,470,240,510>
unit Res
{
  attr Directory = .\;
}

// Mosaic Framework
note group Note1
{
  attr Bounds = <20,20,260,330>;
}

// Profile Configuration
note group Note2
{
  attr Bounds = <270,20,510,130>;
}

// Languages
note group Note3
{
  attr Bounds = <520,20,760,130>;
}

// Project Units
note group Note5
{
  attr Bounds = <20,340,260,530>;
}

// The sample application 'ScreenSaver' implements four different image animation \
// demos with a 3D look: 'LevitationScreenSaver', 'CarouselScreenSaver', 'PerspectiveScreenSaver' \
// and 'StarfieldScreenSaver'.
// 
// Each screen saver arranges a variable number of images within the 3D space. For \
// this purpose the functionality of Views::WarpImage is used.
// The user can configure the different parameters of the screen saver like speed, \
// count, rotation or eye distance within a control panel.
// 
// This demo application is implemented for a variable screen size - the application \
// will arrange the content depending on the ScreenSize of the profile.
// 
// You can double-click on the 'ScreenSaver' brick to open the unit within the Composer \
// and to analyze the implementation.
// 
// To start the application within the Prototyper press 'Ctrl'+'F5'.
note legend Note
{
  attr Bounds = <270,140,760,470>;
}

// Important note: This demo application deals with many images and makes extensive \
// usage of the Warp3D() functionality.
// 
// To run this demo with an impressive performance on a certain target, please ensure \
// that the target system provides sufficient graphics power to make many 3D drawing \
// operations per frame.
// Ideally, the target provides a 3D graphics core and OpenGL ES 2.0.
note legend Note4
{
  attr Bounds = <270,480,760,630>;
}

// This is the 'default' profile for the new project. This profile will be used for \
// test, prototyping, etc.
$rect <290,70,490,110>
profile Win32 : Windows.Software.RGBA8888
{
  attr ScreenSize = <960,540>;
  attr Optimization = High;
  attr ApplicationClass = Application::Application;
  attr ApplicationTitle = "Embedded Wizard - Screen Saver Demo";
  attr CleanOutputDirectories = false;
  attr Verbose = false;
  attr ScreenOrientation = Normal;
  attr FontConversion = Windows;
  attr OutputFileNameExtension = c;
  attr StorageOfResources = Code;
  attr StorageOfConstants = Code;

  $rect <10,10,154,50>
  macro Author = "TARA Systems GmbH";

  // This is a macro.
  $rect <10,50,150,90>
  macro GE20 = false;
}

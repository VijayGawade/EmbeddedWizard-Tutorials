// The base class of all control panels.
$rect <250,620,450,660>
$output false
class ControlPanel : Core::Group
{
  $rect <240,0,440,40>
  inherited property Bounds = <0,0,220,400>;

  $rect <240,180,440,220>
  inherited method UpdateLayout()
  {
    // Per default, the panel will always arrange itself in the bottom right corner of the given
    // aBoundsArea.
    Bounds.origin = Owner.Bounds.origin + Owner.Bounds.size - aSize;

  }

  $rect <20,20,160,60>
  object Views::Frame Frame
  {
    preset Bounds = <0,0,220,400>;
    preset Bitmap = Resources::DefaultFrame;
  }

  $rect <20,20,160,60>
  object WidgetSet::PushButton NextButton
  {
    preset Bounds = <10,290,210,340>;
    preset Label = "Next Screen Saver";
    preset Appearance = WidgetSet::PushButton_Lime_Medium;
  }

  // This is an ordinary text view.
  $rect <20,20,160,60>
  object Views::Text CaptionText
  {
    preset Bounds = <10,10,210,60>;
    preset WrapText = true;
    preset String = "Control Panel";
    preset Font = Resources::FontMedium;
  }

  // This is an simple image view.
  $rect <20,20,160,60>
  object Views::Image Logo
  {
    preset Bounds = <40,350,183,382>;
    preset AutoSize = true;
    preset Bitmap = Res::Logo;
  }

  // This slot method is connected to the KeyHandler. It will be invoked, when the \
  // user has pressed the Left/Right/Up/Down keys.
  $rect <240,280,440,320>
  slot onKeyPressSlot
  {
    var Core::Direction direction = Core::Direction.None;
    var Core::View      view;

    // Depending on the pressed key, determine the direction to look for
    // other widgets.
    switch ( KeyHandler.Code )
    {
      case Core::KeyCode.Left  : direction = Core::Direction.Left;
      case Core::KeyCode.Right : direction = Core::Direction.Right;
      case Core::KeyCode.Up    : direction = Core::Direction.Top;
      case Core::KeyCode.Down  : direction = Core::Direction.Bottom;
      default :;
    }

    // Try to find another widget in the given direction relative to the
    // currently selected (Focus) widget. Search for widgets able to handle
    // keyboard inputs only (Enabled and Focusable).
    view = FindViewInDirection( Focus, direction,
                                Core::ViewState[ Enabled, Focusable ]);

    // Item found? Select this widget then.
    if ( view != null )
      Focus = view;
  }

  // This is a key press handler. It responds to the Up/Down/Left/Right key events \
  // and passes them to the onPressKey slot method.
  $rect <240,240,440,280>
  object Core::KeyPressHandler KeyHandler
  {
    preset OnPress = onKeyPressSlot;
    preset Filter = Core::KeyCode.CursorKeys;
    preset OnHold = onKeyPressSlot;
  }

  // This is a property.
  $rect <240,50,440,90>
  property string Caption = 0;

  $rect <240,100,440,140>
  onset Caption
  {
    pure Caption = value;
    CaptionText.String = value;
  }

  // This is the base class of the different control panels used within the demo.
  // It contains the background, the caption text, the icon image and a button to \
  // navigate to the next screen saver.
  note legend Note
  {
    attr Bounds = <240,340,590,440>;
  }
}

// Levitation Screen Saver
note group Note
{
  attr Bounds = <20,0,470,140>;
}

// Carousel Screen Saver
note group Note1
{
  attr Bounds = <20,150,470,290>;
}

// Perspective Screen Saver
note group Note2
{
  attr Bounds = <20,300,470,440>;
}

// Starfield Screen Saver
note group Note3
{
  attr Bounds = <20,450,470,590>;
}

// The 'LevitationScreenSaver' displays a set of images in a levitation manner. The \
// single images are objects from the class 'LevitationImage'. In order to configure \
// the screen saver object dynamically, a 'LevitationControlPanel' can be used and \
// connected with the corresponding properties.
note legend Note4
{
  attr Bounds = <480,0,860,140>;
}

// The 'CarouselScreenSaver' displays three rows of images in an image Carousel. \
// The single images are objects from the class 'CarouselImage'. In order to configure \
// the screen saver object dynamically, a 'CarouselControlPanel' can be used and \
// connected with the corresponding properties.
note legend Note5
{
  attr Bounds = <480,150,860,290>;
}

// The 'PerspectiveScreenSaver' displays three rows of images in a perspective rotated \
// layer. The single images are objects from the class 'PerspectiveImage'. In order \
// to configure the screen saver object dynamically, a 'PerspectiveControlPanel' \
// can be used and connected with the corresponding properties.
note legend Note6
{
  attr Bounds = <480,300,860,440>;
}

// The 'StarfieldScreenSaver' displays a set of images in a star field manner. The \
// single images are objects from the class 'StarfieldImage'. In order to configure \
// the screen saver object dynamically, a 'StarfieldControlPanel' can be used and \
// connected with the corresponding properties.
note legend Note7
{
  attr Bounds = <480,450,860,590>;
}

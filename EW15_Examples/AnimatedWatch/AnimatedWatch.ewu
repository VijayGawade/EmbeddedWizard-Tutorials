// The UI component shows a spinning watch.
$rect <20,20,220,60>
$output false
class AnimatedWatch : Core::Group
{
  $rect <500,10,700,50>
  inherited property Bounds = <0,0,480,480>;

  $rect <0,810,200,850>
  inherited method UpdateLayout()
  {
    aSize;

    // Update the arrangement if screen size is changed
    postsignal AnimationTimerSlot;
  }

  // This slot method is invoked durring the animation. It calculates the next position \
  // of the spinning watch.
  $rect <500,130,700,170>
  slot AnimationTimerSlot
  {
    var int32 i;

    for ( i = 0; i < Watches.size; i++ )
    {
      /* create new watch if necessary */
      if ( Watches[i] == null )
      {
        Watches[i] = new AnimatedWatch::WarpGroup;
        if ( i % 2 == 0 )
          Watches[i].Watch = Watch1;
        else
          Watches[i].Watch = Watch2;
        Watches[i].Opacity = 0x01;
        Watches[i].XPos = (float)math_rand( Bounds.w / 8, Bounds.w * 7 / 8);
        Watches[i].YPos = (float)Bounds.h * 10 /8;
        Watches[i].LightingEffect = 0.0;
        Watches[i].SourceAnchor = <120,120>;
        Watches[i].Angle = 0.0;
        Watches[i].DeltaAngle = math_rand( -1.0, 1.0 );
        Watches[i].DeltaX = 0.0;
        Watches[i].DeltaY = math_rand( -0.5, -2.0 );
        if ( i < 2 )
          Watches[i].Scale = math_rand( 0.9, 1.3 );
        else
          Watches[i].Scale = math_rand( 0.6, 0.9 );
        Add( Watches[i], 0 );
      }

      /* fade-out or fade-in watch if necessary */
      if ( (int32)Watches[i].YPos < 0 )
      {
        if ( Watches[i].Opacity > 0x10 )
          Watches[i].Opacity -= 0x10;
        else
          Watches[i].Opacity = 0x00;
      }
      else if ( Watches[i].Opacity < 0xFF )
      {
        if ( Watches[i].Opacity < 0xEF )
          Watches[i].Opacity += 0x10;
        else
          Watches[i].Opacity = 0xFF;
      }

      /* finally, make the animation */
      Watches[i].Animate();

      /* remove old watch if necessary */
      if ( Watches[i].Opacity == 0 )
      {
        Remove( Watches[i] );
        Watches[i] = null;
      }
    }


  }

  $rect <500,90,700,130>
  object Core::Timer AnimationTimer
  {
    preset OnTrigger = AnimationTimerSlot;
    preset Period = 10;
    preset Enabled = true;
  }

  $rect <500,190,700,230>
  array AnimatedWatch::WarpGroup Watches[ 4 ];

  $rect <20,20,160,60>
  object Views::Image Background
  {
    preset Layout = Core::Layout[AlignToBottom, AlignToLeft, AlignToRight, AlignToTop, ResizeHorz, ResizeVert];
    preset Bounds = <0,0,480,480>;
    preset Alignment = Views::ImageAlignment[AlignHorzCenter, AlignVertCenter, ScaleToFill, ScaleToFit];
    preset Bitmap = AnimatedWatch::Background;
  }

  $rect <20,20,160,60>
  object AnimatedWatch::Watch1 Watch1
  {
    preset Bounds = <0,240,240,480>;
    preset Buffered = true;
    preset Visible = false;
  }

  $rect <20,20,160,60>
  object AnimatedWatch::Watch2 Watch2
  {
    preset Bounds = <233,0,473,240>;
    preset Buffered = true;
    preset Visible = false;
  }
}

$rect <450,20,640,60>
$output false
class WarpGroup : Views::WarpGroup
{
  $rect <20,70,220,110>
  property float DeltaAngle = 0.8;

  $rect <19,22,219,62>
  property float Angle;

  $rect <231,68,431,108>
  property float DeltaX = 0.8;

  $rect <230,20,430,60>
  property float XPos;

  $rect <441,68,641,108>
  property float DeltaY = 0.8;

  $rect <440,20,640,60>
  property float YPos;

  $rect <650,20,850,60>
  property float Scale;

  $rect <20,150,220,190>
  property AnimatedWatch::Base Watch;

  $rect <20,190,220,230>
  onset Watch
  {
    // The value doesn't change - nothing to do.
    if ( pure Watch == value )
      return;

    // Remember the property's new value.
    pure Watch = value;

    if ( Watch != null )
    {
      Group = value;       
    }
  }

  // The method 'Animate' calculates the next animation step of the image object.
  $rect <20,260,220,300>
  method void Animate()
  {
    /* first we have to modify the current translation in X/Y direction of the image */
    XPos += DeltaX;
    YPos += DeltaY;

    /* calculate the next rotation angle */
    Angle = Angle + DeltaAngle;

    var Graphics::WarpMatrix m = new Graphics::WarpMatrix;
    m.LoadIdentity();
    m.EyeDistance = 240.0 * Scale;
    m.Scale( Scale, Scale, Scale );
    m.Rotate( Angle * 0.9, Angle, Angle );

    Warp3D( point( (int32)XPos, (int32)YPos), m );




  }

  // This class is derived from Views::WarpGroup and stores the current attributes \
  // of a watch shown within the AnimatedWatch::AnimatedWatch.
  // 
  // The method Animate() is called to calculate the next animation phase of the \
  // watch.
  note legend Note
  {
    attr Bounds = <20,330,620,430>;
  }
}

$rect <230,20,430,60>
$output false
resource Resources::Bitmap Background
{
  attr bitmapfile FileName = .\Res\Background.png;
  attr bitmapdithering Dithering = Auto;
  attr framesize FrameSize;
  attr framedelay FrameDelay;
  attr bitmapformat Format = RGB565;
  attr bitmapmode Mode = Default;
}

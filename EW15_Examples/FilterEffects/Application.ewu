  $rect <820,140,1020,180>
  slot onUseMask
  {
    if ( ToggleUseMask.Checked ) FilterScreen.MaskBitmap = mask;
    else                         FilterScreen.MaskBitmap = null;

    Status1.Visible = !( Status3.Visible = ToggleUseMask.Checked );
    ToggleMaskInverted.Enabled = ToggleMaskBeforeBlur.Enabled = ToggleUseMask.Checked;
  }

  $rect <820,240,1020,280>
  slot onLoadModeItem
  {
    var string name;

    // Which item should be loaded?
    switch ( ListTintMode.View.Item )
    {
      case  0 : name = "None";
      case  1 : name = "Grayscale";
      case  2 : name = "Tint by Opacity";
      case  3 : name = "Tint by luminance";
      default : name = "???";
    }

    // Initialize the item
    ListTintMode.View.String = name;
  }

  $rect <1020,240,1220,280>
  slot onSelectMode
  {
    switch ( ListTintMode.SelectedItem )
    {
      case 1 :  FilterScreen.TintMode = Graphics::TintMode.Grayscale;
      case 2 :  FilterScreen.TintMode = Graphics::TintMode.TintByOpacity;
      case 3 :  FilterScreen.TintMode = Graphics::TintMode.TintByLuminance;
      default : FilterScreen.TintMode = Graphics::TintMode.None;
    }

    Status2.Visible = ( ListTintMode.SelectedItem == Graphics::TintMode.TintByOpacity ) ||
                      ( ListTintMode.SelectedItem == Graphics::TintMode.TintByLuminance );

    SliderIntensity.Enabled = ListTintMode.SelectedItem != 0;
    Label6.Color            = ( ListTintMode.SelectedItem != 0 )? #6C6C6CFF : #B3B3B3FF;
  }

  $rect <820,280,1020,320>
  slot onIntensity
  {
    FilterScreen.TintIntensity = float( SliderIntensity.CurrentValue ) / 255.0;
  }

  $rect <820,420,1020,460>
  slot onStartDragging
  {
    var rect componentRect = Menu.Bounds;
    var rect maskRect      = rect(<0,0>, mask.FrameSize ) + FilterScreen.MaskOrigin + FilterScreen.Bounds.origin;

    componentRect.y2 = componentRect.y1 + 55;

    draggingComponent = false;
    draggingMask   = false;

    if ( FilterScreen.MaskBitmap && ( maskRect == SimpleTouchHandler.CurrentPos ))
    {
      draggingMask        = true;
      draggingStartOrigin = FilterScreen.MaskOrigin;
    }

    else if ( componentRect == SimpleTouchHandler.CurrentPos )
    {
      draggingComponent   = true;
      draggingStartOrigin = Menu.Bounds.origin;
    }

    else
    {
      SimpleTouchHandler.Enabled = false;
      GetRoot().RetargetCursor( null, null, SimpleTouchHandler );
      SimpleTouchHandler.Enabled = true;
    }
  }

  $rect <820,460,1020,500>
  slot onDragging
  {
    if ( draggingComponent )
      Menu.Bounds.origin = draggingStartOrigin + SimpleTouchHandler.CurrentPos - 
                           SimpleTouchHandler.HittingPos;

    if ( draggingMask )
      FilterScreen.MaskOrigin = draggingStartOrigin + SimpleTouchHandler.CurrentPos - 
                               SimpleTouchHandler.HittingPos;
  }

  $rect <20,510,220,550>
  object Core::Timer Timer
  {
    preset OnTrigger = onTimer;
    preset Begin = 1;
    preset Enabled = true;
  }

  $rect <1020,140,1220,180>
  var Resources::Bitmap mask = Application::Mask;

  $rect <1020,420,1220,460>
  var bool draggingComponent;

  $rect <1020,460,1220,500>
  var bool draggingMask;

  $rect <1020,500,1220,540>
  var point draggingStartOrigin;

  $rect <220,510,420,550>
  slot onTimer
  {
    TimeText.String = ( new Core::Time ).CurrentTime.Format( "%H:%M:%S" );
  }

  $rect <20,550,220,590>
  inherited property Focus = null;
}


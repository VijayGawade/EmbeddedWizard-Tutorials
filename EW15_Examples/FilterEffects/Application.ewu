    ToggleMaskInverted.Enabled = ToggleMaskBeforeBlur.Enabled = ToggleUseMask.Checked;
  }

  $rect <820,240,1020,280>
  slot onLoadModeItem
  {
    var string name;

    // Which item should be loaded?
    switch ( ListTintMode.View.Item )
    {
      case  0 : name = "None";
      case  1 : name = "Grayscale";
      case  2 : name = "Tint by Opacity";
      case  3 : name = "Tint by luminance";
      default : name = "???";
    }

    // Initialize the item
    ListTintMode.View.String = name;
  }

  $rect <1020,240,1220,280>
  slot onSelectMode
  {
    switch ( ListTintMode.SelectedItem )
    {
      case 1 : FilterGroup.TintMode = Graphics::TintMode.Grayscale;
      case 2 : FilterGroup.TintMode = Graphics::TintMode.TintByOpacity;
      case 3 : FilterGroup.TintMode = Graphics::TintMode.TintByLuminance;
      default : FilterGroup.TintMode = Graphics::TintMode.None;
    }

    Status2.Visible = ( ListTintMode.SelectedItem == Graphics::TintMode.TintByOpacity ) ||
                      ( ListTintMode.SelectedItem == Graphics::TintMode.TintByLuminance );

    SliderIntensity.Enabled = ListTintMode.SelectedItem != 0;
    Label6.Color            = ( ListTintMode.SelectedItem != 0 )? #6C6C6CFF : #B3B3B3FF;
  }

  $rect <820,280,1020,320>
  slot onIntensity
  {
    FilterGroup.TintIntensity = float( SliderIntensity.CurrentValue ) / 255.0;
  }

  $rect <820,420,1020,460>
  slot onStartDragging
  {
    var rect imageRect = Menu.Bounds.orect + FilterGroup.Origin + FilterGroup.Bounds.origin;
    var rect maskRect  = rect(<0,0>, mask.FrameSize ) + FilterGroup.MaskOrigin + FilterGroup.Bounds.origin;;

    imageRect.y2 = imageRect.y1 + 55;

    draggingBitmap = false;
    draggingMask   = false;

    if ( FilterGroup.MaskBitmap && ( maskRect == SimpleTouchHandler.CurrentPos ))
    {
      draggingMask        = true;
      draggingStartOrigin = FilterGroup.MaskOrigin;
    }

    else if ( imageRect == SimpleTouchHandler.CurrentPos )
    {
      draggingBitmap      = true;
      draggingStartOrigin = FilterGroup.Origin;
    }

    else
    {
      SimpleTouchHandler.Enabled = false;
      GetRoot().RetargetCursor( null, null, SimpleTouchHandler );
      SimpleTouchHandler.Enabled = true;
    }
  }

  $rect <820,460,1020,500>
  slot onDragging
  {
    if ( draggingBitmap )
      FilterGroup.Origin = draggingStartOrigin + SimpleTouchHandler.CurrentPos - 
                           SimpleTouchHandler.HittingPos;

    if ( draggingMask )
      FilterGroup.MaskOrigin = draggingStartOrigin + SimpleTouchHandler.CurrentPos - 
                               SimpleTouchHandler.HittingPos;
  }

  $rect <220,510,420,550>
  slot onTimer
  {
    TimeText.String = ( new Core::Time ).CurrentTime.Format( "%H:%M:%S" );
  }

  $rect <20,510,220,550>
  object Core::Timer Timer
  {
    preset OnTrigger = onTimer;
    preset Begin = 1;
    preset Enabled = true;
  }

  $rect <1020,140,1220,180>
  var Resources::Bitmap mask = Application::Mask;

  $rect <1020,420,1220,460>
  var bool draggingBitmap;

  $rect <1020,460,1220,500>
  var bool draggingMask;

  $rect <1020,500,1220,540>
  var point draggingStartOrigin;

  $rect <20,550,220,590>
  inherited property Focus = null;
}


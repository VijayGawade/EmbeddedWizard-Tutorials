  $rect <20,580,220,620>
  onset Example
  {
    // The value doesn't change - nothing to do.
    if ( pure Example == value )
      return;

    // Remember the property's new value.
    pure Example = value;

    var Core::Group dialog;

    switch ( value )
    {
      case 1 : dialog = new Application::Example1;
      case 2 : dialog = new Application::Example2;
      case 3 : dialog = new Application::Example3;
      case 4 : dialog = new Application::Example4;
      case 5 : dialog = new Application::Example5;
      default : return;
    }

    SwitchToDialog( dialog, ShowHideTransition, null, null, null, null, null, null, null, null, false );
  }


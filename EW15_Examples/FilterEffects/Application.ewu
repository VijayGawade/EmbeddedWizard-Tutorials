  $rect <820,140,1020,180>
  slot onUseMask
  {
    if ( ToggleUseMask.Checked ) FilterImage.MaskBitmap = mask;
    else                         FilterImage.MaskBitmap = null;

    Status1.Visible = !( Status3.Visible = ToggleUseMask.Checked );
    ToggleMaskInverted.Enabled = ToggleMaskBeforeBlur.Enabled = ToggleUseMask.Checked;
  }

  $rect <820,240,1020,280>
  slot onLoadModeItem
  {
    var string name;

    // Which item should be loaded?
    switch ( ListTintMode.View.Item )
    {
      case  0 : name = "None";
      case  1 : name = "Grayscale";
      case  2 : name = "Tint by Opacity";
      case  3 : name = "Tint by luminance";
      default : name = "???";
    }

    // Initialize the item
    ListTintMode.View.String = name;
  }

  $rect <1020,240,1220,280>
  slot onSelectMode
  {
    switch ( ListTintMode.SelectedItem )
    {
      case 1 : FilterImage.TintMode = Graphics::TintMode.Grayscale;
      case 2 : FilterImage.TintMode = Graphics::TintMode.TintByOpacity;
      case 3 : FilterImage.TintMode = Graphics::TintMode.TintByLuminance;
      default : FilterImage.TintMode = Graphics::TintMode.None;
    }

    Status2.Visible = ( ListTintMode.SelectedItem == Graphics::TintMode.TintByOpacity ) ||
                      ( ListTintMode.SelectedItem == Graphics::TintMode.TintByLuminance );

    SliderIntensity.Enabled = ListTintMode.SelectedItem != 0;
    Label6.Color            = ( ListTintMode.SelectedItem != 0 )? #6C6C6CFF : #B3B3B3FF;
  }

  $rect <820,280,1020,320>
  slot onIntensity
  {
    FilterImage.TintIntensity = float( SliderIntensity.CurrentValue ) / 255.0;
  }

  $rect <820,350,1020,390>
  slot onStartDragging
  {
    var rect bitmapRect = rect(<0,0>, FilterImage.Bitmap.FrameSize ) + FilterImage.Origin + FilterImage.Bounds.origin;
    var rect maskRect   = rect(<0,0>, mask.FrameSize ) + FilterImage.MaskOrigin + FilterImage.Bounds.origin;

    draggingBitmap = false;
    draggingMask   = false;

    if ( FilterImage.MaskBitmap && ( maskRect == SimpleTouchHandler.CurrentPos ))
    {
      draggingMask        = true;
      draggingStartOrigin = FilterImage.MaskOrigin;
    }

    else if ( bitmapRect == SimpleTouchHandler.CurrentPos )
    {
      draggingBitmap      = true;
      draggingStartOrigin = FilterImage.Origin;
    }
  }

  $rect <820,390,1020,430>
  slot onDragging
  {
    if ( draggingBitmap )
      FilterImage.Origin = draggingStartOrigin + SimpleTouchHandler.CurrentPos - 
                           SimpleTouchHandler.HittingPos;

    if ( draggingMask )
      FilterImage.MaskOrigin = draggingStartOrigin + SimpleTouchHandler.CurrentPos - 
                               SimpleTouchHandler.HittingPos;
  }

  $rect <220,510,420,550>
  slot onTimer
  {
    TimeText.String = ( new Core::Time ).CurrentTime.Format( "%H:%M:%S" );
  }

  $rect <20,510,220,550>
  object Core::Timer Timer
  {
    preset OnTrigger = onTimer;
    preset Begin = 1;
    preset Enabled = true;
  }

  $rect <1020,140,1220,180>
  var Resources::Bitmap mask = Application::Mask;

  $rect <1020,350,1220,390>
  var bool draggingBitmap;

  $rect <1020,390,1220,430>
  var bool draggingMask;

  $rect <1020,430,1220,470>
  var point draggingStartOrigin;


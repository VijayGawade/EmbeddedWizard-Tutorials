$version 15.00

// Flat Widgets as customized default widgets
note group NoteGroup
{
  attr Bounds = <20,10,880,690>;
}

$rect <40,60,450,100>
$output false
autoobject WidgetSet::PushButtonConfig PushButton
{
  preset LabelColorActive = FlatWidgets::ColorOfBackground;
  preset LabelColorFocused = FlatWidgets::ColorOfBackground;
  preset LabelColorDisabled = FlatWidgets::ColorOfBackground;
  preset LabelColorDefault = FlatWidgets::ColorOfBackground;
  preset LabelFont = Resources::FontMedium;
  preset FaceTintActive = FlatWidgets::ColorOfTheme;
  preset FaceTintFocused = FlatWidgets::ColorOfTouch;
  preset FaceTintDisabled = FlatWidgets::ColorOfDisabled;
  preset FaceTintDefault = FlatWidgets::ColorOfTouch;
  preset FaceBitmapActive = FlatWidgets::FlatFrame;
  preset FaceBitmapFocused = FlatWidgets::FlatFrame;
  preset FaceBitmapDisabled = FlatWidgets::FlatFrame;
  preset FaceBitmapDefault = FlatWidgets::FlatFrame;
}

$rect <450,60,650,100>
$output false
resource Resources::Bitmap FlatFrame
{
  attr bitmapfile FileName = .\FlatRes\FlatFrame.png;
  attr framesize FrameSize;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Alpha8;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}


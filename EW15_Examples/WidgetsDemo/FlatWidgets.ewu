// Bitmap resource - used in demo applications as background.
$rect <480,710,680,750>
$output false
resource Resources::Bitmap FlatBackground
{
  attr bitmapfile FileName = .\FlatRes\FlatDemoBackground.png;
  attr framesize FrameSize;
  attr framedelay FrameDelay;
  attr bitmapformat Format = Native;
  attr bitmapdithering Dithering = Auto;
  attr bitmapmode Mode = Default;
}

// Color constant representing the main theme color of the widget kit.
$rect <40,740,240,780>
$output false
const color ColorOfTheme = #7FBF00FF;

// Color constant for all touchable items.
$rect <40,780,240,820>
$output false
const color ColorOfTouch = #FFFFFFFF;

// Color constant for all widget bodies.
$rect <40,820,240,860>
$output false
const color ColorOfBody = #50535FFF;

// Color constant for all disabled items.
$rect <240,740,440,780>
$output false
const color ColorOfDisabled = #6B6F80FF;

// Color constant for all items that should appear like the background.
$rect <240,780,440,820>
$output false
const color ColorOfBackground = #000000FF;

// Color Constants for Flat Widgets
note group NoteGroup1
{
  attr Bounds = <20,700,460,890>;
}

$rect <40,140,450,180>
$output false
autoobject WidgetSet::ToggleButtonConfig ToggleButton
{
  preset LabelOnColorActive = FlatWidgets::ColorOfTheme;
  preset LabelOnColorFocused = FlatWidgets::ColorOfTheme;
  preset LabelOnColorDisabled = FlatWidgets::ColorOfDisabled;
  preset LabelOnColorDefault = FlatWidgets::ColorOfTheme;
  preset LabelOffColorActive = FlatWidgets::ColorOfTouch;
  preset LabelOffColorFocused = FlatWidgets::ColorOfTouch;
  preset LabelOffColorDisabled = FlatWidgets::ColorOfDisabled;
  preset LabelOffColorDefault = FlatWidgets::ColorOfTouch;
  preset LabelMarginLeft = 40;
  preset IconOnTintActive = FlatWidgets::ColorOfBackground;
  preset IconOnTintFocused = FlatWidgets::ColorOfBackground;
  preset IconOnTintDisabled = FlatWidgets::ColorOfBackground;
  preset IconOnTintDefault = FlatWidgets::ColorOfBackground;
  preset IconOffTintActive = FlatWidgets::ColorOfBackground;
  preset IconOffTintFocused = FlatWidgets::ColorOfBackground;
  preset IconOffTintDisabled = FlatWidgets::ColorOfBackground;
  preset IconOffTintDefault = FlatWidgets::ColorOfBackground;
  preset IconMarginLeft = 3;
  preset LabelAlignment = Views::TextAlignment[AlignHorzLeft, AlignVertCenter];
  preset LabelOnFont = Resources::FontMedium;
  preset LabelOffFont = Resources::FontMedium;
  preset IconAlignment = Views::ImageAlignment[AlignHorzLeft, AlignVertCenter];
  preset FaceLayout = Core::Layout[AlignToBottom, AlignToLeft, AlignToTop];
  preset FaceOnTintActive = FlatWidgets::ColorOfTouch;
  preset FaceOnTintFocused = FlatWidgets::ColorOfTheme;
  preset FaceOnTintDisabled = FlatWidgets::ColorOfDisabled;
  preset FaceOnTintDefault = FlatWidgets::ColorOfTheme;
  preset FaceOnBitmapActive = FlatWidgets::FlatFrame;
  preset FaceOnBitmapFocused = FlatWidgets::FlatFrame;
  preset FaceOnBitmapDisabled = FlatWidgets::FlatFrame;
  preset FaceOnBitmapDefault = FlatWidgets::FlatFrame;
  preset FaceOffTintActive = FlatWidgets::ColorOfTheme;
  preset FaceOffTintFocused = FlatWidgets::ColorOfTouch;
  preset FaceOffTintDisabled = FlatWidgets::ColorOfDisabled;
  preset FaceOffTintDefault = FlatWidgets::ColorOfTouch;
  preset FaceOffBitmapActive = FlatWidgets::FlatFrame;
  preset FaceOffBitmapFocused = FlatWidgets::FlatFrame;
  preset FaceOffBitmapDisabled = FlatWidgets::FlatFrame;
  preset FaceOffBitmapDefault = FlatWidgets::FlatFrame;
  preset WidgetMinSize = <30,30>;
}

$rect <40,180,450,220>
$output false
autoobject WidgetSet::ToggleButtonConfig CheckBox
{
  preset LabelOnColorActive = FlatWidgets::ColorOfTouch;
  preset LabelOnColorFocused = FlatWidgets::ColorOfTouch;
  preset LabelOnColorDisabled = FlatWidgets::ColorOfDisabled;
  preset LabelOnColorDefault = FlatWidgets::ColorOfTouch;

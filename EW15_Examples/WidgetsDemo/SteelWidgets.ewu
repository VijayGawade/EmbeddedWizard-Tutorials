  preset TrackBelowFrameDefault = 1;
  preset TrackBelowBitmapActive = SteelWidgets::SteelVertSliderTrack;
  preset TrackBelowBitmapFocused = SteelWidgets::SteelVertSliderTrack;
  preset TrackBelowBitmapDisabled = SteelWidgets::SteelVertSliderTrack;

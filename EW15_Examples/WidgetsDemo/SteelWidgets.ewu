$rect <40,60,450,100>
$output false
autoobject WidgetSet::PushButtonConfig PushButton
{
  preset LabelColorActive = #FFFFFFFF;
  preset LabelColorFocused = #FFFFFFFF;
  preset LabelColorDisabled = #A8ABABFF;
  preset LabelColorDefault = #FFFFFFFF;
  preset LabelMarginTop = 70;
  preset IconTintDisabled = #FFFFFF88;
  preset LabelAlignment = Views::TextAlignment[AlignHorzCenter, AlignVertTop];
  preset LabelFont = Resources::FontMedium;
  preset FaceLayout = Core::Layout[AlignToLeft, AlignToRight, AlignToTop];
  preset FaceFrameActive = 4;
  preset FaceFrameFocused = 3;
  preset FaceFrameDisabled = 0;
  preset FaceFrameDefault = 1;
  preset FaceBitmapActive = SteelWidgets::SteelPushButton;
  preset FaceBitmapFocused = SteelWidgets::SteelPushButton;
  preset FaceBitmapDisabled = SteelWidgets::SteelPushButton;
  preset FaceBitmapDefault = SteelWidgets::SteelPushButton;
  preset WidgetMinSize = <70,70>;
}

$rect <40,100,450,140>
$output false
autoobject WidgetSet::ToggleButtonConfig Switch
{
  preset LabelOnColorActive = #6C6E70FF;
  preset LabelOnColorFocused = #6C6E70FF;
  preset LabelOnColorDisabled = #A8ABABFF;
  preset LabelOnColorDefault = #6C6E70FF;
  preset LabelOffColorActive = #6C6E70FF;
  preset LabelOffColorFocused = #6C6E70FF;
  preset LabelOffColorDisabled = #A8ABABFF;
  preset LabelOffColorDefault = #6C6E70FF;
  preset LabelMarginTop = 50;
  preset LabelAlignment = Views::TextAlignment[AlignHorzCenter, AlignVertTop];
  preset LabelOnFont = Resources::FontMedium;
  preset LabelOffFont = Resources::FontMedium;
  preset FaceLayout = Core::Layout[AlignToLeft, AlignToRight, AlignToTop];
  preset FaceOnFrameActive = 7;
  preset FaceOnFrameFocused = 5;
  preset FaceOnFrameDisabled = 1;
  preset FaceOnFrameDefault = 3;
  preset FaceOnBitmapActive = SteelWidgets::SteelSwitch;
  preset FaceOnBitmapFocused = SteelWidgets::SteelSwitch;
  preset FaceOnBitmapDisabled = SteelWidgets::SteelSwitch;
  preset FaceOnBitmapDefault = SteelWidgets::SteelSwitch;
  preset FaceOffFrameActive = 6;
  preset FaceOffFrameFocused = 4;
  preset FaceOffFrameDisabled = 0;
  preset FaceOffFrameDefault = 2;
  preset FaceOffBitmapActive = SteelWidgets::SteelSwitch;
  preset FaceOffBitmapFocused = SteelWidgets::SteelSwitch;
  preset FaceOffBitmapDisabled = SteelWidgets::SteelSwitch;
  preset FaceOffBitmapDefault = SteelWidgets::SteelSwitch;
  preset WidgetMinSize = <90,50>;
}


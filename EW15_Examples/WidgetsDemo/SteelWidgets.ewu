$rect <40,220,450,260>
$output false
autoobject WidgetSet::RotaryKnobConfig RotaryKnob
{
  preset ThumbMaxAngle = -135;
  preset ThumbMinAngle = 135;
  preset ThumbPivot = <2,25>;
  preset ThumbBitmapActive = SteelWidgets::SteelRotaryKnobMark;
  preset ThumbBitmapFocused = SteelWidgets::SteelRotaryKnobMark;
  preset ThumbBitmapDefault = SteelWidgets::SteelRotaryKnobMark;
  preset ScaleFrameActive = 2;
  preset ScaleFrameFocused = 2;
  preset ScaleFrameDisabled = 0;
  preset ScaleFrameDefault = 1;
  preset ScaleBitmapActive = SteelWidgets::SteelRotaryKnobBack;
  preset ScaleBitmapFocused = SteelWidgets::SteelRotaryKnobBack;
  preset ScaleBitmapDisabled = SteelWidgets::SteelRotaryKnobBack;
  preset ScaleBitmapDefault = SteelWidgets::SteelRotaryKnobBack;
}

// Steel Widgets as customized default widgets
note group NoteGroup3
{
  attr Bounds = <20,10,1070,320>;
}

$rect <40,260,450,300>
$output false
autoobject WidgetSet::GaugeConfig Gauge
{
  preset SwingElastic = false;
  preset SwingDuration = 1000;
  preset CoverBitmap = SteelWidgets::SteelGaugeFront;
  preset NeedleMaxAngle = -50;
  preset NeedleMinAngle = 50;
  preset NeedlePivot = <3,89>;
  preset NeedleBitmap = SteelWidgets::SteelGaugeNeedle;
  preset CenterOffset = <0,42>;
  preset ScaleBitmap = SteelWidgets::SteelGaugeBack;
  preset WidgetMaxSize = <172,122>;
  preset WidgetMinSize = <172,122>;
}


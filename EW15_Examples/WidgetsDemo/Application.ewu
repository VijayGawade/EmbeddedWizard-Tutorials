// This class implements the interface between the GUI application and the device.
$rect <20,290,220,330>
$output false
class DeviceClass
{
  $rect <220,20,420,60>
  onset Int32Value
  {
    // The property doesn't change -> nothing to do.
    if ( pure Int32Value == value )
      return;

    // Remember the new value in the internal memory of the property.
    pure Int32Value = value;

    // For target code generation you will use your specific device API 
    // to change the affected value.
    $if !$prototyper
      native ( value )
      {
        /*
           TO DO:

           You can call a function of your own device API or you simply
           modify a variable existing in your middleware to reflect the
           new value:

           YourDevice_SetSomeValue( value );

           or

           YourDevice_SomeVariable = value;
        */
      }
    $endif

    // Notify all associated property observers.
    notifyobservers ^Int32Value;
  }

  // This property represents an individual setting or state value existing within \
  // the device.
  $rect <20,20,220,60>
  property int32 Int32Value = 60;

  // This property represents an individual setting or state value existing within \
  // the device.
  $rect <20,70,220,110>
  property bool BoolValue = false;

  $rect <220,70,420,110>
  onset BoolValue
  {
    // The property doesn't change -> nothing to do.
    if ( pure BoolValue == value )
      return;

    // Remember the new value in the internal memory of the property.
    pure BoolValue = value;

    // For target code generation you will use your specific device API 
    // to change the affected value.
    $if !$prototyper
      native ( value )
      {
        /*
           TO DO:

           You can call a function of your own device API or you simply
           modify a variable existing in your middleware to reflect the
           new value:

           YourDevice_SetSomeValue( value );

           or

           YourDevice_SomeVariable = value;
        */
      }
    $endif

    // Notify all associated property observers.
    notifyobservers ^BoolValue;
  }

  // This is a bool change effect.
  $rect <440,70,640,110>
  object Effects::BoolEffect BoolEffect
  {
    preset Outlet = ^BoolValue;
  }

  // This is an int32 change effect.
  $rect <440,20,640,60>
  object Effects::Int32Effect Int32Effect
  {
    preset Symmetric = true;
    preset CycleDuration = 10000;
    preset Value2 = 90;
    preset Value1 = 10;
    preset Outlet = ^Int32Value;
  }

  // Slot method to activate the automatic animation of the device properties.
  $rect <20,130,220,170>
  slot AutoDemoOn
  {
    sender; /* the method is called from the sender object */   

    Int32Effect.Enabled = true;
    BoolEffect.Enabled = true;

  }

  // Slot method to deactivate the automatic animation of the device properties.
  $rect <20,170,220,210>
  slot AutoDemoOff
  {
    sender; /* the method is called from the sender object */

    Int32Effect.Enabled = false;
    BoolEffect.Enabled = false;

  }

  // This is a simple device class for demo purposes. It just contains two values: \
  // One int32 value and one bool value. All widgets of this demo application refer \
  // to this two device properties. As a result, all widgets will show or interact \
  // with the same data.
  note legend Note
  {
    attr Bounds = <230,130,640,250>;
  }
}

// This object represents an instance of the device interface implemented in the \
// class Application::DeviceClass.
$rect <230,290,430,330>
autoobject Application::DeviceClass Device;

// The class 'Application::DeviceClass' implements the interface between the GUI \
// application and the device. Within this demo, the device contains just one int32 \
// and one bool value.
// The object 'Device' represents the instance of the device interface. It exists \
// for convenience. As an autoobject it is globaly available for all GUI components \
// within your project.
note legend Note
{
  attr Bounds = <450,290,1050,400>;
}


$version 15.00

// This is the root component of the entire GUI application.
$rect <20,20,220,60>
$output false
class Application : Core::Root
{
  $rect <890,370,1090,410>
  inherited property Bounds = <0,0,640,480>;

  $rect <690,200,890,240>
  inherited method DriveCursorHitting()
  {
    idlesignal ResetDemo;

    return  super( aDown, aFinger, aPos );

  }

  // Timer object to drive the auto demo mode.
  $rect <690,250,890,290>
  object Core::Timer AutoTimer
  {
    preset OnTrigger = AutoDemo;
    preset Period = 1000;
    preset Begin = 15000;
    preset Enabled = true;
  }

  // This is a slot method to trigger the next phase of the auto demo.
  $rect <890,250,1090,290>
  slot AutoDemo
  {
    sender; /* the method is called from the sender object */

    postsignal Device.AutoDemoOn;

    if ( AutoState == 0 )
      ChangePage( 0 );
    else if ( AutoState == 10 )
      ChangePage( 1 );
    else if ( AutoState == 20 )
      ChangePage( 2 );
    else if ( AutoState == 30 )
      ChangePage( 3 );

    AutoState = AutoState + 1;
    if ( AutoState > 40 )
      AutoState = 0;


  }

  $rect <890,290,1090,330>
  var int32 AutoState = 0;

  $rect <690,290,890,330>
  slot ResetDemo
  {
    sender; /* the method is called from the sender object */

    AutoState = 0;
    AutoTimer.Enabled = false;
    AutoTimer.Enabled = true;

    postsignal Device.AutoDemoOff;
  }

  // This is a generic touch handler.
  $rect <20,20,160,60>
  object Core::SimpleTouchHandler LeftTouch
  {
    preset Layout = Core::Layout[AlignToBottom, AlignToRight, AlignToTop, ResizeVert];
    preset Point4 = <0,480>;
    preset Point3 = <40,480>;
    preset Point2 = <40,0>;
    preset Point1 = <0,0>;
    preset OnPress = OnLeft;
  }

  // This is a generic touch handler.
  $rect <20,20,160,60>
  object Core::SimpleTouchHandler RightTouch
  {
    preset Layout = Core::Layout[AlignToBottom, AlignToRight, AlignToTop, ResizeVert];
    preset Point4 = <600,480>;
    preset Point3 = <640,480>;
    preset Point2 = <640,0>;
    preset Point1 = <600,0>;
    preset OnPress = OnRight;
  }

  $rect <20,20,160,60>
  object Views::Rectangle RectangleLeft
  {
    preset Bounds = <0,0,40,480>;
    preset Color = #444444FF;
  }

  $rect <20,20,160,60>
  object Views::Rectangle RectangleRight
  {
    preset Bounds = <600,0,640,480>;
    preset Color = #444444FF;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image ImageLeft
  {
    preset Bounds = <0,210,40,255>;
    preset FrameNumber = 2;
    preset Bitmap = Resources::NavigationIconsLarge;
  }

  // This is an image view.
  $rect <20,20,160,60>
  object Views::Image ImageRight
  {
    preset Bounds = <600,210,640,255>;
    preset FrameNumber = 3;
    preset Bitmap = Resources::NavigationIconsLarge;
  }

  // Variable to keep the device class within the memory.
  $rect <690,420,890,460>
  var Application::DeviceClass Device = Application::Device;

  // Slot method to start action when user has pressed the open history button.
  $rect <690,50,890,90>
  slot OnLeft
  {
    sender; /* the method is called from the sender object */

    ChangePage( pageNo - 1 );

  }

  $rect <890,50,1090,90>
  var int32 pageNo = -1;

  // Slot method to start action when user has pressed the open history button.
  $rect <690,90,890,130>
  slot OnRight
  {
    sender; /* the method is called from the sender object */

    ChangePage( pageNo + 1 );

  }

  // Auto demo mode
  note group Note
  {
    attr Bounds = <670,160,1110,350>;
  }

  // User navigation
  note group Note1
  {
    attr Bounds = <670,10,1110,150>;
  }

  $rect <890,90,1090,130>
  method void ChangePage( arg int32 aPageNo )
  {
    var Core::Group dialog;

    /* limit given page number */
    if ( aPageNo > 3 )
      aPageNo = 0;
    if ( aPageNo < 0 )
      aPageNo = 3;

    /* check for news */
    if ( pageNo == aPageNo )
      return;

    /* store the new value */
    pageNo = aPageNo;

    /* create the desired page */
    switch ( pageNo )
    {
      case 1: dialog = new Application::PageFlat;
      case 2: dialog = new Application::PageSteel;
      case 3: dialog = new Application::PageOrange;
      default: dialog = new Application::PageDefault;
    }

    /* and switch to the new page */
    SwitchToDialog( dialog, null, null, null, null, null, null, null, null, null, false );

  }

  $rect <690,370,890,410>
  inherited method Init()
  {
    ChangePage( 0 );

  }

  // Directives to adapt the order of members belonging to this class so they appear 
  // correctly arranged relative to the members inherited from the ancestor (super) 
  // classes. The numbers indicate the order-displacement to apply on the respective 
  // member once all members have been loaded and combined with members from the 
  // ancestor classes.

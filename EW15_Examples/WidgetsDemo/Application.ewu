    preset OutletSelector = 80;
    preset Outlet = ^Application::Device.Int32Value;
    preset Label = "Value 80";
    preset Appearance = WidgetSet::RadioButton_Lime_Medium;
  }

  $rect <20,20,160,60>
  object WidgetSet::ToggleButton ToggleButton1
  {
    preset Bounds = <380,20,535,70>;
    preset Outlet = ^Application::Device.BoolValue;
    preset Label = "CheckBox";
    preset Appearance = WidgetSet::CheckBox_Lime_Medium;
  }

  $rect <20,20,160,60>

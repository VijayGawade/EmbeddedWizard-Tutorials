$version 15.00

// Game Components
note group Note2
{
  attr Bounds = <20,110,660,220>;
}

// Application class of the example
note group Note1
{
  attr Bounds = <20,0,660,100>;
}

// This inline code brick contains some #include directives for 'C' header files \
// of the external 'C' application.
$rect <240,160,430,200>
inline Inline
{
  #include "gameapi.h"
}

$rect <40,160,240,200>
$output false
class Game : Views::Applet
{
  // The Done() destructor forces the deinitialization of the infrastructure inherited \
  // from the base class Views::Applet.
  $rect <710,60,910,100>
  inherited method Done()
  {
    // When the object is disposed - destroy the external application
    //
    // Destroy() will then call the OnDestroy() method.
    Destroy();
  }

  // The Init() constructor forces the initialization of the infrastructure inherited \
  // from the Views::Applet class.
  $rect <710,20,910,60>
  inherited method Init()
  {
    // After the object has been created - initialize the external application.
    //
    // Create() will then call the OnCreate() method.
    Create();
  }

  $rect <710,140,910,180>
  inherited property Bounds;

  $rect <250,340,450,380>
  inherited method OnDragEvent()
  {
    // Dummy expresion to avoid Chora warnings if the parameters are not used.
    aHandle;
    aEvent;

    /*

      The aim of this method is to feed the external application with touch (or
      mouse) events when such events arrive to the Applet view.

      HINT 1:

      If the external application does not handle any cursor nor mouse events,
      ignore this method.

    */

    var bool processed;

    // From the event extract the provided touch (or mouse) position and a number
    // identifying the finger (or mouse button). The first finger (or left mouse
    // button) has the nuber 0. The second finger (or mouse right button) has the
    // number 1. The numbers 2 .. 9 identify events generated by other fingers and
    // are useful during a multi-touch interaction:
    var point currentPos  = aEvent.CurrentPos;
    var int32 finger      = aEvent.Finger;


    // 'hittingPos' determines the position where the user has originally touched
    // (or clicked with mouse). 'offset' is displacement relative to the preceding
    // Cursor or Drag Event.
    var point hittingPos  = aEvent.HittingPos;
    var point offset      = aEvent.Offset;


    $if !$prototyper
      native ( aHandle, currentPos, finger, hittingPos, offset, processed )
      {
        /*

          TO DO:
          
          Assuming, you want the Applet view to integrate a GAME application and
          the code needed to feed the drag events is implemented in a 'C' function,
          then invoke the function now:

            processed = Game_Handle_Drag_Event( currentPos );

          If the external application has handled the event, set the value of the
          variable 'processed' to 'true'.


          HINT 2:
          
          Depending on your application case use other variables, e.g. 'finger' to
          identify the fingers within a multi-touch interaction.


          HINT 3:
          
          If necessary use aHandle to identify the external application instance.
          aHandle contains the value obtained at the initialization time of the
          external application within the method OnCreate():

            processed = Game_Handle_Drag_Event( aHandle, currentPos );

        */
      }
    $endif

    $if $prototyper
      /*
      
      TO DO:

        If you have created an Intrinsics module containing the implementation of the
        external application, invoke the Intrinsics now to feed the application with
        touch or mouse events. Assuming, the declaration of the Intrinsics corresponds
        to the above used 'C' functions, just invoke the Intrinsics. For example:

          processed = Game_Handle_Touch_Event_Drag( aHandle, currentPos );

        Doing this, you are able to test the external application already at the design
        time within the Embedded Wizard Studio. More details concerning Intrinsics:

          https://doc.embedded-wizard.de/implement-intrinsics

      */
    $endif

    return processed;
  }

  $rect <250,300,450,340>
  inherited method OnCursorEvent()
  {
    // Dummy expresion to avoid Chora warnings if the parameters are not used.
    aHandle;
    aEvent;

    /*

      The aim of this method is to feed the external application with touch (or
      mouse) events when such events arrive to the Applet view.

      HINT 1:

      If the external application does not handle any cursor nor mouse events,
      ignore this method.

    */

    var bool processed;

    // From the event extract the provided touch (or mouse) position and a number
    // identifying the finger (or mouse button). The first finger (or left mouse
    // button) has the nuber 0. The second finger (or mouse right button) has the
    // number 1. The numbers 2 .. 9 identify events generated by other fingers and
    // are useful during a multi-touch interaction:
    var point currentPos  = aEvent.CurrentPos;
    var int32 finger      = aEvent.Finger;

    // 'strikeCount' determines how often the user has touched (or clicked with 
    // the mouse) the same position in succession. The value is 1 for a single
    // tap, 2 for double-tap and so far. The value 'down' is 'true' if the user
    // touches the screen (or holds the mouse button pressed). When the user
    // ends the interaction (lifts the finger or releases the mouse button) the
    // variable 'down' is 'false':
    var int32 strikeCount = aEvent.StrikeCount;
    var bool  down        = aEvent.Down;

    // While the user continues touching the screen (or pressing the mouse button),
    // the Applet view receives periodically the Cursor Events. 'holdPeriod' stores
    // in such case the time elapsed since the begin on the interaction. Concrete,
    // 'holdPeriod' is 0 for the first event generated when the user touched the
    // screen. The value is expressed in milliseconds:
    var int32 holdPeriod  = aEvent.HoldPeriod;

    $if !$prototyper
      native ( aHandle, currentPos, finger, strikeCount, down, holdPeriod, processed )
      {
        /*

          TO DO:
          
          Assuming, you want the Applet view to integrate a GAME application and
          the code needed to feed the cursor events is implemented in two 'C'
          functions, then invoke the functions now:

            if ( down && !holdPerdiod )
              processed = Game_Handle_Pressed_Event( currentPos );

            if ( !down )
              processed = Game_Handle_Released_Event( currentPos );

          If the external application has handled the event, set the value of the
          variable 'processed' to 'true'.


          HINT 2:
          
          Depending on your application case use other variables, e.g. 'finger' to
          identify the fingers within a multi-touch interaction.


          HINT 3:
          
          If necessary use aHandle to identify the external application instance.
          aHandle contains the value obtained at the initialization time of the
          external application within the method OnCreate():

            if ( down && !holdPerdiod )
              processed = Game_Handle_Pressed_Event( aHandle, currentPos );

            if ( !down )
              processed = Game_Handle_Released_Event( aHandle, currentPos );

        */
      }
    $endif

    $if $prototyper
      /*
      
      TO DO:

        If you have created an Intrinsics module containing the implementation of the
        external application, invoke the Intrinsics now to feed the application with
        touch or mouse events. Assuming, the declaration of the Intrinsics corresponds
        to the above used 'C' functions, just invoke the Intrinsics. For example:

          if ( down && !holdPerdiod )
            processed = Game_Handle_Pressed_Event( aHandle, currentPos );

          if ( !down )
            processed = Game_Handle_Released_Event( aHandle, currentPos );

        Doing this, you are able to test the external application already at the design
        time within the Embedded Wizard Studio. More details concerning Intrinsics:

          https://doc.embedded-wizard.de/implement-intrinsics

      */
    $endif

    return processed;
  }

  $rect <250,250,450,290>
  inherited method OnCursorHitTest()
  {
    // Dummy expresion to avoid Chora warnings if the parameters are not used.
    aHandle;
    aPosition;
    aFinger;
    aStrikeCount;

    /*

      The aim of this method is to test whether the external application is willing
      to handle a touch screen (or mouse) event. Important: the method is NOT
      INTENDED to handle the events. This should be implemented in the both methods
      OnCursorEvent() and OnDragEvent().

      HINT 1:

      If the entire area of the external application is intended to always react to
      touch (or mouse) events regardless of the touched position, then return 'true':

        return true;


      HINT 2:

      If the external application does never handle touch nor mouse events, ignore
      this method or return 'false':

        return true;

    */

    var bool hitTest;

    $if !$prototyper
      native ( aHandle, aPosition, aFinger, aStrikeCount, hitTest )
      {
        /*

          TO DO:
          
          Assuming, you want the Applet view to integrate a GAME application and
          the code needed to test the touch (or mouse) events is implemented in
          a 'C' function, then invoke the function now:
          
            hitTest = Game_Hit_Test( aPosition );

          The parameter aPosition specifies a position in the coordinate space of
          the external application. If the position hits a touch sensitive area
          of the application, the variable 'hitTest' should be set 'true'. 
          Thereupon the Applet view will start processing the touch (or mouse)
          events.


          HINT 3:

          Depending on your application case you can additionally evaluate the
          parameter aFinger. This parameter specifies the number of the finger
          (or mouse button) involved in the actual hit test operation. The first
          finger (or left mouse button) has the number 0. The second finger (or
          right mouse button) has the value 1. The values 2 .. 9 allow to identify
          further fingers and are useful in a multi-touch application cases.

          With the parameter aStrikeCount you can additionally distinguish how
          often the user has tapped the same position in succession. For the first
          touch (or mouse click) the value is 1. For a double tap (double click)
          it is 2 and so far.


          HINT 4:
          
          If necessary use aHandle to identify the external application instance.
          aHandle contains the value obtained at the initialization time of the
          external application within the method OnCreate():

            hitTest = Game_Hit_Test( aHandle, aPosition );

        */
      }
    $endif

    $if $prototyper
      /*
      
      TO DO:

        If you have created an Intrinsics module containing the implementation of the
        external application, invoke the Intrinsics now to perform the cursor hit test.
        Assuming, the declaration of the Intrinsics corresponds to the above used 'C'
        function, just invoke the Intrinsics. For example:

          hitTest = Game_Hit_Test( aHandle, aPosition );

        Doing this, you are able to test the external application already at the design
        time within the Embedded Wizard Studio. More details concerning Intrinsics:

          https://doc.embedded-wizard.de/implement-intrinsics

      */
    $endif

    return hitTest;
  }

  // The method OnGetBitmap() is invoked in order to ask the external 'C' application \
  // for its internal bitmap where the application content is stored.
  // This method is a part of the interface derived from the base class Views::Applet.
  $rect <480,90,680,130>
  inherited method OnGetBitmap()
  {
    // Dummy expresion to avoid Chora warnings if the parameters are not used.
    aHandle;

    /*

      The aim of this method is to access the bitmap used internally by the
      external application as off-screen buffer to store its visible content.
      The Applet will thereupon copy the bitmap content while updating the
      screen.
      
    */

    var handle bitmap;

    $if !$prototyper
      native ( aHandle, bitmap )
      {
        /*
          Assuming, you want the Applet view to integrate a GAME application and
          the code needed to access the bitmap is implemented in a 'C' function,
          then invoke the function now:
        */
          
        bitmap = (XHandle)GameGetBitmap((XGame*)aHandle );
      }
    $endif

    $if $prototyper
      /*
        If you have created an Intrinsics module containing the implementation of the
        external application, invoke the Intrinsics now to access the bitmap. Assuming,
        the declaration of the Intrinsics corresponds to the above used 'C' functions,
        just invoke the Intrinsics.

        Doing this, you are able to test the external application already at the design
        time within the Embedded Wizard Studio. More details concerning Intrinsics:

          https://doc.embedded-wizard.de/implement-intrinsics
      */

      bitmap = GameGetBitmap( aHandle );
    $endif

    return bitmap;
  }

  // The method OnKeyEvent() receives key events from the user and passes them to \
  // the external 'C' application. Usually, the received key codes need to be converted \
  // to the codes supported by the external application. This is also done here.
  // This method is a part of the interface derived from the base class Views::Applet.
  $rect <20,250,220,290>
  inherited method OnKeyEvent()
  {
    // Dummy expresion to avoid Chora warnings if the parameters are not used.
    aHandle;
    aEvent;

    /*

      The aim of this method is to feed the external application with keyboard
      events when such events arrive to the Applet view.

    */

    var point delta;

    // Depending on the key event - calculate the movement of the game figure.
    // React to key down events only.
    if ( aEvent.Down )
      switch ( aEvent.Code )
      {
        case Core::KeyCode.Up    : delta.y = -8;
        case Core::KeyCode.Down  : delta.y =  8;
        case Core::KeyCode.Left  : delta.x = -8;
        case Core::KeyCode.Right : delta.x =  8;

        // Other key events are ignored
        default :;
      }

    // No dispacement - nothing to do. The event is not handled.
    if ( delta == <0,0>)
      return false;

    $if !$prototyper
      native ( aHandle, delta )
      {
        /*
          Assuming, you want the Applet view to integrate a GAME application and
          the game should move a figure by the above calculated offset´. Then
          invoke the corresponding functions now:
        */

        GameMove((XGame*)aHandle, delta );
      }
    $endif

    $if $prototyper
      /*
        If you have created an Intrinsics module containing the implementation of the
        external application, invoke the Intrinsics now to perform the operation.
        Assuming, the declaration of the Intrinsics corresponds to the above used
        'C' functions, just invoke the Intrinsics.

        Doing this, you are able to test the external application already at the design
        time within the Embedded Wizard Studio. More details concerning Intrinsics:

          https://doc.embedded-wizard.de/implement-intrinsics
      */

      GameMove( aHandle, delta );
    $endif

    // The event has been handled.
    return true;
  }

  // The method OnUpdate() is invoked in order to give the external 'C' application \
  // a chance to redraw the screen.
  // This method is a part of the interface derived from the base class Views::Applet. \
  // The method should returns 'rect' value, which describes the affected area of \
  // the view. If nothing is redrawn, the method has to return an empty area <0,0,0,0>.
  $rect <480,50,680,90>
  inherited method OnUpdate()
  {
    // Dummy expresion to avoid Chora warnings if the parameters are not used.
    aHandle;

    /*

      The aim of this method is to query the external application for the dirty
      area to redraw during the next screen update. 

    */

    var rect area;
    var rect bounds = Bounds.orect;

    $if !$prototyper
      native ( aHandle, area, bounds )
      {
        /*
          Assuming, you want the Applet view to integrate a GAME application and
          the code needed to update the external application is implemented in a
          'C' function, then invoke the function now:

          In our example always the entire game area is redrawn - therefore the
          method OnUpdate() returns 'Bound.orect'. Usually, only the affected areas
          should be redrawn and returned. This is then more efective.
        */

        if ( GameUpdate((XGame*)aHandle ))
          area = bounds;
      }
    $endif

    $if $prototyper
      /*
        If you have created an Intrinsics module containing the implementation of the
        external application, invoke the Intrinsics now to query the dirty area. You 
        will eventually need to provide a special version of the Intrinsic able to
        directly return 'rect' operand.

        Doing this, you are able to test the external application already at the design
        time within the Embedded Wizard Studio. More details concerning Intrinsics:

          https://doc.embedded-wizard.de/implement-intrinsics
      */

      if ( GameUpdate( aHandle ))
        area = bounds;
    $endif

    return area;
  }

  // The method OnProgress() can provide an external application with timer events. \
  // It can also be used for idle background processes. In this example, OnProgress() \
  // forces the animation within the external 'C' application.
  // This method is a part of the interface derived from the base class Views::Applet. \
  // There is also a timer object @ProgressTimer contained. To change the timer resultion, \
  // just change the settings of this inherited timer.
  $rect <480,250,680,290>
  inherited method OnProgress()
  {
    // Dummy expresion to avoid Chora warnings if the parameters are not used.
    aHandle;
    aTime;

    /*

      The aim of this method is to drive animations and other background activities
      in the external application.

    */

    var bool repeat;


    $if !$prototyper
      native ( aHandle, aTime, repeat )
      {
        /*
          Assuming, you want the Applet view to integrate a GAME application and
          the code needed to drive the animations is implemented in a 'C' function,
          then invoke the function now. Use the parameter aTime, it stores the up-
          time of the entire GUI application in milliseconds:
        */
          
         GameAnimate((XGame*)aHandle, aTime );

        /*
          HINT:

          If the external application performs background activities, which require
          continuous execution, set the variable 'repeat' to 'true'. In such case,
          the method OnProgress() will be invoked again as soon as possible.

            repeat = Game_Has_More_To_Do();

        */
      }
    $endif

    $if $prototyper
      /*
        If you have created an Intrinsics module containing the implementation of the
        external application, invoke the Intrinsics now to drive its animations. 
        Assuming, the declaration of the Intrinsics corresponds to the above used 'C'
        functions, just invoke the Intrinsics.

        Doing this, you are able to test the external application already at the design
        time within the Embedded Wizard Studio. More details concerning Intrinsics:

          https://doc.embedded-wizard.de/implement-intrinsics
      */

       GameAnimate( aHandle, aTime );
    $endif

    return repeat;
  }

  // The method OnDestroy() contains all the necessary steps for the deinitialization \
  // of the external 'C' application. Here the external application should be deactivated \
  // and the used memory should be freed.
  // This method is a part of the interface derived from the base class Views::Applet.
  $rect <20,90,220,130>
  inherited method OnDestroy()
  {
    // Dummy expresion to avoid Chora warnings if the parameters are not used.
    aHandle;

    /*

      The aim of this method is the de-initialization of the external application.
      The parameter aHandle identifies the application instance. This is the value
      returned by OnCreate() at the initialization time of the Applet view.

    */

    $if !$prototyper
      native ( aHandle )
      {
        /*
          Assuming, you want the Applet view to integrate a GAME application and
          the code needed to de-initialize the application is implemented in a 'C'
          function, then invoke the function now. Use the parameter aHandle to
          identify the external application instance:
        */

        GameDone((XGame*)aHandle );
      }
    $endif

    $if $prototyper
      /*
        If you have created an Intrinsics module containing the implementation of the
        external application, invoke the respective Intrinsic now to de-initialize the
        application. Assuming, the declaration of the Intrinsic corresponds to the 
        above used 'C' function, just invoke the Intrinsic.

        Doing this, you are able to test the external application already at the design
        time within the Embedded Wizard Studio. More details concerning Intrinsics:

          https://doc.embedded-wizard.de/implement-intrinsics
      */

      GameDone( aHandle );
    $endif
  }

  $rect <250,100,450,140>
  inherited method OnResize()
  {
    // Dummy expresion to avoid Chora warnings if the parameters are not used.
    aSize;

    /*

      The aim of this method is the size adaptation of the external application
      so that it fits within the area of the Applet view after the view has been
      resized.


      HINT 1:

      If the size of external application does not change at the runtime, ignore
      this method.

    */

    $if !$prototyper
      native ( aHandle, aSize )
      {
        /*

          TO DO:
          
          Assuming, you want the Applet view to integrate a GAME application and
          the code needed to adapt the size of the application is implemented in
          a 'C' function, then invoke the function now:
          
            Game_Set_Size( aSize.X, aSize.Y );


          HINT 2:
          
          If necessary use aHandle to identify the external application instance.
          aHandle contains the value obtained at the initialization time of the
          external application within the method OnCreate():

            Game_Set_Size( aHandle, aSize.X, aSize.Y );


          HINT 3:

          Depending on the external application, the size adjustment may force the
          application to be re-initialized. This could replace the actual instance
          of the application by a new one. In such case, update the aHandle value
          so that it refers the new instance. In the worst case, de-initialize the
          existing instance and create new one:

            Game_Done( aHandle );

            aHandle = (XHandle) Game_Init_With_Size( aSize.X, aSize.Y );

        */
      }
    $endif

    $if $prototyper
      /*
      
      TO DO:

        If you have created an Intrinsics module containing the implementation of the
        external application, invoke the Intrinsics now to adapt the size. Assuming,
        the declaration of the Intrinsics corresponds to the above used 'C' functions,
        just invoke the Intrinsics. For example:

          Game_Set_Size( aHandle, aSize.X, aSize.Y );

        Doing this, you are able to test the external application already at the design
        time within the Embedded Wizard Studio. More details concerning Intrinsics:

          https://doc.embedded-wizard.de/implement-intrinsics

      */
    $endif

    return aHandle;
  }

  $rect <250,140,450,180>
  inherited method OnMove()
  {
    // Dummy expresion to avoid Chora warnings if the parameters are not used.
    aPosition;

    /*

      The aim of this method is the position adaptation of an graphics hardware
      layer used to display the content of the external application so that it
      corresponds to the origin of the Applet view after the view has been moved.


      HINT 1:

      If the external application does not use any dedicated graphics hardware
      layers or the position does not change at the runtime, ignore this method.

    */

    $if !$prototyper
      native ( aHandle, aPosition )
      {
        /*

          TO DO:
          
          Assuming, you want the Applet view to integrate a GAME application and
          the code needed to adapt the position of the application is implemented in
          a 'C' function, then invoke the function now:
          
            Game_Set_Position( aPosition.X, aPosition.Y );


          HINT 2:
          
          If necessary use aHandle to identify the external application instance.
          aHandle contains the value obtained at the initialization time of the
          external application within the method OnCreate():

            Game_Set_Position( aHandle, aPosition.X, aPosition.Y );


          HINT 3:

          Depending on the external application, the position adjustment may force the
          application to be re-initialized. This could replace the actual instance
          of the application by a new one. In such case, update the aHandle value
          so that it refers the new instance. In the worst case, de-initialize the
          existing instance and create new one:

            Game_Done( aHandle );

            aHandle = (XHandle) Game_Init_With_Position( aPosition.X, aPosition.Y );

        */
      }
    $endif

    $if $prototyper
      /*
      
      TO DO:

        If you have created an Intrinsics module containing the implementation of the
        external application, invoke the Intrinsics now to adapt the position. Assuming,
        the declaration of the Intrinsics corresponds to the above used 'C' functions,
        just invoke the Intrinsics. For example:

            Game_Set_Position( aHandle, aPosition.X, aPosition.Y );

        Doing this, you are able to test the external application already at the design
        time within the Embedded Wizard Studio. More details concerning Intrinsics:

          https://doc.embedded-wizard.de/implement-intrinsics

      */
    $endif

    return aHandle;
  }

  // The method OnCreate() contains all the necessary steps for the initialization \
  // of an external 'C' application. Here the external application should be started.
  // This method is a part of the interface derived from the base class Views::Applet.
  $rect <20,50,220,90>
  inherited method OnCreate()
  {
    // Dummy expresion to avoid Chora warnings if the parameters are not used.
    aPosition;
    aSize;

    /*

      The aim of this method is the initialization of the external application. 
      The method should return a 'handle' identifying the application instance.
      In this way, multiple instances can co-exist simultanously.

    */

    var handle result;

    $if !$prototyper
      native ( result, aPosition, aSize )
      {
        /*
          Assuming, you want the Applet view to integrate a GAME application and
          the code needed to initialize the application is implemented in a 'C'
          function, then invoke the function now. Ensure, the variable 'result' 
          is initialized with a value identifying the just created application
          instance. This could be a value returned by the 'C' function:
        */
          
        result = (XHandle)GameInit( aSize );
      }
    $endif

    $if $prototyper
      /*
        If you have created an Intrinsics module containing the implementation of the
        external application, invoke the Intrinsics now to initialize the application,
        adjust its size, etc. Assuming, the declaration of the Intrinsics corresponds
        to the above used 'C' functions, just invoke the Intrinsics.

        Doing this, you are able to test the external application already at the design
        time within the Embedded Wizard Studio. More details concerning Intrinsics:

          https://doc.embedded-wizard.de/implement-intrinsics
      */

        result = GameInit( aSize );
    $endif

    return result;
  }

  // The method OnAdjustSize() is invoked whenever the size of the Game view is about \
  // to be changed. Within the method, the new size of the view can be adapted to \
  // the size supported by the external application.
  // This method is a part of the interface derived from the base class Views::Applet.
  $rect <250,50,450,90>
  inherited method OnAdjustSize()
  {
    // Avoid Chora warnings because of unused parameters
    aHandle;

    /*

      The aim of this method is the size adjustment of the Applet view so that
      it does fulfill the size constraints dictated by the external application.
      This could be, for example, a predetermined aspect-ratio between the width
      and the height of the Applet view.
      
    */

    // In our example we only ensure, that the screen size of the external application
    // is always a multiple of 30 pixel. This is for the demonstration purpose only.
    return aSize - point( aSize.x % 30, aSize.y % 30 );
  }

  // Drive the Application
  note group Note6
  {
    attr Bounds = <470,210,690,310>;
  }

  // Touch Event Handling
  note group Note5
  {
    attr Bounds = <240,210,460,400>;
  }

  // Key Event Handling
  note group Note4
  {
    attr Bounds = <10,210,230,310>;
  }

  // Screen Update
  note group Note3
  {
    attr Bounds = <470,10,690,150>;
  }

  // Arrangement
  note group Note2
  {
    attr Bounds = <240,10,460,200>;
  }

  // Initialization
  note group Note1
  {
    attr Bounds = <10,10,230,150>;
  }

  // The Application::Game class integrates an external 'C' application into the \
  // Embedded Wizard infrastructure. The class has been derived from the class Views::Applet, \
  // which already provides an interface for the integration of external applications.
  // 
  // In this example, the external 'C' application is a very simple game written \
  // in 'C'. It displays two points. The position of the first point can be changed \
  // by the UP, DOWN, LEFT, RIGHT keys. The second point will then follow the first \
  // one.
  // 
  // The points and the background are drawn in 'C' code. For this purpose the class \
  // implements a set of methods for the initialization, screen update, event dispatching \
  // and timer expirations. In the class Game these methods are adapted to the external \
  // application.
  // 
  // Just press Ctrl+F5 to start the prototyper.
  note legend Note
  {
    attr Bounds = <10,410,690,660>;
  }
}

// The class Application stands for the entire Embedded Wizard application, which \
// does embed the Game object of the Applet::Game class.
$rect <40,40,230,80>
class Application : Core::Root
{
  $rect <500,20,700,60>
  inherited property Bounds = <0,0,480,272>;

  // This project contains an Application::Game class to integrate an external 'C' \
  // application into the Embedded Wizard infrastructure. For demonstration purpose, \
  // the external application implements a simple game. It shows two points. By using \
  // the cursor the user can navigate the red point. The green point follows it automatically.
  // 
  // The above Canvas area contains an instance of Application::Game class. Through \
  // this instance the external application is integrated within Embedded Wizard. \
  // You can even play with the external application.
  // 
  // Just press the key Ctrl+F5.
  note legend Note
  {
    attr Bounds = <10,300,700,480>;
  }

  $rect <20,20,160,60>
  object Views::Rectangle Rectangle
  {
    preset Bounds = <0,0,480,272>;
    preset ColorBL = #C8C8C8FF;
    preset ColorBR = #C8C8C8FF;
  }

  $rect <20,20,160,60>
  object Views::Border Border
  {
    preset Bounds = <15,10,465,220>;
    preset Color = #C1C1C1FF;
  }

  // This is Game object. It covers the external 'C' application and synchronizes \
  // the drawings of the external application with the Embedded Wizard.
  $rect <20,20,160,60>
  object Application::Game Game
  {
    preset Bounds = <15,10,465,220>;
  }

  $rect <20,20,160,60>
  object Views::Text Text2
  {
    preset Bounds = <0,227,480,267>;
    preset String = "To move the red point use the keys\nUP, DOWN, LEFT and RIGHT.";
    preset Font = Resources::FontSmall;
    preset Color = #000000FF;
  }

  $rect <20,20,160,60>
  object Views::Text Text1
  {
    preset Bounds = <60,16,420,56>;
    preset String = "Just some text on top of the applet...";
    preset Font = Resources::FontMedium;
    preset Color = #B2B2B2FF;
  }
}

// The Application::Game class integrates an external 'C' application into the Embedded \
// Wizard infrastructure. The class has been derived from the class Views::Applet, \
// which already provides an interface for the integration of external applications.
// 
// In this example, the external 'C' application is a very simple game written in \
// 'C'. It displays two points. The position of the first point can be changed by \
// the UP, DOWN, LEFT, RIGHT keys. The second point will then follow the first one.
// 
// The points and the background are drawn in 'C' code. For this purpose the class \
// implements a set of methods for the initialization, screen update, event dispatching \
// and timer expirations. In the class Game these methods are adapted to the external \
// application.
// 
// The brick 'Inline' contains additional #include directive to ensure that references \
// to needed C header files are generated.
// 
// Just press Ctrl+F5 to start the prototyper.
note legend Note
{
  attr Bounds = <20,230,660,530>;
}

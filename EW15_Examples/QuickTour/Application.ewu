$version 15.00

// GUI Components
note group Note1
{
  attr Bounds = <10,10,450,140>;
}

// Assets
note group Note2
{
  attr Bounds = <460,10,690,460>;
}

// Configuration objects
note group Note3
{
  attr Bounds = <10,150,320,330>;
}

// The interface to integrate the GUI with the target device
note group Note4
{
  attr Bounds = <10,470,690,600>;
}

// This is an instance of the interface to the underlying device. Through this instance \
// the GUI can communicate with the device.
$rect <430,510,680,550>
autoobject Application::DeviceClass Device;

// This class implements a variant of the interface used during the prototyping only \
// to simulate the device behavior.
$rect <60,550,370,590>
$variant $prototyper
vclass DeviceClassVariantForPrototypingOnly : Application::DeviceClass
{
  $rect <290,90,490,130>
  inherited method GetBrewingProgress()
  {
    // Just get the integer value representing the brewing progress.
    return brewingProgress;
  }

  $rect <20,90,220,130>
  inherited method StartBrewing()
  {
    // For prototyping purpose we activate a timer which simulates the brewing progress.
    // The timer resolution depends on the selected coffee strength.
    Timer.Period  = ( aCoffeeStrength * 50 + 2500 ) / 100;
    Timer.Enabled = true;

    // The Brewing starts now. notify the GUI about this event.
    TriggerBrewingStarted();
  }

  $rect <260,300,490,340>
  var int32 brewingProgress = 0;

  // This slot method is triggered from the Timer object.
  $rect <260,260,490,300>
  slot onTimer
  {
    // Simulate the progress of the brewing process.
    brewingProgress = brewingProgress + 1;

    // Notify the GUI about the updated progress of the brewing process.
    TriggerBrewingInProgress();

    // The brewing process ends. Stop the timer and notify the GUI about the
    // end of the process.
    if ( brewingProgress == 100 )
    {
      Timer.Enabled   = false;
      brewingProgress = 0;
      TriggerBrewingFinished();
    }
  }

  // The timer is used to simulate the brewing process. Every time the timer expires, \
  // the progress of the brewing process is updated.
  $rect <20,260,250,300>
  object Core::Timer Timer
  {
    preset OnTrigger = onTimer;
    preset Period = 50;
    preset Begin = 250;
  }

  // Timer used to simulate the progress of the brewing process.
  note group Note1
  {
    attr Bounds = <10,190,500,350>;
  }

  // Implementation of the interface to use a timer as replacement for the real brewing \
  // process.
  note group Note2
  {
    attr Bounds = <10,10,500,180>;
  }
}

// This class implements an interface to the underlying device.
$rect <20,510,330,550>
$output false
class DeviceClass : Templates::DeviceClass
{
  // Interface to control the brewing process.
  // These methods are intended to control the device.
  note group Note1
  {
    attr Bounds = <10,10,500,180>;
  }

  // Interface to receive notifications from the device.
  // These methods are intended to be called from the device.
  note group Note2
  {
    attr Bounds = <10,190,500,390>;
  }

  $rect <260,340,490,380>
  object Core::SystemEvent BrewingInProgressEvent;

  $rect <260,300,490,340>
  object Core::SystemEvent BrewingFinishedEvent;

  $rect <260,260,490,300>
  object Core::SystemEvent BrewingStartedEvent;

  // This method is intended to be called by the device to notify the GUI application \
  // about the progress of the brewing process.
  $rect <20,340,250,380>
  $output true
  method void TriggerBrewingInProgress()
  {
    // Just trigger the system event. All associated system event handler will then be notified automatically.
    BrewingInProgressEvent.Trigger( null, false );
  }

  // This method is intended to be called by the device to notify the GUI application \
  // about the end of the brewing process.
  $rect <20,300,250,340>
  $output true
  method void TriggerBrewingFinished()
  {
    // Just trigger the system event. All associated system event handler will then be notified automatically.
    BrewingFinishedEvent.Trigger( null, false );
  }

  // This method is intended to be called by the device to notify the GUI application \
  // about the start of the brewing process.
  $rect <20,260,250,300>
  $output true
  method void TriggerBrewingStarted()
  {
    // Just trigger the system event. All associated system event handler will then be notified automatically.
    BrewingStartedEvent.Trigger( null, false );
  }

  // This method implements a device command to query the progress of the brewing \
  // process.
  $rect <290,90,490,130>
  $output true
  method int32 GetBrewingProgress()
  {
    var int32 progress = 0;

    native ( progress )
    {
      /* Implement here your C code to query how the brewing process
         progresses in your device. If necessary predeclare the C 
         functions intended to be used here. For example: */
      extern int YourDevice_QueryBrewingProgress( void );

      progress = YourDevice_QueryBrewingProgress();
    }

    return progress;
  }

  // This method implements a device command to start the brewing process.
  $rect <20,90,220,130>
  method void StartBrewing( arg int32 aCoffeeStrength )
  {
    native ( aCoffeeStrength )
    {
      /* Implement here your C code to start the brewing process in
         the device. If necessary predeclare the C functions intended
         to be used here. For example: */
      extern void YourDevice_StartBrewing( int aStrength );

      YourDevice_StartBrewing( aCoffeeStrength );
    }
  }
}


// This class implements a GUI component.
$rect <240,90,440,130>
$output false
class BrewingDialog : Core::Group
{
  $rect <500,10,700,50>
  inherited property Bounds = <0,0,480,272>;

  // Handler for events received from the device 
  note group Note1
  {
    attr Bounds = <10,300,490,400>;
  }

  // Object containing vector graphic (path) data
  note group Note2
  {
    attr Bounds = <10,420,490,520>;
  }

  // This slot method is executed when the associated property observer 'BrewingProgressObserver' \
  // is notified.
  $rect <250,350,480,390>
  slot onBrewingProgress
  {
    // From the device interface query the actual brewing progress. It is expressed
    // as integer value in range 0 .. 100.
    var int32 progress = Application::Device.GetBrewingProgress();

    // From the progress value format a text and update the angle of an arc path.
    ProgressText.String = string( progress ) + " %%";
    ArcPath.EndAngle    = 3.6 * float( progress ) - 90.0;
  }

  $rect <20,470,250,510>
  object Graphics::ArcPath ArcPath
  {
    preset EndAngle = -90;
    preset StartAngle = -90.0;
    preset Radius = 67.0;
    preset Style = Graphics::ArcStyle.Arc;
  }

  $rect <20,20,160,60>
  object Views::Rectangle Background
  {
    preset Bounds = <0,0,480,272>;
    preset Color = #00000099;
  }

  $rect <20,20,160,60>
  object Views::Image CupImage
  {
    preset Bounds = <131,36,385,236>;
    preset Bitmap = Application::Cup;
  }

  $rect <20,20,160,60>
  object Views::StrokePath StrokePath
  {
    preset Bounds = <131,36,331,236>;
    preset Offset = <100,100>;
    preset EndCap = Graphics::PathCap.Round;
    preset StartCap = Graphics::PathCap.Round;
    preset Width = 14.0;
    preset Path = ArcPath;
  }

  $rect <20,20,160,60>
  object Views::Text ProgressText
  {
    preset Bounds = <155,99,309,171>;
    preset Alignment = Views::TextAlignment[AlignHorzCenter, AlignVertCenter];
    preset String = "0 %%";
    preset Font = Application::BigFont;
    preset Color = #FFFFFF7D;
  }

  $rect <20,350,250,390>
  object Core::SystemEventHandler SystemEventHandler
  {
    preset OnEvent = onBrewingProgress;
    preset Event = Application::Device.BrewingInProgressEvent;
  }
}


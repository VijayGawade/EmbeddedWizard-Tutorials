// This class implements a GUI component.
$rect <240,50,440,90>
$output false
class SelectionDialog : Core::Group
{
  $rect <500,10,700,50>
  inherited property Bounds = <0,0,480,272>;

  // Handler for the above 'play' push button
  note group Note1
  {
    attr Bounds = <10,300,380,400>;
  }

  $rect <20,350,240,390>
  slot onPushButton
  {
    if ( IsCurrentDialog())
      Application::Device.StartBrewing( HorizontalSlider.CurrentValue );
  }

  $rect <20,20,160,60>
  object Views::Image BackgroundImage
  {
    preset Bounds = <0,0,480,272>;
    preset Bitmap = Application::BackgroundCup;
  }

  $rect <20,20,160,60>
  object Views::Text Caption
  {
    preset Bounds = <0,0,120,50>;
    preset String = "Text";
    preset Font = Application::SmallFont;
  }

  $rect <20,20,160,60>
  object Views::Text Weak
  {
    preset Bounds = <0,120,90,147>;
    preset Alignment = Views::TextAlignment[AlignHorzCenter, AlignVertCenter];
    preset String = "WEAK";
    preset Font = Application::SmallFont;
  }

  $rect <20,20,160,60>
  object Views::Text Strong
  {
    preset Bounds = <390,120,479,147>;
    preset Alignment = Views::TextAlignment[AlignHorzCenter, AlignVertCenter];
    preset String = "STRONG";
    preset Font = Application::SmallFont;
  }

  $rect <20,20,160,60>
  object Views::Line Line
  {
    preset Point2 = <340,73>;
    preset Point1 = <140,73>;
    preset Width = 2;
  }

  $rect <20,20,160,60>
  object WidgetSet::PushButton PushButton
  {
    preset Bounds = <205,186,275,256>;
    preset OnActivate = onPushButton;
    preset Icon = Application::PlayIcon;
    preset Label = "Caption";
    preset Appearance = Application::PushButtonConfig;
  }

  $rect <20,20,160,60>
  object WidgetSet::HorizontalSlider HorizontalSlider
  {
    preset Bounds = <95,105,385,165>;
    preset Appearance = Application::HorizontalSliderConfig;
  }
}

// This class implements the root component of the entire GUI application.
$rect <20,50,220,90>
$output false
class Application : Core::Root
{
  $rect <500,10,700,50>
  inherited property Bounds = <0,0,480,272>;

  $rect <20,350,250,390>
  inherited method Init()
  {
    // Just in the moment when the application is initialized present the 'selection screen'
    PresentDialog( SelectionDialog, null, null, null, null, null, null, null, null, false );
  }

  // Initialization of the component
  note group Note1
  {
    attr Bounds = <10,300,290,400>;
  }

  // Handler for events received from the device 
  note group Note2
  {
    attr Bounds = <10,420,490,550>;
  }

  // This slot method is executed when the associated event handler 'BrewingFinishedEvent' \
  // is triggered.
  $rect <250,500,480,540>
  slot onBrewingFinished
  {
    // Just in the moment when the divice reports the end of the brewing process, dismiss the 'brewing screen'
    DismissDialog( BrewingDialog, null, null, null, null, null, false );
  }

  // This slot method is executed when the associated event handler 'BrewingStartedEvent' \
  // is triggered.
  $rect <20,500,250,540>
  slot onBrewingStarted
  {
    // Just in the moment when the divice reports the start of the brewing process, present the 'brewing screen'
    PresentDialog( BrewingDialog, Application::FadeInOutCentered, Application::FadeInOutCentered, null, null, null, null, null, null, false );
  }

  $rect <250,460,480,500>
  object Core::SystemEventHandler BrewingFinishedEvent
  {
    preset OnEvent = onBrewingFinished;
    preset Event = Application::Device.BrewingFinishedEvent;
  }

  $rect <20,460,250,500>
  object Core::SystemEventHandler BrewingStartedEvent
  {
    preset OnEvent = onBrewingStarted;
    preset Event = Application::Device.BrewingStartedEvent;
  }

  $rect <20,20,160,60>
  object Views::Rectangle Background
  {
    preset Bounds = <0,0,480,280>;
    preset Color = #000000FF;
  }

  $rect <20,20,160,60>
  object Application::BrewingDialog BrewingDialog
  {
    preset Bounds = <0,0,480,272>;
    preset Visible = false;
  }

  $rect <20,20,160,60>
  object Application::SelectionDialog SelectionDialog
  {
    preset Bounds = <0,0,480,272>;
    preset Visible = false;
  }
}
